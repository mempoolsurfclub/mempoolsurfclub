{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-home-radar-sweep.css' | asset_url | stylesheet_tag }}

{%- assign search_input_id = 'MscHomeSearchInput-' | append: section.id -%}
{%- assign heading_line_1 = section.settings.heading_line_1 | default: blank -%}
{%- assign heading_line_2 = section.settings.heading_line_2 | default: blank -%}
{%- assign radar_explore_url = section.settings.radar_explore_url | default: '/pages/explore-the-bitcoin-ecosystem' -%}
{%- assign radar_learn_url = section.settings.radar_learn_url | default: '/pages/learn-bitcoin' -%}
{%- assign radar_tools_url = section.settings.radar_tools_url | default: '/pages/bitcoin-tools' -%}
{%- assign radar_shop_url = section.settings.radar_shop_url | default: routes.all_products_collection_url -%}

<section class="msc-shell msc-home-hero" id="MscHomeHero-{{ section.id }}">
  <div class="msc-container">
    <div class="msc-home-hero__grid">
      <div class="msc-home-hero__content">
        <div class="msc-eyebrow msc-rotating-signal" aria-label="{{ section.settings.signal_phrase_1 | escape }}">
          <span class="msc-rotating-signal__indicator" aria-hidden="true"></span>
          <span class="msc-rotating-signal__phrases">
            <span>{{ section.settings.signal_phrase_1 | escape }}</span>
            <span>{{ section.settings.signal_phrase_2 | escape }}</span>
            <span>{{ section.settings.signal_phrase_3 | escape }}</span>
          </span>
        </div>

        {%- if heading_line_1 != blank or heading_line_2 != blank -%}
          <h1 class="msc-title msc-home-hero__title">
            {%- if heading_line_1 != blank -%}<span>{{ heading_line_1 | escape }}</span>{%- endif -%}
            {%- if heading_line_2 != blank -%}<span>{{ heading_line_2 | escape }}</span>{%- endif -%}
          </h1>
        {%- elsif section.settings.heading != blank -%}
          <h1 class="msc-title msc-home-hero__title">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="msc-subtitle msc-home-hero__subtitle rte">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {% render 'msc-search-form',
          input_id: search_input_id,
          placeholder: section.settings.search_placeholder,
          button_label: section.settings.search_button,
          search_types: section.settings.search_types,
          label: section.settings.search_label,
          modifier: 'home'
        %}

      </div>

      <div class="msc-signal-card msc-glass-card" data-msc-ecosystem-radar aria-label="Mempool Surf Club ecosystem radar with live Bitcoin block status and direct links to Explore, Learn, Tools, and Shop destinations.">
        <span class="visually-hidden" aria-live="polite" aria-atomic="true" data-radar-announcer></span>

        <div class="msc-live-block-strip" data-radar-strip>
          <svg class="msc-live-block-strip__wave" viewBox="0 0 420 120" aria-hidden="true" focusable="false" data-radar-wave>
            <path class="msc-live-block-strip__wave-body" d="M418 92C360 92 336 48 294 50c-42 2-49 38-91 38-43 0-55-30-98-29-35 1-54 22-103 22v39h416z" />
            <path class="msc-live-block-strip__wave-crest" d="M354 60c-20-24-49-32-78-17-18 9-27 25-45 32" />
            <path class="msc-live-block-strip__wave-line" d="M330 78c-33-9-55 4-81 14M248 58c-23 16-47 19-74 8M147 88c-26-12-49-10-76 4" />
            <path class="msc-live-block-strip__wave-spray" d="M288 30l12-10M313 36l14-4M266 38l-6-12" />
          </svg>
          <div class="msc-live-block-tile msc-live-block-tile--confirmed" data-confirmed-tile>
            <span class="msc-live-block-tile__title" data-confirmed-title>LATEST BLOCK</span>
            <span class="msc-live-block-tile__state" data-confirmed-state>CONNECTING</span>
            <span class="msc-live-block-tile__meta" data-confirmed-age></span>
            <span class="msc-live-block-tile__meta" data-confirmed-fee></span>
          </div>
          <span class="msc-live-block-strip__boundary" aria-hidden="true" data-radar-boundary></span>
          <div class="msc-live-block-tile msc-live-block-tile--projected" data-projected-tile>
            <span class="msc-live-block-tile__title" data-projected-title>NEXT BLOCK</span>
            <span class="msc-live-block-tile__state" data-projected-state>PROJECTED</span>
            <span class="msc-live-block-tile__meta" data-projected-tx></span>
            <span class="msc-live-block-tile__meta" data-projected-fee></span>
          </div>
          <div class="msc-live-block-tile msc-live-block-tile--transition" aria-hidden="true" data-transition-tile>
            <span class="msc-live-block-tile__title" data-transition-title>NEXT BLOCK</span>
            <span class="msc-live-block-tile__state" data-transition-state>PROJECTED</span>
            <span class="msc-live-block-tile__meta" data-transition-meta></span>
          </div>
        </div>

        <div class="msc-signal-field" data-radar-field>
          <div class="msc-signal-field__labels" aria-hidden="true">
            <span>MSC ECOSYSTEM RADAR</span>
            <span class="msc-signal-card__status" data-radar-status>UPDATING</span>
          </div>
          <span class="msc-signal-field__radar-disc" aria-hidden="true"></span>
          <span class="msc-signal-field__bitcoin" aria-hidden="true">₿</span>
          <a class="msc-signal-field__zone msc-signal-field__zone--explore" href="{{ radar_explore_url }}" data-radar-link>
            <span class="msc-signal-field__signal"><i aria-hidden="true"></i><strong>Explore</strong></span>
          </a>
          <a class="msc-signal-field__zone msc-signal-field__zone--learn" href="{{ radar_learn_url }}" data-radar-link>
            <span class="msc-signal-field__signal"><i aria-hidden="true"></i><strong>Learn</strong></span>
          </a>
          <a class="msc-signal-field__zone msc-signal-field__zone--tools" href="{{ radar_tools_url }}" data-radar-link>
            <span class="msc-signal-field__signal"><i aria-hidden="true"></i><strong>Tools</strong></span>
          </a>
          <a class="msc-signal-field__zone msc-signal-field__zone--shop" href="{{ radar_shop_url }}" data-radar-link>
            <span class="msc-signal-field__signal"><i aria-hidden="true"></i><strong>Shop</strong></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'msc-home-ecosystem-radar.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "MSC home hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "signal_phrase_1", "label": "Signal phrase 1", "default": "SCANNING THE BITCOIN ECOSYSTEM" },
    { "type": "text", "id": "signal_phrase_2", "label": "Signal phrase 2", "default": "READING NETWORK + CULTURE SIGNALS" },
    { "type": "text", "id": "signal_phrase_3", "label": "Signal phrase 3", "default": "WATCHING THE MEMPOOL" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "READ THE NETWORK." },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "RIDE THE WAVE." },
    { "type": "text", "id": "heading", "label": "Legacy heading fallback", "default": "READ THE NETWORK. RIDE THE WAVE." },
    { "type": "richtext", "id": "subheading", "label": "Supporting copy", "default": "<p>Mempool Surf Club is a place to explore Bitcoin culture, understand how the network works, read the conditions shaping it, and discover the people who carry the culture forward.</p>" },
    { "type": "text", "id": "search_label", "label": "Search accessible label", "default": "Search people, projects, ideas, tools, and topics" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search people, projects, ideas, tools, and topics..." },
    { "type": "text", "id": "search_button", "label": "Search button", "default": "Search" },
    { "type": "text", "id": "search_types", "label": "Shopify search types", "default": "article,page,product" },
    { "type": "url", "id": "radar_explore_url", "label": "Radar Explore URL" },
    { "type": "url", "id": "radar_learn_url", "label": "Radar Learn URL" },
    { "type": "url", "id": "radar_tools_url", "label": "Radar Tools URL" },
    { "type": "url", "id": "radar_shop_url", "label": "Radar Shop URL" }
  ],
  "presets": [{ "name": "MSC home hero" }]
}
{% endschema %}
