<style>
  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    > .msc-building-sidechain-companion {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    row-gap: .72rem;
    min-height: 0;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-sidechain-companion__title {
    margin-top: 0;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-system {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(5.8rem, 8vw, 7.2rem) minmax(0, 1fr);
    align-items: stretch;
    column-gap: clamp(1.15rem, 1.7vw, 1.8rem);
    min-height: 10.6rem;
    padding: .75rem .35rem .55rem;
    overflow: visible;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    min-height: 9.2rem;
    padding: .8rem .35rem 1.2rem;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger:first-child {
    grid-column: 1;
    text-align: left;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger:last-child {
    grid-column: 3;
    text-align: right;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger__label {
    position: relative;
    z-index: 3;
    display: block;
    margin-bottom: .72rem;
    color: rgba(212, 190, 153, .68);
    font-size: .72rem;
    font-weight: 820;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger strong {
    position: relative;
    z-index: 3;
    display: block;
    max-width: 12ch;
    margin: 0;
    color: rgba(212, 190, 153, .98);
    font-size: clamp(1.45rem, 1.72vw, 1.85rem);
    font-weight: 760;
    line-height: 1.05;
    letter-spacing: .02em;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger:last-child strong {
    margin-left: auto;
    animation: msc-guide-036-issued-glow-horizontal 7.2s ease-in-out infinite;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger::after {
    content: "";
    position: absolute;
    left: .35rem;
    right: .35rem;
    bottom: 1.05rem;
    height: .72rem;
    pointer-events: none;
    opacity: .9;
    background-image:
      radial-gradient(circle at 10% 50%, rgba(212, 190, 153, .58) 0 1.8px, transparent 2.45px),
      radial-gradient(circle at 50% 50%, rgba(212, 190, 153, .42) 0 1.7px, transparent 2.35px),
      radial-gradient(circle at 90% 50%, rgba(212, 190, 153, .58) 0 1.8px, transparent 2.45px),
      linear-gradient(90deg, rgba(212, 190, 153, .2), rgba(212, 190, 153, .52), rgba(212, 190, 153, .2));
    background-repeat: no-repeat;
    background-size: 100% 100%, 100% 100%, 100% 100%, 100% 2px;
    background-position: center;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger::before {
    content: "";
    position: absolute;
    bottom: 1.41rem;
    z-index: 5;
    width: .48rem;
    height: .48rem;
    border-radius: 50%;
    background: rgba(236, 218, 183, 1);
    box-shadow: 0 0 .85rem rgba(212, 190, 153, .38);
    opacity: 0;
    transform: translate(-50%, 50%);
    pointer-events: none;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger:first-child::before {
    left: 10%;
    animation: msc-guide-036-left-signal 7.2s ease-in-out infinite;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-ledger:last-child::before {
    left: 10%;
    animation: msc-guide-036-right-signal 7.2s ease-in-out infinite;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-bridge {
    position: relative;
    grid-column: 2;
    display: grid;
    place-items: center;
    align-self: stretch;
    min-height: 9.2rem;
    padding: .35rem 0;
    background: transparent;
    transform: none;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-bridge::before {
    content: "";
    position: absolute;
    top: .35rem;
    bottom: .35rem;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(212, 190, 153, .56) 18%, rgba(212, 190, 153, .56) 82%, transparent);
    transform: translateX(-50%);
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-bridge::after {
    content: "";
    position: absolute;
    top: 50%;
    left: -1.2rem;
    z-index: 6;
    width: .46rem;
    height: .46rem;
    border-radius: 50%;
    background: rgba(236, 218, 183, 1);
    box-shadow: 0 0 .9rem rgba(212, 190, 153, .44);
    opacity: 0;
    transform: translate(-50%, -50%);
    animation: msc-guide-036-boundary-cross 7.2s ease-in-out infinite;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-bridge__pulse {
    position: relative;
    z-index: 4;
    width: 1.55rem;
    height: 1.55rem;
    border: 1px solid rgba(212, 190, 153, .98);
    border-radius: 50%;
    background: rgba(16, 40, 45, .98);
    box-shadow: 0 0 0 5px rgba(212, 190, 153, .06);
    animation: msc-guide-036-peg-pulse-horizontal 7.2s ease-in-out infinite;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-bridge__pulse::after {
    content: "";
    position: absolute;
    inset: -.38rem;
    border: 1px solid rgba(212, 190, 153, .44);
    border-radius: inherit;
    opacity: .52;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-bridge strong {
    position: absolute;
    top: calc(50% + 1.65rem);
    left: 50%;
    z-index: 4;
    color: rgba(212, 190, 153, .9);
    font-size: .68rem;
    font-weight: 850;
    line-height: 1.2;
    letter-spacing: .17em;
    text-align: center;
    transform: translateX(-50%);
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
    .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
    .msc-building-peg-bridge strong::after {
    content: "BOUNDARY";
    display: block;
    margin-top: .22rem;
    color: rgba(212, 190, 153, .46);
    font-size: .52rem;
    letter-spacing: .14em;
  }

  @keyframes msc-guide-036-left-signal {
    0%, 7% { left: 10%; opacity: 0; }
    12% { opacity: 1; }
    33% { left: 96%; opacity: 1; }
    39%, 100% { left: 96%; opacity: 0; }
  }

  @keyframes msc-guide-036-peg-pulse-horizontal {
    0%, 30%, 45%, 100% { box-shadow: 0 0 0 5px rgba(212, 190, 153, .06); }
    36% { box-shadow: 0 0 0 11px rgba(212, 190, 153, .13), 0 0 1.2rem rgba(212, 190, 153, .22); }
  }

  @keyframes msc-guide-036-boundary-cross {
    0%, 38% { left: -1.2rem; opacity: 0; }
    42% { opacity: 1; }
    53% { left: calc(100% + 1.2rem); opacity: 1; }
    58%, 100% { left: calc(100% + 1.2rem); opacity: 0; }
  }

  @keyframes msc-guide-036-right-signal {
    0%, 55% { left: 4%; opacity: 0; }
    60% { opacity: 1; }
    78% { left: 90%; opacity: 1; }
    84%, 100% { left: 90%; opacity: 0; }
  }

  @keyframes msc-guide-036-issued-glow-horizontal {
    0%, 60%, 84%, 100% { color: rgba(212, 190, 153, .98); text-shadow: none; }
    72% { color: rgba(236, 218, 183, 1); text-shadow: 0 0 .8rem rgba(212, 190, 153, .2); }
  }

  @media screen and (min-width: 750px) {
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      > .msc-building-sidechain-companion {
      grid-row: 1 / 4;
    }
  }

  @media screen and (max-width: 749px) {
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-system {
      grid-template-columns: 1fr;
      grid-template-rows: auto 4rem auto;
      row-gap: .65rem;
      min-height: 0;
      padding-top: .7rem;
    }

    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-ledger:first-child,
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-ledger:last-child,
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-bridge {
      grid-column: 1;
    }

    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-ledger {
      min-height: 6.2rem;
      padding-top: .4rem;
    }

    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-bridge {
      min-height: 4rem;
    }

    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-bridge::before {
      top: 50%;
      bottom: auto;
      left: 10%;
      right: 10%;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(212, 190, 153, .5) 18%, rgba(212, 190, 153, .5) 82%, transparent);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-ledger::before,
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-bridge::after,
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-bridge__pulse,
    .msc-learn-page[data-msc-registry-id="MSC-HUB-BUILDING"]
      .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]
      .msc-building-peg-ledger:last-child strong {
      animation: none;
    }
  }
</style>
<script src="{{ 'msc-learn-hub-progress.js' | asset_url }}" defer="defer"></script>

{% render 'msc-learn-building-hub-runtime' %}

<template data-msc-learn-progress-template="MSC-HUB-BUILDING">
  <aside
    class="msc-learn-progress"
    data-msc-learn-progress
    data-hub-id="MSC-HUB-BUILDING"
    data-total-guides="16"
    data-account-state="{% if customer %}authenticated{% else %}guest{% endif %}"
    aria-label="Building on Bitcoin learning progress"
  >
    <div class="msc-learn-progress__topline">
      <p class="msc-learn-progress__eyebrow">Learning position</p>
      <p class="msc-learn-progress__position" data-msc-progress-position>Position 001</p>
    </div>

    <div class="msc-learn-progress__readout" aria-hidden="true">
      <strong data-msc-progress-count>00</strong>
      <span>/ 16</span>
    </div>

    <p class="msc-learn-progress__summary">
      <span data-msc-progress-completed>0 complete</span>
      <span class="msc-learn-progress__summary-separator">·</span>
      <span data-msc-progress-remaining>16 remaining</span>
    </p>

    <div class="msc-learn-progress__current">
      <p class="msc-learn-progress__current-label" data-msc-progress-current-label>Start here</p>
      <p class="msc-learn-progress__current-title">
        <span class="msc-learn-progress__current-number" data-msc-progress-current-number>001</span>
        <span aria-hidden="true">—</span>
        <span data-msc-progress-current-title>How the Lightning Network Works</span>
      </p>
    </div>

    <div
      class="msc-learn-progress__track"
      role="progressbar"
      aria-label="Building on Bitcoin guide completion"
      aria-valuemin="0"
      aria-valuemax="16"
      aria-valuenow="0"
      aria-valuetext="0 of 16 guides complete"
    >
      <div class="msc-learn-progress__groups">
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Layer 2</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node is-current" data-msc-progress-guide="MSC-GUIDE-033"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-034"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-035"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-036"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Digital Assets</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-037"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-038"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-039"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-040"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Development</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-041"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-042"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-043"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-044"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Innovation</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-045"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-046"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-047"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-048"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="msc-learn-progress__footer" aria-hidden="true">
      <span>4 sections</span>
      <span>16 guides</span>
      <span data-msc-progress-percent>0% complete</span>
    </div>
  </aside>
</template>

<template data-msc-building-lightning-companion>
  <aside class="msc-building-lightning-companion" aria-label="Lightning channel and settlement system">
    <svg class="msc-building-lightning-system" viewBox="0 0 560 280" role="img" aria-labelledby="msc-building-lightning-title msc-building-lightning-desc">
      <title id="msc-building-lightning-title">Lightning channel and settlement system</title>
      <desc id="msc-building-lightning-desc">Two channel peers update off-chain commitment states, can route through another peer, and retain a Bitcoin settlement path through the funding output.</desc>

      <g class="msc-building-lightning-system__muted" aria-hidden="true">
        <path d="M34 36H526M34 244H526M58 22V258M502 22V258" />
        <circle cx="280" cy="140" r="108" />
      </g>

      <g aria-hidden="true">
        <circle cx="110" cy="116" r="29" />
        <path d="M96 116H124M110 102V130" />
        <text x="110" y="163" text-anchor="middle">PEER A</text>
      </g>

      <g aria-hidden="true">
        <circle cx="450" cy="116" r="29" />
        <path d="M436 116H464M450 102V130" />
        <text x="450" y="163" text-anchor="middle">PEER B</text>
      </g>

      <g class="msc-building-lightning-system__strong" aria-hidden="true">
        <path d="M139 116H421" />
        <rect x="225" y="91" width="110" height="50" rx="8" />
        <path d="M240 107H320M240 120H305" />
        <text x="280" y="78" text-anchor="middle">OFF-CHAIN STATES</text>
      </g>

      <g aria-hidden="true">
        <circle cx="280" cy="201" r="21" />
        <path d="M268 201H292M280 189V213" />
        <text x="280" y="236" text-anchor="middle">ROUTING PEER</text>
        <path d="M132 137L260 190M300 190L428 137" />
      </g>

      <g aria-hidden="true">
        <rect x="205" y="20" width="150" height="34" rx="6" />
        <path d="M221 37H339" />
        <text x="280" y="17" text-anchor="middle">BITCOIN FUNDING OUTPUT</text>
        <path d="M246 54L176 91M314 54L384 91" />
      </g>

      <g aria-hidden="true">
        <rect x="220" y="247" width="120" height="24" rx="5" />
        <text x="280" y="264" text-anchor="middle">BITCOIN SETTLEMENT</text>
        <path class="msc-building-lightning-system__strong" d="M280 222V247" />
        <polyline points="274,237 280,247 286,237" />
      </g>
    </svg>
  </aside>
</template>

<template data-msc-building-sidechain-companion>
  <aside class="msc-building-sidechain-companion" aria-label="Bitcoin and sidechain peg boundary">
    <p class="msc-building-sidechain-companion__eyebrow">Two-ledger model</p>
    <h4 class="msc-building-sidechain-companion__title">Chain Security ≠ Peg Security</h4>

    <div class="msc-building-peg-system">
      <div class="msc-building-peg-ledger">
        <span class="msc-building-peg-ledger__label">Bitcoin ledger</span>
        <strong>BTC locked</strong>
      </div>

      <div class="msc-building-peg-bridge" aria-hidden="true">
        <span class="msc-building-peg-bridge__pulse"></span>
        <strong>PEG</strong>
      </div>

      <div class="msc-building-peg-ledger">
        <span class="msc-building-peg-ledger__label">Sidechain ledger</span>
        <strong>Representation issued</strong>
      </div>
    </div>
  </aside>
</template>

<script>
  (() => {
    const script = document.currentScript;
    const scope = script.closest('.shopify-section') || document;
    const card = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-033"]');
    const template = scope.querySelector('template[data-msc-building-lightning-companion]');

    if (card && template && !card.querySelector('.msc-building-lightning-companion')) {
      card.appendChild(template.content.cloneNode(true));
    }
  })();
</script>

<script>
  (() => {
    const script = document.currentScript;
    const scope = script.closest('.shopify-section') || document;
    const card = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-036"]');
