{{ 'msc-learn-ecosystem-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'msc-learn-hub-progress.js' | asset_url }}" defer="defer"></script>

{% render 'msc-learn-ecosystem-hub-runtime' %}

<template data-msc-learn-progress-template="MSC-HUB-ECOSYSTEM">
  <aside class="msc-learn-progress" data-msc-learn-progress data-hub-id="MSC-HUB-ECOSYSTEM" data-total-guides="16" data-account-state="{% if customer %}authenticated{% else %}guest{% endif %}" aria-label="Bitcoin Ecosystem learning progress">
    <div class="msc-learn-progress__topline"><p class="msc-learn-progress__eyebrow">Learning position</p><p class="msc-learn-progress__position" data-msc-progress-position>Position 001</p></div>
    <div class="msc-learn-progress__readout" aria-hidden="true"><strong data-msc-progress-count>00</strong><span>/ 16</span></div>
    <p class="msc-learn-progress__summary"><span data-msc-progress-completed>0 complete</span><span class="msc-learn-progress__summary-separator">·</span><span data-msc-progress-remaining>16 remaining</span></p>
    <div class="msc-learn-progress__current"><p class="msc-learn-progress__current-label" data-msc-progress-current-label>Start here</p><p class="msc-learn-progress__current-title"><span class="msc-learn-progress__current-number" data-msc-progress-current-number>001</span><span aria-hidden="true">—</span><span data-msc-progress-current-title>Who Builds on Bitcoin?</span></p></div>
    <div class="msc-learn-progress__track" role="progressbar" aria-label="Bitcoin Ecosystem guide completion" aria-valuemin="0" aria-valuemax="16" aria-valuenow="0" aria-valuetext="0 of 16 guides complete"><div class="msc-learn-progress__groups">
      <div class="msc-learn-progress__group"><span class="msc-learn-progress__group-label">People</span><div class="msc-learn-progress__nodes" aria-hidden="true"><span class="msc-learn-progress__node is-current" data-msc-progress-guide="MSC-GUIDE-065"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-066"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-067"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-068"></span></div></div>
      <div class="msc-learn-progress__group"><span class="msc-learn-progress__group-label">Companies</span><div class="msc-learn-progress__nodes" aria-hidden="true"><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-069"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-070"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-071"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-072"></span></div></div>
      <div class="msc-learn-progress__group"><span class="msc-learn-progress__group-label">Markets</span><div class="msc-learn-progress__nodes" aria-hidden="true"><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-073"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-074"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-075"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-076"></span></div></div>
      <div class="msc-learn-progress__group"><span class="msc-learn-progress__group-label">Community</span><div class="msc-learn-progress__nodes" aria-hidden="true"><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-077"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-078"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-079"></span><span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-080"></span></div></div>
    </div></div>
    <div class="msc-learn-progress__footer" aria-hidden="true"><span>4 sections</span><span>16 guides</span><span data-msc-progress-percent>0% complete</span></div>
  </aside>
</template>

<template data-msc-ecosystem-builders-companion>
  <aside class="msc-ecosystem-builders-companion" aria-label="Bitcoin ecosystem builder map">
    <svg class="msc-ecosystem-builders-system" viewBox="0 0 560 280" role="img" aria-labelledby="msc-eco-builders-title msc-eco-builders-desc">
      <title id="msc-eco-builders-title">Bitcoin ecosystem builder map</title>
      <desc id="msc-eco-builders-desc">Different roles contribute to Bitcoin-related research, software, infrastructure, products, education, policy, media, design, and culture without forming one central builder organization.</desc>
      <g class="msc-ecosystem-system__muted" aria-hidden="true"><circle cx="280" cy="140" r="112"/><circle cx="280" cy="140" r="76"/></g>
      <g class="msc-ecosystem-system__core" aria-hidden="true"><circle cx="280" cy="140" r="46"/><text x="280" y="144" text-anchor="middle">BITCOIN</text></g>
      <circle class="msc-ecosystem-system__response-ring" cx="280" cy="140" r="53" aria-hidden="true"/>
      <g class="msc-ecosystem-system__roles" aria-hidden="true">
        <g class="msc-ecosystem-system__role msc-ecosystem-system__role--1"><rect x="52" y="48" width="108" height="42" rx="7"/><text x="106" y="74" text-anchor="middle">RESEARCH</text></g>
        <g class="msc-ecosystem-system__role msc-ecosystem-system__role--2"><rect x="400" y="48" width="108" height="42" rx="7"/><text x="454" y="74" text-anchor="middle">SOFTWARE</text></g>
        <g class="msc-ecosystem-system__role msc-ecosystem-system__role--3"><rect x="36" y="119" width="112" height="42" rx="7"/><text x="92" y="145" text-anchor="middle">PRODUCTS</text></g>
        <g class="msc-ecosystem-system__role msc-ecosystem-system__role--4"><rect x="412" y="119" width="112" height="42" rx="7"/><text x="468" y="145" text-anchor="middle">SYSTEMS</text></g>
        <g class="msc-ecosystem-system__role msc-ecosystem-system__role--5"><rect x="52" y="190" width="108" height="42" rx="7"/><text x="106" y="216" text-anchor="middle">EDUCATION</text></g>
        <g class="msc-ecosystem-system__role msc-ecosystem-system__role--6"><rect x="400" y="190" width="108" height="42" rx="7"/><text x="454" y="216" text-anchor="middle">CULTURE</text></g>
      </g>
      <g class="msc-ecosystem-system__links" aria-hidden="true"><path d="M160 69L244 113M400 69L316 113M148 140H234M412 140H326M160 211L244 167M400 211L316 167"/></g>
      <g class="msc-ecosystem-system__signals" aria-hidden="true">
        <path class="msc-ecosystem-system__signal msc-ecosystem-system__signal--1" d="M160 69L244 113"/>
        <path class="msc-ecosystem-system__signal msc-ecosystem-system__signal--2" d="M400 69L316 113"/>
        <path class="msc-ecosystem-system__signal msc-ecosystem-system__signal--3" d="M148 140H234"/>
        <path class="msc-ecosystem-system__signal msc-ecosystem-system__signal--4" d="M412 140H326"/>
        <path class="msc-ecosystem-system__signal msc-ecosystem-system__signal--5" d="M160 211L244 167"/>
        <path class="msc-ecosystem-system__signal msc-ecosystem-system__signal--6" d="M400 211L316 167"/>
      </g>
    </svg>
  </aside>
</template>

<style>
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role,
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal {
    animation-delay: var(--msc-eco-delay, 0s);
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role--1,
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal--1 { --msc-eco-delay: 0s; }
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role--2,
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal--2 { --msc-eco-delay: 2s; }
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role--3,
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal--3 { --msc-eco-delay: 4s; }
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role--4,
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal--4 { --msc-eco-delay: 6s; }
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role--5,
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal--5 { --msc-eco-delay: 8s; }
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role--6,
  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal--6 { --msc-eco-delay: 10s; }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role {
    opacity: 1;
    animation-name: msc-ecosystem-role-signal;
    animation-duration: 12s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal {
    opacity: 0;
    stroke-width: 2.1;
    stroke-dasharray: 18 108;
    stroke-dashoffset: 108;
    animation-name: msc-ecosystem-contribution-signal;
    animation-duration: 12s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__response-ring {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: msc-ecosystem-core-response 2s ease-in-out infinite;
  }

  @keyframes msc-ecosystem-role-signal {
    0%, 15%, 100% { filter: none; }
    3%, 10% { filter: brightness(1.55); }
  }

  @keyframes msc-ecosystem-contribution-signal {
    0%, 2%, 15%, 100% { opacity: 0; stroke-dashoffset: 108; }
    4% { opacity: .35; }
    8% { opacity: 1; }
    13% { opacity: 0; stroke-dashoffset: 0; }
  }

  @keyframes msc-ecosystem-core-response {
    0%, 48%, 100% { opacity: 0; transform: scale(.96); }
    58% { opacity: .48; transform: scale(1); }
    76% { opacity: 0; transform: scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__role {
      animation: none;
      filter: none;
    }
    .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__signal,
    .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-ecosystem-system__response-ring {
      display: none;
      animation: none;
    }
  }
</style>

<template data-msc-ecosystem-influence-companion>
  <aside class="msc-ecosystem-influence-companion" aria-label="Bitcoin ecosystem influence map">
    <p class="msc-ecosystem-influence-companion__eyebrow">Influence map</p>
    <h4 class="msc-ecosystem-influence-companion__title">How Industry Influence Travels</h4>
    <div class="msc-ecosystem-influence-field">
      <svg class="msc-ecosystem-influence-system" viewBox="0 0 620 190" role="img" aria-labelledby="msc-eco-influence-title msc-eco-influence-desc">
        <title id="msc-eco-influence-title">How industry influence travels through the Bitcoin ecosystem</title>
        <desc id="msc-eco-influence-desc">Capital, products, systems, funding, and media can strengthen industry influence. That influence then reaches companies, projects, and markets, while accountability, concentration, and exit affect its practical power.</desc>

        <g class="msc-ecosystem-influence-system__inputs" aria-hidden="true">
          <text x="28" y="34">CAPITAL</text>
          <text x="28" y="62">PRODUCTS</text>
          <text x="28" y="90">SYSTEMS</text>
          <text x="28" y="118">FUNDING</text>
          <text x="28" y="146">MEDIA</text>
        </g>

        <g class="msc-ecosystem-influence-system__inbound" aria-hidden="true">
          <path d="M118 30C164 30 188 52 234 68"/>
          <path d="M118 58C168 58 192 67 234 78"/>
          <path d="M118 86H234"/>
          <path d="M118 114C168 114 192 105 234 94"/>
          <path d="M118 142C164 142 188 120 234 104"/>
        </g>

        <g class="msc-ecosystem-influence-system__core" aria-hidden="true">
          <rect x="234" y="48" width="158" height="76" rx="10"/>
          <text class="msc-ecosystem-influence-system__core-title" x="313" y="78" text-anchor="middle">INDUSTRY</text>
          <text class="msc-ecosystem-influence-system__core-title" x="313" y="99" text-anchor="middle">INFLUENCE</text>
          <text class="msc-ecosystem-influence-system__core-note" x="313" y="114" text-anchor="middle">PRACTICAL POWER</text>
        </g>

        <g class="msc-ecosystem-influence-system__outbound" aria-hidden="true">
          <path d="M392 70C438 70 463 54 510 48"/>
          <path d="M392 86H510"/>
          <path d="M392 102C438 102 463 118 510 124"/>
        </g>

        <g class="msc-ecosystem-influence-system__destinations" aria-hidden="true">
          <text x="592" y="52" text-anchor="end">COMPANIES</text>
          <text x="592" y="90" text-anchor="end">PROJECTS</text>
          <text x="592" y="128" text-anchor="end">MARKETS</text>
        </g>

        <g class="msc-ecosystem-influence-system__signals" aria-hidden="true">
          <circle class="msc-ecosystem-influence-system__signal msc-ecosystem-influence-system__signal--in" r="3" cx="118" cy="86"/>
          <circle class="msc-ecosystem-influence-system__signal msc-ecosystem-influence-system__signal--out" r="3" cx="392" cy="86"/>
        </g>

        <g class="msc-ecosystem-influence-system__checks" aria-hidden="true">
          <line x1="86" y1="166" x2="86" y2="173"/><text x="102" y="172">ACCOUNTABILITY</text>
          <line x1="274" y1="166" x2="274" y2="173"/><text x="290" y="172">CONCENTRATION</text>
          <line x1="486" y1="166" x2="486" y2="173"/><text x="502" y="172">EXIT</text>
        </g>
      </svg>
    </div>
  </aside>
</template>

<style>
  .msc-ecosystem-influence-field {
    min-width:0;
    min-height:0;
    overflow:hidden;
    border:1px solid rgba(212,190,153,.2);
    border-radius:14px;
    background:linear-gradient(rgba(212,190,153,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(212,190,153,.028) 1px,transparent 1px),rgba(6,28,32,.14);
    background-size:24px 24px,24px 24px,auto;
  }
  .msc-ecosystem-influence-system { display:block;width:100%;height:100%;min-height:0;color:var(--msc-hub-sand); }
  .msc-ecosystem-influence-system path,
  .msc-ecosystem-influence-system rect,
  .msc-ecosystem-influence-system line,
  .msc-ecosystem-influence-system circle { fill:none;stroke:currentColor;stroke-width:1;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke; }
  .msc-ecosystem-influence-system text { fill:rgba(212,190,153,.72);font-family:var(--font-body-family,sans-serif);font-size:10px;font-weight:800;letter-spacing:.075em; }
  .msc-ecosystem-influence-system__inputs text { fill:rgba(212,190,153,.64); }
  .msc-ecosystem-influence-system__inbound,
  .msc-ecosystem-influence-system__outbound { opacity:.42; }
  .msc-ecosystem-influence-system__core rect { fill:rgba(212,190,153,.035);stroke:rgba(212,190,153,.54); }
  .msc-ecosystem-influence-system__core-title { fill:rgba(212,190,153,.94)!important;font-size:14px!important;letter-spacing:.09em!important; }
  .msc-ecosystem-influence-system__core-note { fill:rgba(212,190,153,.5)!important;font-size:7px!important;letter-spacing:.12em!important; }
  .msc-ecosystem-influence-system__destinations text { fill:rgba(212,190,153,.82);font-size:11px; }
  .msc-ecosystem-influence-system__checks { opacity:.64; }
  .msc-ecosystem-influence-system__checks text { font-size:7px; }
  .msc-ecosystem-influence-system__checks line { stroke-width:1.4; }
  .msc-ecosystem-influence-system__signal { fill:var(--msc-hub-sand)!important;stroke:none!important;opacity:0; }
  .msc-ecosystem-influence-system__signal--in { animation:msc-ecosystem-influence-in 6.6s ease-in-out infinite; }
  .msc-ecosystem-influence-system__signal--out { animation:msc-ecosystem-influence-out 6.6s ease-in-out infinite; }
  .msc-ecosystem-influence-system__core { transform-box:fill-box;transform-origin:center;animation:msc-ecosystem-influence-core 6.6s ease-in-out infinite; }

  @keyframes msc-ecosystem-influence-in {
    0%,8% { opacity:0;transform:translateX(0); }
    13% { opacity:.9; }
    34% { opacity:1;transform:translateX(116px); }
    40%,100% { opacity:0;transform:translateX(116px); }
  }
  @keyframes msc-ecosystem-influence-core {
    0%,32%,58%,100% { filter:none; }
    39%,50% { filter:brightness(1.32); }
  }
  @keyframes msc-ecosystem-influence-out {
    0%,46% { opacity:0;transform:translateX(0); }
    52% { opacity:.9; }
    76% { opacity:1;transform:translateX(118px); }
    84%,100% { opacity:0;transform:translateX(118px); }
  }

  @media screen and (min-width:750px) {
    .msc-learn-page[data-msc-registry-id="MSC-HUB-ECOSYSTEM"] .msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-068"] > .msc-ecosystem-influence-companion {
      display:grid;
      grid-template-columns:minmax(0,1fr);
      grid-template-rows:subgrid;
      row-gap:1rem;
      padding-left:clamp(2.4rem,3.5vw,4rem);
      border-left:0;
    }
    .msc-ecosystem-influence-companion__eyebrow { grid-column:1;grid-row:1; }
    .msc-ecosystem-influence-companion__title { grid-column:1;grid-row:2;white-space:nowrap; }
    .msc-ecosystem-influence-field { grid-column:1;grid-row:3 / 5;align-self:stretch; }
  }

  @media screen and (max-width:749px) {
    .msc-ecosystem-influence-field { min-height:13rem;margin-top:.2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .msc-ecosystem-influence-system__signal,
    .msc-ecosystem-influence-system__core { animation:none; }
    .msc-ecosystem-influence-system__signal { display:none; }
  }
</style>

<script>
  (() => {
    const script = document.currentScript;
    const scope = script.closest('.shopify-section') || document;
    const featured = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-065"]');
    const featuredTemplate = scope.querySelector('template[data-msc-ecosystem-builders-companion]');
    const influence = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-068"]');
    const influenceTemplate = scope.querySelector('template[data-msc-ecosystem-influence-companion]');
    if (featured && featuredTemplate && !featured.querySelector('.msc-ecosystem-builders-companion')) featured.appendChild(featuredTemplate.content.cloneNode(true));
    if (influence && influenceTemplate && !influence.querySelector('.msc-ecosystem-influence-companion')) influence.appendChild(influenceTemplate.content.cloneNode(true));
  })();
</script>

