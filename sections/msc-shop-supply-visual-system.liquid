<style>
  /* Shop Supply Locker visual-system alignment v2.
   * Visual only: preserve collection switching, product data, Quick Add,
   * accessibility repairs, hero alignment, and lower Shop content.
   */

  .msc-shop-supply {
    --msc-shop-line: rgba(212, 190, 153, .34);
    --msc-shop-line-soft: rgba(212, 190, 153, .18);
    --msc-shop-label: rgba(212, 190, 153, .72);
    --msc-shop-paper: rgba(251, 248, 239, .94);
    --msc-shop-paper-muted: rgba(251, 248, 239, .66);
  }

  /* Use the same blue-teal instrument body established by Atlas, SONAR,
   * and the corrected Tools cockpit instead of a near-black retail shell. */
  .msc-shop-supply .msc-supply-console {
    border-color: rgba(212, 190, 153, .42) !important;
    border-radius: 22px !important;
    background:
      radial-gradient(circle at 72% 30%, rgba(212, 190, 153, .075), transparent 31rem),
      radial-gradient(circle at 14% 74%, rgba(78, 107, 113, .12), transparent 35rem),
      linear-gradient(145deg, rgba(30, 72, 80, .88), rgba(18, 52, 59, .9)) !important;
    box-shadow:
      0 24px 68px rgba(5, 20, 24, .22),
      inset 0 1px 0 rgba(251,248,239,.035) !important;
    backdrop-filter: blur(14px);
  }

  .msc-shop-supply .msc-supply-console__bar,
  .msc-shop-supply .msc-supply-console__footer {
    border-color: rgba(212, 190, 153, .28) !important;
    background: rgba(16, 40, 45, .24) !important;
    color: rgba(251, 248, 239, .92) !important;
    font-size: 1rem !important;
    font-weight: 720;
    letter-spacing: .12em !important;
  }

  .msc-shop-supply .msc-supply-console__signal,
  .msc-shop-supply .msc-supply-console__footer a {
    color: rgba(212, 190, 153, .88) !important;
  }

  /* One continuous instrument field: technical linework defines areas before
   * filled boxes do. */
  .msc-shop-supply .msc-supply-console__body {
    background:
      linear-gradient(rgba(212,190,153,.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212,190,153,.022) 1px, transparent 1px),
      radial-gradient(circle at 76% 38%, rgba(212,190,153,.045), transparent 34rem),
      linear-gradient(145deg, rgba(35, 78, 86, .22), rgba(14, 45, 52, .16)) !important;
    background-size: 34px 34px, 34px 34px, auto, auto !important;
  }

  .msc-shop-supply .msc-supply-console__index {
    border-color: rgba(212, 190, 153, .24) !important;
    background: linear-gradient(180deg, rgba(16,40,45,.16), rgba(16,40,45,.07)) !important;
  }

  .msc-shop-supply .msc-supply-inspection {
    background: transparent !important;
  }

  /* Shared MSC label hierarchy: muted sand instrumentation, warm cream
   * primary information, and quieter secondary copy. */
  .msc-shop-supply .msc-supply-console__index-head,
  .msc-shop-supply .msc-supply-inspection__top {
    color: rgba(212, 190, 153, .7) !important;
    font-size: .9rem !important;
    font-weight: 700;
    letter-spacing: .14em !important;
  }

  .msc-shop-supply .msc-supply-micro,
  .msc-shop-supply .msc-supply-product-toolbar,
  .msc-shop-supply .msc-supply-product__meta,
  .msc-shop-supply .msc-supply-product__variant-label,
  .msc-shop-supply .msc-supply-console__index-note > span,
  .msc-shop-supply .msc-supply-collection-head__meta {
    color: rgba(212, 190, 153, .6) !important;
    letter-spacing: .12em !important;
  }

  .msc-shop-supply .msc-supply-micro {
    font-size: .78rem !important;
  }

  .msc-shop-supply .msc-supply-product-toolbar,
  .msc-shop-supply .msc-supply-product__meta,
  .msc-shop-supply .msc-supply-product__variant-label,
  .msc-shop-supply .msc-supply-collection-head__meta {
    font-size: .8rem !important;
  }

  .msc-shop-supply .msc-supply-console__index-note {
    border-color: rgba(212, 190, 153, .15) !important;
    color: rgba(251, 248, 239, .54) !important;
  }

  .msc-shop-supply .msc-supply-console__index-note p {
    color: rgba(251, 248, 239, .58) !important;
  }

  /* Collection controls behave like Atlas/Tools instrument controls rather
   * than separate retail tiles. */
  .msc-shop-supply .msc-supply-bay {
    border-color: rgba(212, 190, 153, .16) !important;
    border-radius: 14px !important;
    color: rgba(251, 248, 239, .7) !important;
    background: rgba(16, 40, 45, .08) !important;
    box-shadow: none !important;
  }

  .msc-shop-supply .msc-supply-bay:hover,
  .msc-shop-supply .msc-supply-bay:focus-visible {
    border-color: rgba(212, 190, 153, .42) !important;
    background: rgba(212, 190, 153, .065) !important;
  }

  .msc-shop-supply .msc-supply-bay.is-active {
    border-color: rgba(212, 190, 153, .54) !important;
    background: linear-gradient(90deg, rgba(212,190,153,.09), rgba(16,40,45,.04)) !important;
    box-shadow: inset 0 0 0 1px rgba(212,190,153,.045) !important;
  }

  .msc-shop-supply .msc-supply-bay__number {
    color: rgba(212, 190, 153, .46) !important;
  }

  .msc-shop-supply .msc-supply-bay__name {
    color: rgba(251, 248, 239, .94) !important;
    font-size: 1.22rem !important;
    font-weight: 760 !important;
    letter-spacing: .045em !important;
  }

  .msc-shop-supply .msc-supply-bay__status {
    color: rgba(212, 190, 153, .76) !important;
    font-size: .82rem !important;
  }

  .msc-shop-supply .msc-supply-collection-head {
    border-color: rgba(212, 190, 153, .18) !important;
  }

  .msc-shop-supply .msc-supply-collection-head h2 {
    color: rgba(251, 248, 239, .96) !important;
    text-shadow: none !important;
  }

  .msc-shop-supply .msc-supply-collection-head p:not(.msc-supply-micro) {
    color: rgba(251, 248, 239, .7) !important;
  }

  .msc-shop-supply .msc-supply-collection-head__meta strong,
  .msc-shop-supply .msc-supply-collection-head__meta a {
    color: rgba(212, 190, 153, .88) !important;
  }

  /* Products sit inside one Inspection Bay. Reduce the independent-card
   * feeling and let thin linework plus the image window carry the structure. */
  .msc-shop-supply .msc-supply-product {
    border-color: rgba(212, 190, 153, .18) !important;
    border-radius: 15px !important;
    background: rgba(16, 40, 45, .08) !important;
    box-shadow: none !important;
  }

  .msc-shop-supply .msc-supply-product__media {
    margin: .65rem .65rem 0;
    overflow: hidden;
    border: 1px solid rgba(212, 190, 153, .26) !important;
    border-radius: 11px;
    background:
      linear-gradient(rgba(212,190,153,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212,190,153,.03) 1px, transparent 1px),
      rgba(16, 40, 45, .18) !important;
    background-size: 28px 28px, 28px 28px, auto !important;
    box-shadow: inset 0 0 0 1px rgba(251,248,239,.015);
  }

  .msc-shop-supply .msc-supply-product__media::before,
  .msc-shop-supply .msc-supply-product__media::after {
    background: rgba(212, 190, 153, .18) !important;
  }

  .msc-shop-supply .msc-supply-product__scan {
    background: linear-gradient(90deg, transparent, rgba(212,190,153,.62), transparent) !important;
  }

  .msc-shop-supply .msc-supply-product__availability {
    border-color: rgba(212, 190, 153, .38) !important;
    background: rgba(212, 190, 153, .86) !important;
    box-shadow: none !important;
  }

  .msc-shop-supply .msc-supply-product__body {
    padding: 1.2rem !important;
  }

  .msc-shop-supply .msc-supply-product h3 {
    color: rgba(251, 248, 239, .95) !important;
    font-weight: 740 !important;
  }

  .msc-shop-supply .msc-supply-product h3 a {
    color: inherit !important;
  }

  .msc-shop-supply .msc-supply-product__price {
    color: rgba(212, 190, 153, .94) !important;
    font-size: 1.22rem !important;
    font-weight: 780 !important;
  }

  .msc-shop-supply .msc-supply-product__variant {
    border-color: rgba(212, 190, 153, .24) !important;
    color: rgba(251, 248, 239, .88) !important;
    background: rgba(16, 40, 45, .2) !important;
  }

  .msc-shop-supply .msc-supply-product__form--repaired,
  .msc-shop-supply .msc-supply-product__form-loading,
  .msc-shop-supply .msc-supply-product__fallback-action {
    border-color: rgba(212, 190, 153, .15) !important;
  }

  /* Sand returns to an accent rather than three large filled bars. */
  .msc-shop-supply .msc-supply-product__quick-add {
    border-color: rgba(212, 190, 153, .7) !important;
    color: rgba(251, 248, 239, .9) !important;
    background: rgba(212, 190, 153, .055) !important;
    transition: color .2s ease, background-color .2s ease, border-color .2s ease;
  }

  .msc-shop-supply .msc-supply-product__quick-add:hover:not(:disabled),
  .msc-shop-supply .msc-supply-product__quick-add:focus-visible:not(:disabled) {
    border-color: rgba(212, 190, 153, .92) !important;
    color: #10282d !important;
    background: rgba(212, 190, 153, .9) !important;
  }

  .msc-shop-supply .msc-supply-product__quick-add:focus-visible {
    outline: 2px solid rgba(212,190,153,.88);
    outline-offset: 2px;
  }

  .msc-shop-supply .msc-supply-product__view,
  .msc-shop-supply .msc-supply-product__fallback-action {
    color: rgba(212, 190, 153, .78) !important;
  }

  .msc-shop-supply .msc-supply-product__view:hover,
  .msc-shop-supply .msc-supply-product__fallback-action:hover {
    color: rgba(251, 248, 239, .94) !important;
  }

  .msc-shop-supply .msc-supply-empty,
  .msc-shop-supply .msc-supply-empty__object {
    border-color: rgba(212, 190, 153, .18) !important;
    background-color: rgba(16, 40, 45, .08) !important;
  }

  @media screen and (max-width: 800px) {
    .msc-shop-supply .msc-supply-console__index {
      border-right: 0 !important;
      border-bottom-color: rgba(212, 190, 153, .24) !important;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .msc-shop-supply .msc-supply-console {
      backdrop-filter: none;
      background-color: #173c43 !important;
    }
  }
</style>

{% schema %}
{
  "name": "MSC Shop visual system",
  "settings": [],
  "presets": [
    {
      "name": "MSC Shop visual system"
    }
  ]
}
{% endschema %}
