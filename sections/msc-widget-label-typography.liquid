<style>
  /*
   * MSC widget visual-system lock v2.
   * Learn SONAR remains the untouched reference for blue-teal housing,
   * depth hierarchy, edge restraint, and text-role hierarchy.
   * This section is visual only: no geometry, behavior, data, navigation,
   * chart, map, commerce, or responsive architecture is changed here.
   */

  .shopify-section.msc-widget-label-typography-section {
    display: contents;
  }

  .msc-signal-card[data-msc-ecosystem-radar],
  .msc-explore-atlas-shell .msc-atlas-window,
  body [data-msc-ecosystem-radar].msc-tools-cockpit,
  .msc-shop-supply .msc-supply-console {
    --msc-widget-edge: rgba(212, 190, 153, .28);
    --msc-widget-edge-mid: rgba(212, 190, 153, .18);
    --msc-widget-edge-soft: rgba(212, 190, 153, .10);
    --msc-widget-cream: rgba(251, 248, 239, .94);
    --msc-widget-cream-soft: rgba(251, 248, 239, .72);
    --msc-widget-cream-faint: rgba(251, 248, 239, .52);
    --msc-widget-sand: rgba(212, 190, 153, .88);
    --msc-widget-sand-soft: rgba(212, 190, 153, .64);
  }

  /* -----------------------------------------------------------------------
   * HOUSING / DEPTH SYSTEM
   * Housing is muted slate-blue. Primary instrument fields step deeper.
   * Structural lines stay quieter than instrumentation.
   * -------------------------------------------------------------------- */

  .msc-signal-card[data-msc-ecosystem-radar],
  .msc-explore-atlas-shell .msc-atlas-window,
  body [data-msc-ecosystem-radar].msc-tools-cockpit,
  .msc-shop-supply .msc-supply-console {
    border-color: var(--msc-widget-edge) !important;
    box-shadow:
      0 24px 70px rgba(8, 25, 33, .16),
      inset 0 1px 0 rgba(251, 248, 239, .025) !important;
  }

  /* HOME RADAR — closest to SONAR already. Keep its glassier personality,
   * but integrate the lower block strip and smooth the field depth. */
  .msc-signal-card[data-msc-ecosystem-radar] {
    background:
      linear-gradient(180deg, rgba(34, 71, 78, .70), rgba(24, 57, 64, .76)) !important;
  }

  .msc-signal-card[data-msc-ecosystem-radar] .msc-signal-field {
    border-color: var(--msc-widget-edge-mid) !important;
    background:
      linear-gradient(rgba(251,248,239,.014) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251,248,239,.014) 1px, transparent 1px),
      radial-gradient(circle at 24% 14%, rgba(212,190,153,.065), transparent 31%),
      radial-gradient(circle at 78% 72%, rgba(78,107,113,.15), transparent 42%),
      linear-gradient(180deg, rgba(30,68,76,.60) 0%, rgba(19,49,57,.78) 48%, rgba(8,25,33,.94) 100%) !important;
    background-size: 34px 34px, 34px 34px, auto, auto, auto !important;
  }

  .msc-signal-card[data-msc-ecosystem-radar] .msc-live-block-strip {
    border-color: var(--msc-widget-edge-mid) !important;
    background:
      linear-gradient(180deg, rgba(26,61,68,.52), rgba(18,48,55,.62)) !important;
    box-shadow: none !important;
  }

  .msc-signal-card[data-msc-ecosystem-radar] .msc-live-block-tile {
    background: transparent !important;
    border-color: var(--msc-widget-edge-soft) !important;
  }

  /* EXPLORE ATLAS — remove the bright-header/dark-map/bright-nav split.
   * Map remains the deep cartographic field; housing and nav now transition
   * toward it instead of reading as separate stacked panels. */
  .msc-explore-atlas-shell .msc-atlas-window {
    background:
      linear-gradient(180deg, rgba(34,71,78,.70), rgba(24,57,64,.78)) !important;
  }

  .msc-explore-atlas-shell .msc-atlas-window__viewport {
    border-color: var(--msc-widget-edge-mid) !important;
    background:
      radial-gradient(circle at 24% 14%, rgba(212,190,153,.065), transparent 31%),
      radial-gradient(circle at 78% 72%, rgba(78,107,113,.16), transparent 42%),
      linear-gradient(180deg, rgba(30,68,76,.62) 0%, rgba(19,49,57,.78) 46%, rgba(8,25,33,.94) 100%) !important;
    box-shadow:
      inset 0 0 0 1px rgba(251,248,239,.018),
      inset 0 -5rem 8rem rgba(4,15,21,.12) !important;
  }

  .msc-explore-atlas-shell .msc-atlas-window__nav {
    border-color: var(--msc-widget-edge-mid) !important;
    background:
      linear-gradient(180deg, rgba(24,58,65,.54), rgba(16,45,52,.64)) !important;
  }

  .msc-explore-atlas-shell button.msc-atlas-region {
    border-color: var(--msc-widget-edge-soft) !important;
  }

  .msc-explore-atlas-shell button.msc-atlas-region:hover,
  .msc-explore-atlas-shell button.msc-atlas-region:focus-visible,
  .msc-explore-atlas-shell button.msc-atlas-region.is-active {
    background: rgba(212,190,153,.055) !important;
  }

  .msc-explore-atlas-shell .msc-atlas-inspect {
    border-color: var(--msc-widget-edge-mid) !important;
    background:
      linear-gradient(180deg, rgba(38,82,89,.66), rgba(16,50,59,.76)),
      rgba(20,60,68,.54) !important;
    box-shadow:
      0 12px 30px rgba(4,15,21,.14),
      inset 0 0 0 1px rgba(251,248,239,.02) !important;
  }

  /* TOOLS COCKPIT — shell was too bright and the grid too prominent.
   * Quiet the grid, deepen the housing, soften module boxing, and retain the
   * price/chart field as the cockpit's deepest visual area. */
  body [data-msc-ecosystem-radar].msc-tools-cockpit {
    background:
      linear-gradient(rgba(251,248,239,.008) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251,248,239,.008) 1px, transparent 1px),
      radial-gradient(circle at 48% 34%, rgba(78,107,113,.12), transparent 46%),
      linear-gradient(180deg, rgba(33,70,77,.86), rgba(23,56,63,.90)) !important;
    background-size: 34px 34px, 34px 34px, auto, auto !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-cockpit__topline {
    border-color: var(--msc-widget-edge-mid) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-readout,
  body [data-msc-ecosystem-radar] .msc-tools-market-activity,
  body [data-msc-ecosystem-radar] .msc-tools-launch,
  body [data-msc-ecosystem-radar] .msc-tools-cockpit__search {
    border-color: var(--msc-widget-edge-soft) !important;
    background: rgba(8,25,33,.14) !important;
    box-shadow: inset 0 1px 0 rgba(251,248,239,.012) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-price {
    border-color: var(--msc-widget-edge-mid) !important;
    background:
      radial-gradient(circle at 24% 14%, rgba(212,190,153,.06), transparent 31%),
      radial-gradient(circle at 78% 72%, rgba(78,107,113,.15), transparent 42%),
      linear-gradient(180deg, rgba(30,68,76,.60) 0%, rgba(19,49,57,.78) 46%, rgba(8,25,33,.94) 100%) !important;
    box-shadow:
      inset 0 1px 0 rgba(251,248,239,.018),
      0 12px 30px rgba(4,15,21,.08) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-market-activity__row,
  body [data-msc-ecosystem-radar] .msc-tools-market-activity__footer,
  body [data-msc-ecosystem-radar] .msc-tools-price__meta-item {
    border-color: var(--msc-widget-edge-soft) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-trace__axis-grid {
    stroke: rgba(212,190,153,.105) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-trace__axis-grid--time {
    stroke: rgba(212,190,153,.06) !important;
  }

  /* SHOP SUPPLY LOCKER — shell was too flat. Give the housing a clearer
   * slate-blue body while allowing the Inspection Bay to step deeper than the
   * index. Controls remain quiet pieces of the same instrument. */
  .msc-shop-supply .msc-supply-console {
    border-color: var(--msc-widget-edge) !important;
    background:
      linear-gradient(180deg, rgba(34,72,79,.78), rgba(24,58,65,.84)) !important;
    box-shadow:
      0 24px 70px rgba(8,25,33,.16),
      inset 0 1px 0 rgba(251,248,239,.025) !important;
  }

  .msc-shop-supply .msc-supply-console__bar,
  .msc-shop-supply .msc-supply-console__footer {
    border-color: var(--msc-widget-edge-mid) !important;
    background: rgba(12,37,44,.18) !important;
  }

  .msc-shop-supply .msc-supply-console__body {
    background:
      linear-gradient(rgba(251,248,239,.009) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251,248,239,.009) 1px, transparent 1px),
      radial-gradient(circle at 76% 36%, rgba(78,107,113,.11), transparent 38rem),
      linear-gradient(180deg, rgba(28,65,72,.36), rgba(18,49,56,.50)) !important;
    background-size: 34px 34px, 34px 34px, auto, auto !important;
  }

  .msc-shop-supply .msc-supply-console__index {
    border-color: var(--msc-widget-edge-mid) !important;
    background:
      linear-gradient(180deg, rgba(27,63,70,.34), rgba(17,47,54,.40)) !important;
  }

  .msc-shop-supply .msc-supply-inspection {
    background:
      radial-gradient(circle at 68% 24%, rgba(78,107,113,.10), transparent 34rem),
      linear-gradient(180deg, rgba(22,57,64,.38), rgba(9,31,38,.62)) !important;
  }

  .msc-shop-supply .msc-supply-group-toggle,
  .msc-shop-supply .msc-supply-bay,
  .msc-shop-supply .msc-supply-product,
  .msc-shop-supply .msc-supply-empty,
  .msc-shop-supply .msc-supply-empty__object {
    border-color: var(--msc-widget-edge-soft) !important;
    background: rgba(8,25,33,.065) !important;
    box-shadow: none !important;
  }

  .msc-shop-supply .msc-supply-group-toggle:hover,
  .msc-shop-supply .msc-supply-group-toggle:focus-visible,
  .msc-shop-supply .msc-supply-group-toggle.is-active,
  .msc-shop-supply .msc-supply-bay:hover,
  .msc-shop-supply .msc-supply-bay:focus-visible,
  .msc-shop-supply .msc-supply-bay.is-active {
    border-color: rgba(212,190,153,.30) !important;
    background: rgba(212,190,153,.045) !important;
  }

  .msc-shop-supply .msc-supply-collection-head,
  .msc-shop-supply .msc-supply-console__index-note {
    border-color: var(--msc-widget-edge-soft) !important;
  }

  .msc-shop-supply .msc-supply-hierarchy-prompt {
    border-color: var(--msc-widget-edge-soft) !important;
    background:
      linear-gradient(rgba(251,248,239,.008) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251,248,239,.008) 1px, transparent 1px),
      linear-gradient(180deg, rgba(18,49,57,.34), rgba(7,26,33,.52)) !important;
    background-size: 28px 28px, 28px 28px, auto !important;
  }

  .msc-shop-supply .msc-supply-product__media,
  .msc-shop-supply .msc-supply-product__variant,
  .msc-shop-supply .msc-supply-product__form--repaired,
  .msc-shop-supply .msc-supply-product__form-loading,
  .msc-shop-supply .msc-supply-product__fallback-action {
    border-color: var(--msc-widget-edge-mid) !important;
  }

  /* -----------------------------------------------------------------------
   * TYPOGRAPHY / COLOR HIERARCHY
   * Preserved from the approved Learn-based lock.
   * -------------------------------------------------------------------- */

  /* Home Radar */
  .msc-signal-card[data-msc-ecosystem-radar] .msc-signal-field__labels > span:first-child::before,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-radar-block-activity__title,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-radar-protocol-wave__label,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-live-block-tile__title {
    color: var(--msc-widget-cream) !important;
  }

  .msc-signal-card[data-msc-ecosystem-radar] .msc-radar-btc__label,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-signal-field__labels > span:first-child::after {
    color: var(--msc-widget-sand) !important;
    font-weight: 780 !important;
    letter-spacing: .12em !important;
    text-transform: uppercase;
  }

  @media screen and (min-width: 741px) {
    .msc-signal-card[data-msc-ecosystem-radar] .msc-signal-field__labels > span:first-child::after {
      font-size: .92rem !important;
      line-height: 1 !important;
    }
  }

  .msc-signal-card[data-msc-ecosystem-radar] .msc-radar-btc__value,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-radar-block-activity__value {
    color: rgba(251,248,239,.97) !important;
  }

  .msc-signal-card[data-msc-ecosystem-radar] .msc-radar-block-activity__context,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-radar-block-activity__label,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-live-block-tile__state,
  .msc-signal-card[data-msc-ecosystem-radar] .msc-live-block-tile__meta {
    color: var(--msc-widget-cream-soft) !important;
  }

  /* Explore Atlas */
  .msc-explore-atlas-shell .msc-atlas-window__identity span,
  .msc-explore-atlas-shell .msc-atlas-window__readout strong,
  .msc-explore-atlas-shell button.msc-atlas-region strong,
  .msc-explore-atlas-shell .msc-atlas-navhud__telemetry-value {
    color: var(--msc-widget-cream) !important;
  }

  .msc-explore-atlas-shell .msc-atlas-window__identity span {
    font-size: 1.15rem !important;
    font-weight: 700 !important;
    line-height: 1.1 !important;
    letter-spacing: .08em !important;
    text-transform: uppercase;
  }

  .msc-explore-atlas-shell .msc-atlas-window__identity strong,
  .msc-explore-atlas-shell .msc-atlas-window__readout span,
  .msc-explore-atlas-shell .msc-atlas-window__coord,
  .msc-explore-atlas-shell .msc-atlas-inspect__kicker,
  .msc-explore-atlas-shell .msc-atlas-inspect__meta {
    color: var(--msc-widget-sand) !important;
    font-size: .92rem !important;
    font-weight: 780 !important;
    line-height: 1 !important;
    letter-spacing: .12em !important;
    text-transform: uppercase;
  }

  .msc-explore-atlas-shell .msc-atlas-navhud__label,
  .msc-explore-atlas-shell .msc-atlas-navhud__telemetry-label {
    color: rgba(212,190,153,.72) !important;
  }

  .msc-explore-atlas-shell .msc-atlas-navhud__micro {
    color: rgba(212,190,153,.5) !important;
  }

  /* Tools Cockpit */
  body [data-msc-ecosystem-radar] .msc-tools-cockpit__status-title,
  body [data-msc-ecosystem-radar] .msc-tools-cockpit__system,
  body [data-msc-ecosystem-radar] .msc-tools-readout__value,
  body [data-msc-ecosystem-radar] .msc-tools-price__value,
  body [data-msc-ecosystem-radar] .msc-tools-market-activity__name,
  body [data-msc-ecosystem-radar] .msc-tools-launch {
    color: var(--msc-widget-cream) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-cockpit__status-subtitle,
  body [data-msc-ecosystem-radar] .msc-tools-readout__label,
  body [data-msc-ecosystem-radar] .msc-tools-price__label,
  body [data-msc-ecosystem-radar] .msc-tools-price__meta-label,
  body [data-msc-ecosystem-radar] .msc-tools-market-activity__label,
  body [data-msc-ecosystem-radar] .msc-tools-cockpit__search-label {
    color: var(--msc-widget-sand) !important;
    font-size: .92rem !important;
    font-weight: 780 !important;
    line-height: 1 !important;
    letter-spacing: .12em !important;
    text-transform: uppercase;
  }

  body [data-msc-ecosystem-radar] .msc-tools-readout__note,
  body [data-msc-ecosystem-radar] .msc-tools-price__change,
  body [data-msc-ecosystem-radar] .msc-tools-market-activity__meta {
    color: var(--msc-widget-cream-soft) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-market-activity__context,
  body [data-msc-ecosystem-radar] .msc-tools-market-activity__status {
    color: var(--msc-widget-sand-soft) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-market-activity__updated {
    color: var(--msc-widget-cream-faint) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-axis-overlay__label--time {
    color: rgba(251,248,239,.52) !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-axis-overlay__label--price {
    color: rgba(251,248,239,.72) !important;
  }

  /* Shop Supply Locker */
  .msc-shop-supply .msc-supply-console__bar,
  .msc-shop-supply .msc-supply-console__footer,
  .msc-shop-supply .msc-supply-group-toggle__name,
  .msc-shop-supply .msc-supply-bay__name,
  .msc-shop-supply .msc-supply-collection-head h2,
  .msc-shop-supply .msc-supply-product h3 {
    color: var(--msc-widget-cream) !important;
  }

  .msc-shop-supply .msc-supply-console__index-head,
  .msc-shop-supply .msc-supply-inspection__top,
  .msc-shop-supply .msc-supply-console__signal,
  .msc-shop-supply .msc-supply-micro {
    color: var(--msc-widget-sand) !important;
    font-weight: 780 !important;
    letter-spacing: .12em !important;
    text-transform: uppercase;
  }

  .msc-shop-supply .msc-supply-console__index-head,
  .msc-shop-supply .msc-supply-inspection__top,
  .msc-shop-supply .msc-supply-console__signal {
    font-size: .92rem !important;
    line-height: 1 !important;
  }

  .msc-shop-supply .msc-supply-group-toggle__count,
  .msc-shop-supply .msc-supply-bay__status,
  .msc-shop-supply .msc-supply-product-toolbar,
  .msc-shop-supply .msc-supply-product__meta,
  .msc-shop-supply .msc-supply-product__variant-label,
  .msc-shop-supply .msc-supply-collection-head__meta,
  .msc-shop-supply .msc-supply-hierarchy-prompt {
    color: var(--msc-widget-sand-soft) !important;
  }

  .msc-shop-supply .msc-supply-console__index-note,
  .msc-shop-supply .msc-supply-console__index-note p,
  .msc-shop-supply .msc-supply-collection-head p:not(.msc-supply-micro),
  .msc-shop-supply .msc-supply-empty > div:last-child > p:not(.msc-supply-micro) {
    color: var(--msc-widget-cream-soft) !important;
  }

  .msc-shop-supply .msc-supply-product__price {
    color: rgba(251,248,239,.94) !important;
  }

  .msc-shop-supply .msc-supply-console__footer a,
  .msc-shop-supply .msc-supply-collection-head__meta strong,
  .msc-shop-supply .msc-supply-collection-head__meta a,
  .msc-shop-supply .msc-supply-product__view,
  .msc-shop-supply .msc-supply-product__fallback-action {
    color: var(--msc-widget-sand) !important;
  }

  /* Solid sand remains reserved for intentional primary actions. */
  body [data-msc-ecosystem-radar] .msc-tools-cockpit__search button,
  .msc-shop-supply .msc-supply-product__quick-add:hover:not(:disabled),
  .msc-shop-supply .msc-supply-product__quick-add:focus-visible:not(:disabled) {
    border-color: rgba(212,190,153,.9) !important;
    background: rgba(212,190,153,.9) !important;
    color: #10282d !important;
  }

  @media (prefers-reduced-transparency: reduce) {
    body [data-msc-ecosystem-radar].msc-tools-cockpit,
    .msc-shop-supply .msc-supply-console,
    .msc-explore-atlas-shell .msc-atlas-window,
    .msc-signal-card[data-msc-ecosystem-radar] {
      background-color: #173c43 !important;
    }
  }
</style>

{% schema %}
{
  "name": "MSC widget style lock",
  "tag": "section",
  "class": "msc-widget-label-typography-section",
  "settings": [],
  "presets": [
    {
      "name": "MSC widget style lock"
    }
  ]
}
{% endschema %}