          <div class="msc-learn-progress__groups">
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Foundations</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node is-current" data-msc-progress-guide="MSC-GUIDE-001"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-002"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-003"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-004"></span>
              </div>
            </div>
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Using Bitcoin</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-005"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-006"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-007"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-008"></span>
              </div>
            </div>
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Security</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-009"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-010"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-011"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-012"></span>
              </div>
            </div>
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Essentials</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-013"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-014"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-015"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-016"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="msc-learn-progress__footer" aria-hidden="true">
          <span>4 sections</span>
          <span>16 guides</span>
          <span data-msc-progress-percent>0% complete</span>
        </div>
      </aside>
    </template>
