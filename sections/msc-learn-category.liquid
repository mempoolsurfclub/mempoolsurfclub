{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-hub.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-hub-companion.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-hub-progress.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-hub-meta.css' | asset_url | stylesheet_tag }}
<script src="{{ 'msc-learn-hub-progress.js' | asset_url }}" defer="defer"></script>
{%- assign pilot_registry_id = section.settings.registry_id | strip -%}
{%- case pilot_registry_id -%}
  {%- when 'MSC-HUB-BASICS' -%}
    {% render 'msc-learn-basics-hub-runtime' %}
    <style>
      .msc-learn-page[data-msc-registry-id="MSC-HUB-BASICS"] .msc-learn-page__header h1 {
        text-transform: uppercase;
      }

      @media screen and (min-width: 750px) {
        .msc-learn-page[data-msc-registry-id="MSC-HUB-BASICS"] .msc-learn-page__header h1 {
          max-width: none;
          white-space: nowrap;
          transform: translateX(-1.2rem);
        }
      }
    </style>
    <template data-msc-learn-progress-template="MSC-HUB-BASICS">
      <aside
        class="msc-learn-progress"
        data-msc-learn-progress
        data-hub-id="MSC-HUB-BASICS"
        data-total-guides="16"
        data-account-state="{% if customer %}authenticated{% else %}guest{% endif %}"
        aria-label="Bitcoin Basics learning progress"
      >
        <div class="msc-learn-progress__topline">
          <p class="msc-learn-progress__eyebrow">Learning position</p>
          <p class="msc-learn-progress__position" data-msc-progress-position>Position 001</p>
        </div>

        <div class="msc-learn-progress__readout" aria-hidden="true">
          <strong data-msc-progress-count>00</strong>
          <span>/ 16</span>
        </div>

        <p class="msc-learn-progress__summary">
          <span data-msc-progress-completed>0 complete</span>
          <span class="msc-learn-progress__summary-separator">·</span>
          <span data-msc-progress-remaining>16 remaining</span>
        </p>

        <div class="msc-learn-progress__current">
          <p class="msc-learn-progress__current-label" data-msc-progress-current-label>Start here</p>
          <p class="msc-learn-progress__current-title">
            <span class="msc-learn-progress__current-number" data-msc-progress-current-number>001</span>
            <span aria-hidden="true">—</span>
            <span data-msc-progress-current-title>What Is Bitcoin?</span>
          </p>
        </div>

        <div
          class="msc-learn-progress__track"
          role="progressbar"
          aria-label="Bitcoin Basics guide completion"
          aria-valuemin="0"
          aria-valuemax="16"
          aria-valuenow="0"
          aria-valuetext="0 of 16 guides complete"
        >
          <div class="msc-learn-progress__groups">
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Foundations</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node is-current" data-msc-progress-guide="MSC-GUIDE-001"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-002"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-003"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-004"></span>
              </div>
            </div>
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Using Bitcoin</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-005"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-006"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-007"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-008"></span>
              </div>
            </div>
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Security</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-009"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-010"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-011"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-012"></span>
              </div>
            </div>
            <div class="msc-learn-progress__group">
              <span class="msc-learn-progress__group-label">Essentials</span>
              <div class="msc-learn-progress__nodes" aria-hidden="true">
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-013"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-014"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-015"></span>
                <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-016"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="msc-learn-progress__footer" aria-hidden="true">
          <span>4 sections</span>
          <span>16 guides</span>
          <span data-msc-progress-percent>0% complete</span>
        </div>
      </aside>
    </template>
    <template data-msc-guide-companion-template="MSC-GUIDE-001">
      <aside class="msc-guide-companion msc-guide-companion--systems" aria-label="What is Bitcoin visual">
        <svg class="msc-guide-emblem" viewBox="0 0 520 260" role="img" aria-labelledby="msc-guide-001-emblem-title msc-guide-001-emblem-desc">
          <title id="msc-guide-001-emblem-title">Bitcoin symbol becoming a question mark</title>
          <desc id="msc-guide-001-emblem-desc">A matte Bitcoin symbol slowly turns edge-on, becomes a question mark, then turns back into the Bitcoin symbol.</desc>

          <g class="msc-guide-emblem__field" aria-hidden="true">
            <circle cx="260" cy="130" r="83" />
            <circle cx="260" cy="130" r="57" />
            <path d="M260 31V43M260 217V229M161 130H173M347 130H359" />
            <ellipse cx="260" cy="210" rx="78" ry="8" class="msc-guide-emblem__shadow" />
          </g>

          <g class="msc-guide-emblem__symbol msc-guide-emblem__symbol--bitcoin" aria-hidden="true">
            <text class="msc-guide-emblem__depth msc-guide-emblem__depth--far" x="268" y="169" text-anchor="middle">₿</text>
            <text class="msc-guide-emblem__depth msc-guide-emblem__depth--mid" x="264" y="169" text-anchor="middle">₿</text>
            <text class="msc-guide-emblem__depth msc-guide-emblem__depth--near" x="261" y="169" text-anchor="middle">₿</text>
            <text class="msc-guide-emblem__face" x="258" y="169" text-anchor="middle">₿</text>
          </g>

          <g class="msc-guide-emblem__symbol msc-guide-emblem__symbol--question" aria-hidden="true">
            <text class="msc-guide-emblem__depth msc-guide-emblem__depth--far" x="268" y="171" text-anchor="middle">?</text>
            <text class="msc-guide-emblem__depth msc-guide-emblem__depth--mid" x="264" y="171" text-anchor="middle">?</text>
            <text class="msc-guide-emblem__depth msc-guide-emblem__depth--near" x="261" y="171" text-anchor="middle">?</text>
            <text class="msc-guide-emblem__face" x="258" y="171" text-anchor="middle">?</text>
          </g>
        </svg>
      </aside>
    </template>
    <template data-msc-guide-companion-template="MSC-GUIDE-004">
      <aside class="msc-guide-companion" aria-label="Satoshi documented timeline">
        <p class="msc-guide-companion__eyebrow">Documented record</p>
        <h4 class="msc-guide-companion__title">From proposal to withdrawal</h4>
        <ol class="msc-guide-timeline">
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2008</span>
            <span class="msc-guide-timeline__label">White paper announced on October 31</span>
          </li>
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2009</span>
            <span class="msc-guide-timeline__label">First public software released and genesis block created</span>
          </li>
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2009–10</span>
            <span class="msc-guide-timeline__label">Early testing, technical discussion, and collaboration</span>
          </li>
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2010–11</span>
            <span class="msc-guide-timeline__label">Public involvement declines and winds down</span>
          </li>
        </ol>
      </aside>
    </template>
    <script>
      (() => {
        const script = document.currentScript;
        const scope = script.closest('.shopify-section') || document;
        const page = scope.querySelector('.msc-learn-page[data-msc-registry-id="MSC-HUB-BASICS"]');
        const heroMeta = page ? page.querySelector('.msc-learn-page__header .msc-learn-page-meta') : null;
        const readingTime = heroMeta ? heroMeta.querySelector('li:nth-child(3)') : null;

        if (readingTime && readingTime.textContent.trim() !== '18 MIN HUB REVIEW') {
          readingTime.title = readingTime.textContent.trim();
          readingTime.textContent = '18 MIN HUB REVIEW';
        }

        const featuredCard = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-001"]');
        const featuredTemplate = scope.querySelector('template[data-msc-guide-companion-template="MSC-GUIDE-001"]');
        if (featuredCard && featuredTemplate && !featuredCard.querySelector('.msc-guide-companion--systems')) {
          featuredCard.appendChild(featuredTemplate.content.cloneNode(true));
        }

        const card = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-004"]');
        const template = scope.querySelector('template[data-msc-guide-companion-template="MSC-GUIDE-004"]');
        if (!card || !template || card.querySelector('.msc-guide-companion')) return;
        card.appendChild(template.content.cloneNode(true));
      })();
    </script>
  {%- else -%}
    <section class="msc-shell msc-learn-page" data-msc-preview-only="true">
      <div class="msc-container msc-learn-page__container">
        <header class="msc-learn-page__header">
          <p class="msc-section-kicker">Learn runtime preview</p>
          <h1>Category preview unavailable</h1>
          <p>No structured runtime package is registered for {{ pilot_registry_id | escape }}.</p>
        </header>
      </div>
    </section>
{%- endcase -%}
{% schema %}
{
  "name": "MSC Learn category",
  "settings": [
    {
      "type": "text",
      "id": "registry_id",
      "label": "Registry ID",
      "default": "MSC-HUB-BASICS",
      "info": "Preview-only binding. Do not enter a handle or URL."
    }
  ]
}
{% endschema %}
