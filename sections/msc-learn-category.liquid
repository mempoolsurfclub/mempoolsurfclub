    <template data-msc-guide-companion-template="MSC-GUIDE-004">
      <aside class="msc-guide-companion" aria-label="Satoshi documented timeline">
        <p class="msc-guide-companion__eyebrow">Documented record</p>
        <h4 class="msc-guide-companion__title">From proposal to withdrawal</h4>
        <ol class="msc-guide-timeline">
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2008</span>
            <span class="msc-guide-timeline__label">White paper announced on October 31</span>
          </li>
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2009</span>
            <span class="msc-guide-timeline__label">First public software released and genesis block created</span>
          </li>
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2009–10</span>
            <span class="msc-guide-timeline__label">Early testing, technical discussion, and collaboration</span>
          </li>
          <li class="msc-guide-timeline__item">
            <span class="msc-guide-timeline__date">2010–11</span>
            <span class="msc-guide-timeline__label">Public involvement declines and winds down</span>
          </li>
        </ol>
      </aside>
    </template>
    <script>
      (() => {
        const script = document.currentScript;
        const scope = script.closest('.shopify-section') || document;
        const page = scope.querySelector('.msc-learn-page[data-msc-registry-id="MSC-HUB-BASICS"]');
        const heroMeta = page ? page.querySelector('.msc-learn-page__header .msc-learn-page-meta') : null;
        const readingTime = heroMeta ? heroMeta.querySelector('li:nth-child(3)') : null;

        if (readingTime && readingTime.textContent.trim() !== '18 MIN HUB REVIEW') {
          readingTime.title = readingTime.textContent.trim();
          readingTime.textContent = '18 MIN HUB REVIEW';
        }

        const featuredCard = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-001"]');
        const featuredTemplate = scope.querySelector('template[data-msc-guide-companion-template="MSC-GUIDE-001"]');
        if (featuredCard && featuredTemplate && !featuredCard.querySelector('.msc-guide-companion--systems')) {
          featuredCard.appendChild(featuredTemplate.content.cloneNode(true));
        }

        const card = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-004"]');
        const template = scope.querySelector('template[data-msc-guide-companion-template="MSC-GUIDE-004"]');
        if (!card || !template || card.querySelector('.msc-guide-companion')) return;
        card.appendChild(template.content.cloneNode(true));
      })();
    </script>
  {%- else -%}
    <section class="msc-shell msc-learn-page" data-msc-preview-only="true">
      <div class="msc-container msc-learn-page__container">
        <header class="msc-learn-page__header">
          <p class="msc-section-kicker">Learn runtime preview</p>
          <h1>Category preview unavailable</h1>
          <p>No structured runtime package is registered for {{ pilot_registry_id | escape }}.</p>
        </header>
      </div>
    </section>
{%- endcase -%}
{% schema %}
{
  "name": "MSC Learn category",
  "settings": [
    {
      "type": "text",
      "id": "registry_id",
      "label": "Registry ID",
      "default": "MSC-HUB-BASICS",
      "info": "Preview-only binding. Do not enter a handle or URL."
    }
  ]
}
{% endschema %}
