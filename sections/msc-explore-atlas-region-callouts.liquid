{{ 'msc-explore-atlas-callouts.css' | asset_url | stylesheet_tag }}
<script src="{{ 'msc-explore-atlas-callouts.js' | asset_url }}" defer></script>

<span
  hidden
  aria-hidden="true"
  data-atlas-callout-routes
  data-atlas-route-ordinals="{{ section.settings.ordinals_link }}"
  data-atlas-route-runes="{{ section.settings.runes_link }}"
  data-atlas-route-wallets="{{ section.settings.wallets_link }}"
  data-atlas-route-marketplaces="{{ section.settings.marketplaces_link }}"
  data-atlas-route-mining="{{ section.settings.mining_link }}"
  data-atlas-route-payments="{{ section.settings.payments_link }}"
  data-atlas-route-exchanges="{{ section.settings.exchanges_link }}"
  data-atlas-route-network="{{ section.settings.network_link }}"
></span>

{% schema %}
{
  "name": "MSC Atlas Region Callouts",
  "tag": "div",
  "class": "msc-atlas-callout-loader",
  "settings": [
    { "type": "url", "id": "ordinals_link", "label": "Ordinals page" },
    { "type": "url", "id": "runes_link", "label": "Runes page" },
    { "type": "url", "id": "wallets_link", "label": "Wallets page" },
    { "type": "url", "id": "marketplaces_link", "label": "Marketplaces page" },
    { "type": "url", "id": "mining_link", "label": "Mining page" },
    { "type": "url", "id": "payments_link", "label": "Payments page" },
    { "type": "url", "id": "exchanges_link", "label": "Exchanges page" },
    { "type": "url", "id": "network_link", "label": "Network page" }
  ],
  "presets": [
    { "name": "MSC Atlas Region Callouts" }
  ]
}
{% endschema %}
