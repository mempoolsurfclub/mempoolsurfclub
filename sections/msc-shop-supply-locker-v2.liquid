<script>
(() => {
  const root = document.getElementById('MscShopSupply-{{ section.id }}');
  if (!root || root.dataset.supplyInitialized === 'true') return;
  root.dataset.supplyInitialized = 'true';

  const bays = [...root.querySelectorAll('[data-shop-bay]')];
  const panels = [...root.querySelectorAll('[data-bay-panel]')];

  function inspect(panelId) {
    bays.forEach((bay) => {
      const active = bay.dataset.panelId === panelId;
      bay.classList.toggle('is-active', active);
      bay.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    panels.forEach((panel) => {
      const active = panel.dataset.bayPanel === panelId;
      panel.hidden = !active;
      panel.classList.toggle('is-active', active);
    });
  }

  bays.forEach((bay) => {
    bay.addEventListener('click', () => inspect(bay.dataset.panelId));
    bay.addEventListener('mouseenter', () => inspect(bay.dataset.panelId));
    bay.addEventListener('focus', () => inspect(bay.dataset.panelId));
  });

  root.querySelectorAll('[data-variant-select]').forEach((select) => {
    select.addEventListener('change', () => {
      const card = select.closest('[data-supply-product]');
      const price = card && card.querySelector('[data-product-price]');
      const option = select.options[select.selectedIndex];
      if (price && option && option.dataset.price) price.textContent = option.dataset.price;
    });
  });
})();
</script>

