{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-depth-chart.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'msc-learn-hero-wide.css' | asset_url }}" data-msc-learn-hero-wide>
<script src="{{ 'msc-learn-depth-chart.js' | asset_url }}" defer></script>

<style>
  @media screen and (min-width: 991px) {
    .msc-learn .msc-depth-map__brief {
      top: 3rem !important;
      right: 3rem !important;
      bottom: 3rem !important;
    }

    .msc-learn .msc-depth-map__brief-visual {
      display: none !important;
    }

    .msc-learn .msc-depth-map__title {
      font-size: 1.72rem !important;
      line-height: 1.05 !important;
    }

    .msc-learn .msc-depth-map__brief[data-region="overview"] .msc-depth-map__brief-overview,
    .msc-learn .msc-depth-map__brief:not([data-region="overview"]) .msc-depth-map__brief-detail {
      display: flex !important;
      flex-direction: column;
      height: 100%;
      min-height: 0;
    }

    .msc-learn .msc-depth-map__brief[data-region="overview"] .msc-depth-map__brief-detail,
    .msc-learn .msc-depth-map__brief:not([data-region="overview"]) .msc-depth-map__brief-overview {
      display: none !important;
    }

    .msc-learn .msc-depth-map__brief-copy,
    .msc-learn .msc-depth-map__brief-system-copy {
      width: 100%;
      max-width: none;
    }

    .msc-learn .msc-depth-map__brief-footer {
      flex: 0 0 auto;
      width: 100%;
      margin-top: auto;
    }

    .msc-learn .msc-depth-map__brief-action {
      flex: 0 0 auto;
      overflow: visible;
      text-overflow: clip;
      white-space: nowrap;
    }
  }
</style>

<script>
  (() => {
    const initSonarBriefConsistency = () => {
      const learn = document.getElementById('MscLearn-{{ section.id }}');
      const chart = learn?.querySelector('.msc-depth-chart');
      const map = chart?.querySelector('.msc-depth-map');
      const brief = map?.querySelector('.msc-depth-map__brief');
      const status = chart?.querySelector('.msc-sonar-status');

      if (!learn || !chart || !map || !brief || !status) return;
      if (chart.dataset.mscBriefConsistency === 'true') return;
      chart.dataset.mscBriefConsistency = 'true';

      const briefCopyByRegion = {
        basics: 'Start with Bitcoin’s foundations: ownership, wallets, transactions, fees, security, privacy, and the monetary concepts that explain how the system works.',
        network: 'Follow Bitcoin’s network through mining, nodes, mempools, blocks, proof of work, consensus, chainwork, and the upgrade process that coordinates change.',
        building: 'Explore systems built around Bitcoin, including Layer 2 networks, digital assets, developer tools, and emerging protocols, with their assumptions and tradeoffs.',
        development: 'Go inside Bitcoin’s protocol machinery: Bitcoin Core, BIPs, Script, cryptography, testing, infrastructure, and the line between consensus rules and software policy.',
        ecosystem: 'Map Bitcoin’s wider ecosystem: builders, companies, service providers, marketplaces, communities, conferences, history, and open-source projects, without confusing influence with protocol authority.'
      };

      const overviewCopy = 'Use MSC SONAR to move from Bitcoin fundamentals into network mechanics, systems built on Bitcoin, protocol internals, and the wider ecosystem. Hover over a depth to explore.';
      const regionLinks = Array.from(map.querySelectorAll('.msc-depth-map__region[data-region]'));
      const regions = new Map();

      regionLinks.forEach((link) => {
        const key = link.dataset.region;
        if (!key) return;

        const label = link.querySelector('.msc-depth-map__depth-name')?.textContent?.trim() || key;
        const title = link.querySelector('.msc-depth-map__title')?.textContent?.trim() || label;

        regions.set(key, {
          key,
          label,
          title,
          href: link.getAttribute('href') || '#',
          brief: briefCopyByRegion[key] || ''
        });
      });

      const statusDepth = status.querySelector('.msc-sonar-status__depth');
      const statusGuide = status.querySelector('.msc-sonar-status__guide');
      const briefOverview = brief.querySelector('.msc-depth-map__brief-overview');
      const briefSystemCopy = brief.querySelector('.msc-depth-map__brief-system-copy');
      const briefDepth = brief.querySelector('.msc-depth-map__brief-depth');
      const briefTitle = brief.querySelector('.msc-depth-map__brief-title');
      const briefCopy = brief.querySelector('.msc-depth-map__brief-copy');
      const briefCount = brief.querySelector('.msc-depth-map__brief-count');
      const briefAction = brief.querySelector('.msc-depth-map__brief-action');

      if (!statusDepth || !statusGuide || !briefOverview || !briefSystemCopy || !briefDepth || !briefTitle || !briefCopy || !briefCount || !briefAction) return;

      briefSystemCopy.textContent = overviewCopy;

      let overviewFooter = briefOverview.querySelector('.msc-depth-map__brief-footer--overview');
      if (!overviewFooter) {
        overviewFooter = document.createElement('div');
        overviewFooter.className = 'msc-depth-map__brief-footer msc-depth-map__brief-footer--overview';
        overviewFooter.innerHTML = `
          <span class="msc-depth-map__brief-count">${regions.size * 16} guides</span>
          <a class="msc-depth-map__brief-action" href="#MscLearnIndex-{{ section.id }}">View all →</a>
        `;
        briefOverview.appendChild(overviewFooter);
      }

      const renderRegion = (key) => {
        const region = regions.get(key);
        if (!region) return;

        map.dataset.active = key;
        status.dataset.region = key;
        statusDepth.textContent = region.label;
        statusGuide.textContent = region.title;
        status.setAttribute('aria-label', `Current position: ${region.label}. ${region.title}`);

        brief.dataset.region = key;
        briefDepth.textContent = region.label;
        briefTitle.textContent = region.title;
        briefCopy.textContent = region.brief;
        briefCount.textContent = '16 guides';
        briefAction.href = region.href;
        briefAction.textContent = 'View guide →';
        briefAction.setAttribute('aria-label', `View ${region.title} guide`);
        brief.setAttribute('aria-label', `${region.label} depth brief: ${region.title}`);
      };

      const renderOverview = () => {
        map.dataset.active = 'overview';
        status.dataset.region = 'overview';
        statusDepth.textContent = '';
        statusGuide.textContent = '';
        status.setAttribute('aria-label', 'MSC SONAR Learn System overview');
        brief.dataset.region = 'overview';
        briefSystemCopy.textContent = overviewCopy;
        brief.setAttribute('aria-label', 'MSC SONAR Learn System overview');
      };

      let activeKey = null;
      let pointerInsideChart = false;
      let restoring = false;

      const activate = (key) => {
        if (!regions.has(key)) return;
        activeKey = key;
        renderRegion(key);
      };

      regionLinks.forEach((link) => {
        const key = link.dataset.region;
        link.addEventListener('pointerenter', () => activate(key));
        link.addEventListener('focus', () => activate(key));
      });

      status.querySelectorAll('.msc-sonar-status__node[data-region]').forEach((node) => {
        const key = node.dataset.region;
        node.addEventListener('pointerenter', () => activate(key));
        node.addEventListener('focus', () => activate(key));
      });

      chart.addEventListener('pointerenter', () => {
        pointerInsideChart = true;
      });

      chart.addEventListener('pointerleave', () => {
        pointerInsideChart = false;
        activeKey = null;
        renderOverview();
      });

      chart.addEventListener('focusout', (event) => {
        if (activeKey && event.relatedTarget && chart.contains(event.relatedTarget)) {
          queueMicrotask(() => renderRegion(activeKey));
          return;
        }

        requestAnimationFrame(() => {
          if (!pointerInsideChart && !chart.contains(document.activeElement)) {
            activeKey = null;
            renderOverview();
          }
        });
      });

      const maintainActiveRegion = () => {
        if (restoring || !activeKey) return;
        if (!pointerInsideChart && !chart.contains(document.activeElement)) return;

        if (map.dataset.active !== activeKey || brief.dataset.region !== activeKey || status.dataset.region !== activeKey) {
          restoring = true;
          renderRegion(activeKey);
          restoring = false;
        }
      };

      const observer = new MutationObserver(maintainActiveRegion);
      observer.observe(map, { attributes: true, attributeFilter: ['data-active'] });
      observer.observe(brief, { attributes: true, attributeFilter: ['data-region'] });
      observer.observe(status, { attributes: true, attributeFilter: ['data-region'] });

      renderOverview();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSonarBriefConsistency, { once: true });
    } else {
      initSonarBriefConsistency();
    }
  })();
</script>

{%- assign search_input_id = 'MscLearnSearchInput-' | append: section.id -%}

<section class="msc-shell msc-learn" id="MscLearn-{{ section.id }}">
  <div class="msc-container">
    <div class="msc-learn-hero">
      <div class="msc-learn-hero__content">
        <div class="msc-eyebrow msc-rotating-signal" aria-label="{{ section.settings.signal_phrase_1 | escape }}">
          <span class="msc-rotating-signal__indicator" aria-hidden="true"></span>
          <span class="msc-rotating-signal__phrases"><span>{{ section.settings.signal_phrase_1 | escape }}</span><span>{{ section.settings.signal_phrase_2 | escape }}</span><span>{{ section.settings.signal_phrase_3 | escape }}</span></span>
        </div>
        <h1 class="msc-title msc-learn-hero__title">{{ section.settings.heading | escape }}</h1>
        <div class="msc-subtitle msc-learn-hero__copy rte">{{ section.settings.supporting_copy }}</div>
        {% render 'msc-search-form', input_id: search_input_id, placeholder: section.settings.search_placeholder, button_label: section.settings.search_button, search_types: section.settings.search_types, label: section.settings.search_label, modifier: 'learn' %}
      </div>

      <aside class="msc-depth-chart msc-glass-card" aria-labelledby="MscDepthChartTitle-{{ section.id }}">
        <div class="msc-depth-chart__header">
          <span id="MscDepthChartTitle-{{ section.id }}">Knowledge Depth Chart</span>
          <span>{{ section.settings.chart_label | escape }}</span>
        </div>
        <div class="msc-depth-chart__field" aria-hidden="true">
          <svg class="msc-depth-chart__contours" viewBox="0 0 720 440" preserveAspectRatio="none" focusable="false">
            <path d="M18 86 C120 56 190 116 288 82 S468 48 700 92" />
            <path d="M22 184 C126 146 210 222 326 180 S520 136 698 190" />
            <path d="M18 292 C132 248 222 338 362 286 S560 238 704 300" />
            <path d="M24 382 C150 340 252 420 398 374 S586 330 700 390" />
          </svg>
          <div class="msc-depth-chart__band"><span>1. Surface</span><strong>Foundations</strong><i>00m</i></div>
          <div class="msc-depth-chart__band"><span>2. Shallow</span><strong>Using Bitcoin</strong><i>25m</i></div>
          <div class="msc-depth-chart__band"><span>3. Deep</span><strong>Network &amp; Protocols</strong><i>50m</i></div>
          <div class="msc-depth-chart__band"><span>4. Trench</span><strong>Development &amp; Ecosystem</strong><i>100m</i></div>
          <div class="msc-depth-chart__guide msc-depth-chart__guide--one"></div>
          <div class="msc-depth-chart__guide msc-depth-chart__guide--two"></div>
          <div class="msc-depth-chart__guide msc-depth-chart__guide--three"></div>
          <div class="msc-depth-chart__point msc-depth-chart__point--one"></div>
          <div class="msc-depth-chart__point msc-depth-chart__point--two"></div>
          <div class="msc-depth-chart__point msc-depth-chart__point--three"></div>
          <div class="msc-depth-chart__point msc-depth-chart__point--four"></div>
        </div>
      </aside>
    </div>

    <div class="msc-block msc-learn-paths-block" aria-labelledby="MscLearnPaths-{{ section.id }}">
      {% render 'msc-section-header', kicker: section.settings.paths_kicker, heading: section.settings.paths_heading, copy: section.settings.paths_copy, heading_id: 'MscLearnPaths-' | append: section.id %}
      <div class="msc-learn-path-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'learning_path' -%}
            {% render 'msc-learning-path-card', title: block.settings.title, description: block.settings.description, link: block.settings.link, marker: block.settings.marker, recommended: block.settings.recommended, recommended_label: block.settings.recommended_label, action_label: block.settings.action_label, planned_handle: block.settings.planned_handle %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="msc-block msc-learn-index-block" aria-labelledby="MscLearnIndex-{{ section.id }}">
      {% render 'msc-section-header', kicker: section.settings.index_kicker, heading: section.settings.index_heading, copy: section.settings.index_copy, heading_id: 'MscLearnIndex-' | append: section.id %}
      <div class="msc-learn-index">
        {%- assign group_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'topic_group' -%}
            {%- assign group_index = group_index | plus: 1 -%}
            <details class="msc-learn-topic msc-glass-card"{% if group_index == 1 and section.settings.open_first_group %} open{% endif %}>
              <summary>
                <span class="msc-learn-topic__summary-copy">
                  <span>{{ block.settings.title | escape }}</span>
                  <small>{{ block.settings.guide_note | escape }}</small>
                </span>
                <span class="msc-learn-topic__toggle" aria-hidden="true"></span>
              </summary>
              <div class="msc-learn-topic__content">
                <p class="msc-learn-topic__preview-label">Topic Preview</p>
                <div class="msc-learn-topic__grid">
                  {%- assign subcategories = block.settings.subcategories | newline_to_br | split: '<br />' -%}
                  {%- assign topics = block.settings.topics | newline_to_br | split: '<br />' -%}
                  {%- for subcategory in subcategories -%}
                    <div class="msc-learn-topic__column">
                      <h3>{{ subcategory | strip | escape }}</h3>
                      <ul>
                        {%- assign topic_line = topics[forloop.index0] | default: '' -%}
                        {%- assign topic_items = topic_line | split: ',' -%}
                        {%- for item in topic_items -%}<li>{{ item | strip | escape }}</li>{%- endfor -%}
                      </ul>
                    </div>
                  {%- endfor -%}
                </div>
                {%- assign category_link = block.settings.guide_link -%}
                {%- if category_link == blank and block.settings.planned_handle != blank -%}
                  {%- assign category_page = pages[block.settings.planned_handle] -%}
                  {%- if category_page -%}{%- assign category_link = category_page.url -%}{%- endif -%}
                {%- endif -%}
                {%- if category_link != blank -%}
                  <a class="msc-learn-topic__guide-link" href="{{ category_link }}">{{ block.settings.guide_action_label | default: 'Explore the full guide' | escape }} <span aria-hidden="true">→</span></a>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="msc-block msc-learn-route-block" aria-labelledby="MscLearnRoute-{{ section.id }}">
      <article class="msc-learn-route msc-glass-card">
        <div>
          <p class="msc-section-kicker">{{ section.settings.route_kicker | escape }}</p>
          <h2 id="MscLearnRoute-{{ section.id }}" class="msc-section-title">{{ section.settings.route_heading | escape }}</h2>
          <div class="msc-section-header__copy rte">{{ section.settings.route_copy }}</div>
          {%- assign route_link = section.settings.route_link -%}
          {%- if route_link == blank -%}
            {%- assign route_page = pages['how-a-bitcoin-transaction-moves'] -%}
            {%- if route_page -%}{%- assign route_link = route_page.url -%}{%- endif -%}
          {%- endif -%}
          {%- if route_link != blank -%}
            <a class="msc-button msc-learn-route__cta" href="{{ route_link }}">{{ section.settings.route_action_label | escape }}</a>
          {%- endif -%}
        </div>
        <ol class="msc-learn-route__steps" aria-label="Bitcoin transaction learning route preview">
          <li><span>1</span><strong>Create</strong></li><li><span>2</span><strong>Sign</strong></li><li><span>3</span><strong>Broadcast</strong></li><li><span>4</span><strong>Mempool</strong></li><li><span>5</span><strong>Confirm</strong></li>
        </ol>
      </article>
    </div>

    <div class="msc-block msc-learn-glossary-block" aria-labelledby="MscLearnGlossary-{{ section.id }}">
      {% render 'msc-section-header', kicker: section.settings.glossary_kicker, heading: section.settings.glossary_heading, copy: section.settings.glossary_copy, heading_id: 'MscLearnGlossary-' | append: section.id %}
      <div class="msc-glossary-grid">
        {%- for block in section.blocks -%}{%- if block.type == 'glossary_term' -%}{% render 'msc-glossary-item', term: block.settings.term, definition: block.settings.definition, link: block.settings.link, planned_handle: block.settings.planned_handle %}{%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MSC Learn",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"text","id":"signal_phrase_1","label":"Signal phrase 1","default":"WATCHING THE MEMPOOL"},
    {"type":"text","id":"signal_phrase_2","label":"Signal phrase 2","default":"READING THE NETWORK"},
    {"type":"text","id":"signal_phrase_3","label":"Signal phrase 3","default":"FOLLOWING THE SIGNAL"},
    {"type":"text","id":"heading","label":"Heading","default":"LEARN HOW BITCOIN MOVES."},
    {"type":"richtext","id":"supporting_copy","label":"Supporting copy","default":"<p>Start at the surface or go deeper. Follow clear learning paths through Bitcoin fundamentals, the network, protocols, development, and the wider ecosystem.</p>"},
    {"type":"text","id":"search_label","label":"Search accessible label","default":"Search the Bitcoin field guide"},
    {"type":"text","id":"search_placeholder","label":"Search placeholder","default":"Search wallets, mining, mempool, nodes, protocols..."},
    {"type":"text","id":"search_button","label":"Search button","default":"Search"},
    {"type":"text","id":"search_types","label":"Shopify search types","default":"article,page,product"},
    {"type":"text","id":"chart_label","label":"Chart label","default":"Four levels"},
    {"type":"text","id":"paths_kicker","label":"Paths kicker","default":"Choose Your Path"},
    {"type":"text","id":"paths_heading","label":"Paths heading","default":"Start with the route that matches your depth."},
    {"type":"richtext","id":"paths_copy","label":"Paths copy","default":"<p>Choose a starting point, then follow the related subjects in the knowledge index below.</p>"},
    {"type":"text","id":"index_kicker","label":"Index kicker","default":"Knowledge Index"},
    {"type":"text","id":"index_heading","label":"Index heading","default":"A structured archive for the Bitcoin ocean."},
    {"type":"richtext","id":"index_copy","label":"Index copy","default":"<p>Open a section, scan the markers, and choose where to continue deeper.</p>"},
    {"type":"checkbox","id":"open_first_group","label":"Open first topic group by default","default":true},
    {"type":"text","id":"route_kicker","label":"Route kicker","default":"Featured Learning Route"},
    {"type":"text","id":"route_heading","label":"Route heading","default":"START HERE: HOW A BITCOIN TRANSACTION MOVES"},
    {"type":"richtext","id":"route_copy","label":"Route copy","default":"<p>Follow the path from wallet creation and signing through the mempool, miner selection, block inclusion, and confirmation.</p>"},
    {"type":"url","id":"route_link","label":"Featured route link"},
    {"type":"text","id":"route_action_label","label":"Featured route action label","default":"Start the guide"},
    {"type":"text","id":"glossary_kicker","label":"Glossary kicker","default":"Glossary Preview"},
    {"type":"text","id":"glossary_heading","label":"Glossary heading","default":"Terms for reading the chart."},
    {"type":"richtext","id":"glossary_copy","label":"Glossary copy","default":"<p>Compact definitions for the language that appears throughout Bitcoin guides.</p>"}
  ],
  "blocks": [
    {"type":"learning_path","name":"Learning path","settings":[{"type":"text","id":"title","label":"Title","default":"Start With Bitcoin"},{"type":"textarea","id":"description","label":"Description","default":"Begin with the core concepts before moving into wallets, keys, and transactions."},{"type":"text","id":"marker","label":"Route marker","default":"Surface route"},{"type":"url","id":"link","label":"Optional link"},{"type":"text","id":"planned_handle","label":"Planned page handle"},{"type":"checkbox","id":"recommended","label":"Recommended starting route","default":false},{"type":"text","id":"recommended_label","label":"Recommended label","default":"Recommended start"},{"type":"text","id":"action_label","label":"Action label","default":"Enter route"}]},
    {"type":"topic_group","name":"Topic group","settings":[{"type":"text","id":"title","label":"Title","default":"Bitcoin Basics"},{"type":"text","id":"guide_note","label":"Guide note","default":"Begin with the core concepts."},{"type":"textarea","id":"subcategories","label":"Subcategories","default":"Foundations\nUsing Bitcoin\nSecurity\nEssentials"},{"type":"textarea","id":"topics","label":"Topics, one comma-separated row per subcategory","default":"What is Bitcoin?, Why Bitcoin?, Bitcoin History, Satoshi Nakamoto\nWallets, Self-Custody, Sending & Receiving, Transactions & Fees\nSeed Phrases, Public & Private Keys, Bitcoin Security, Bitcoin Privacy\nUTXOs, Confirmations, Halving, Best Practices"},{"type":"url","id":"guide_link","label":"Full guide link"},{"type":"text","id":"planned_handle","label":"Planned category handle"},{"type":"text","id":"guide_action_label","label":"Full guide action label","default":"Explore the full guide"}]},
    {"type":"glossary_term","name":"Glossary term","settings":[{"type":"text","id":"term","label":"Term","default":"Mempool"},{"type":"textarea","id":"definition","label":"Definition","default":"The waiting area where valid unconfirmed Bitcoin transactions are held by nodes before they are included in blocks."},{"type":"url","id":"link","label":"Optional link"},{"type":"text","id":"planned_handle","label":"Planned canonical page handle"}]}
  ],
  "presets": [{"name":"MSC Learn"}]
}
{% endschema %}