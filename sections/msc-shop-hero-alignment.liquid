<style>
  /* Shop intro alignment — mirrors the approved Learn / Explore / Tools page-intro system
   * without changing the Supply Locker commerce implementation.
   */

  .msc-shop-supply .msc-shop-supply__shell {
    width: min(1180px, calc(100% - 32px));
  }

  .msc-shop-supply .msc-shop-supply__intro > div:first-child {
    display: contents;
  }

  .msc-shop-supply .msc-shop-supply__actions {
    display: none !important;
  }

  .msc-shop-supply .msc-shop-supply__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    width: fit-content;
    padding: .45rem .75rem;
    border: 1px solid var(--msc-line, rgba(212, 190, 153, .28));
    border-radius: 999px;
    color: var(--msc-sand, #d4be99);
    background: rgba(255,255,255,.05);
    backdrop-filter: blur(10px);
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .msc-shop-supply .msc-shop-supply__eyebrow::before {
    content: "";
    width: .55rem;
    height: .55rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--msc-sand, #d4be99);
    box-shadow: 0 0 18px rgba(212,190,153,.85);
  }

  .msc-shop-supply .msc-shop-supply__title {
    color: var(--msc-sand, #d4be99) !important;
    line-height: .9 !important;
    letter-spacing: -.06em !important;
    text-wrap: wrap;
  }

  .msc-shop-supply .msc-shop-supply__copy {
    color: rgba(251,248,239,.82) !important;
    font-size: clamp(1.65rem, 2vw, 2.25rem) !important;
    line-height: 1.45 !important;
  }

  @media screen and (min-width: 761px) {
    .msc-shop-supply .msc-shop-supply__shell {
      padding-top: 3.5rem !important;
    }

    .msc-shop-supply .msc-shop-supply__intro {
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr);
      grid-template-areas:
        "kicker kicker"
        "title copy";
      column-gap: clamp(3.2rem, 4vw, 4.8rem);
      row-gap: .7rem;
      align-items: start;
      margin-bottom: clamp(2rem, 2.5vw, 2.6rem) !important;
    }

    .msc-shop-supply .msc-shop-supply__eyebrow {
      grid-area: kicker;
      justify-self: start;
      margin: 0 !important;
    }

    .msc-shop-supply .msc-shop-supply__title {
      grid-area: title;
      align-self: start;
      max-width: none !important;
      margin: 0 !important;
      font-size: clamp(4rem, 4.8vw, 5rem) !important;
    }

    .msc-shop-supply .msc-shop-supply__copy {
      grid-area: copy;
      align-self: center;
      width: 100%;
      max-width: none !important;
      margin: 0 !important;
    }
  }

  @media screen and (min-width: 991px) {
    .msc-shop-supply .msc-shop-supply__shell {
      padding-top: 5.5rem !important;
    }

    .msc-shop-supply .msc-shop-supply__title {
      font-size: clamp(4.5rem, 4.35vw, 5.2rem) !important;
    }
  }

  @media screen and (min-width: 1180px) {
    .msc-shop-supply .msc-shop-supply__title {
      font-size: 5.2rem !important;
    }
  }

  @media screen and (max-width: 760px) {
    .msc-shop-supply .msc-shop-supply__shell {
      width: min(1180px, calc(100% - 20px));
    }

    .msc-shop-supply .msc-shop-supply__intro {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        "kicker"
        "title"
        "copy";
      gap: 1.15rem;
      align-items: start;
      margin-bottom: 2.2rem !important;
    }

    .msc-shop-supply .msc-shop-supply__eyebrow {
      grid-area: kicker;
      margin: 0 !important;
    }

    .msc-shop-supply .msc-shop-supply__title {
      grid-area: title;
      max-width: none !important;
      margin: 0 !important;
    }

    .msc-shop-supply .msc-shop-supply__copy {
      grid-area: copy;
      width: 100%;
      max-width: none !important;
      margin: 0 !important;
    }
  }
</style>

{% schema %}
