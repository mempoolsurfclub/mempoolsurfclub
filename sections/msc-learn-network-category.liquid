{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-hub-progress.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-network-hub.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-network-companion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'msc-learn-hub-progress.js' | asset_url }}" defer="defer"></script>

{% render 'msc-learn-network-hub-runtime' %}

<template data-msc-learn-progress-template="MSC-HUB-NETWORK">
  <aside
    class="msc-learn-progress"
    data-msc-learn-progress
    data-hub-id="MSC-HUB-NETWORK"
    data-total-guides="16"
    data-account-state="{% if customer %}authenticated{% else %}guest{% endif %}"
    aria-label="The Bitcoin Network learning progress"
  >
    <div class="msc-learn-progress__topline">
      <p class="msc-learn-progress__eyebrow">Learning position</p>
      <p class="msc-learn-progress__position" data-msc-progress-position>Position 001</p>
    </div>

    <div class="msc-learn-progress__readout" aria-hidden="true">
      <strong data-msc-progress-count>00</strong>
      <span>/ 16</span>
    </div>

    <p class="msc-learn-progress__summary">
      <span data-msc-progress-completed>0 complete</span>
      <span class="msc-learn-progress__summary-separator">·</span>
      <span data-msc-progress-remaining>16 remaining</span>
    </p>

    <div class="msc-learn-progress__current">
      <p class="msc-learn-progress__current-label" data-msc-progress-current-label>Start here</p>
      <p class="msc-learn-progress__current-title">
        <span class="msc-learn-progress__current-number" data-msc-progress-current-number>001</span>
        <span aria-hidden="true">—</span>
        <span data-msc-progress-current-title>How Bitcoin Mining Works</span>
      </p>
    </div>

    <div
      class="msc-learn-progress__track"
      role="progressbar"
      aria-label="The Bitcoin Network guide completion"
      aria-valuemin="0"
      aria-valuemax="16"
      aria-valuenow="0"
      aria-valuetext="0 of 16 guides complete"
    >
      <div class="msc-learn-progress__groups">
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Mining</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node is-current" data-msc-progress-guide="MSC-GUIDE-017"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-018"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-019"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-020"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Nodes</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-021"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-022"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-023"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-024"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Network</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-025"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-026"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-027"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-028"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Consensus</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-029"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-030"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-031"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-032"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="msc-learn-progress__footer" aria-hidden="true">
      <span>4 sections</span>
      <span>16 guides</span>
      <span data-msc-progress-percent>0% complete</span>
    </div>
  </aside>
</template>

