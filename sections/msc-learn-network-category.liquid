{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-hub-progress.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-network-hub.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-network-companion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'msc-learn-hub-progress.js' | asset_url }}" defer="defer"></script>

{% render 'msc-learn-network-hub-runtime' %}

<template data-msc-learn-progress-template="MSC-HUB-NETWORK">
  <aside
    class="msc-learn-progress"
    data-msc-learn-progress
    data-hub-id="MSC-HUB-NETWORK"
    data-total-guides="16"
    data-account-state="{% if customer %}authenticated{% else %}guest{% endif %}"
    aria-label="The Bitcoin Network learning progress"
  >
    <div class="msc-learn-progress__topline">
      <p class="msc-learn-progress__eyebrow">Learning position</p>
      <p class="msc-learn-progress__position" data-msc-progress-position>Position 001</p>
    </div>

    <div class="msc-learn-progress__readout" aria-hidden="true">
      <strong data-msc-progress-count>00</strong>
      <span>/ 16</span>
    </div>

    <p class="msc-learn-progress__summary">
      <span data-msc-progress-completed>0 complete</span>
      <span class="msc-learn-progress__summary-separator">·</span>
      <span data-msc-progress-remaining>16 remaining</span>
    </p>

    <div class="msc-learn-progress__current">
      <p class="msc-learn-progress__current-label" data-msc-progress-current-label>Start here</p>
      <p class="msc-learn-progress__current-title">
        <span class="msc-learn-progress__current-number" data-msc-progress-current-number>001</span>
        <span aria-hidden="true">—</span>
        <span data-msc-progress-current-title>How Bitcoin Mining Works</span>
      </p>
    </div>

    <div
      class="msc-learn-progress__track"
      role="progressbar"
      aria-label="The Bitcoin Network guide completion"
      aria-valuemin="0"
      aria-valuemax="16"
      aria-valuenow="0"
      aria-valuetext="0 of 16 guides complete"
    >
      <div class="msc-learn-progress__groups">
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Mining</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node is-current" data-msc-progress-guide="MSC-GUIDE-017"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-018"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-019"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-020"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Nodes</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-021"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-022"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-023"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-024"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Network</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-025"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-026"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-027"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-028"></span>
          </div>
        </div>
        <div class="msc-learn-progress__group">
          <span class="msc-learn-progress__group-label">Consensus</span>
          <div class="msc-learn-progress__nodes" aria-hidden="true">
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-029"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-030"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-031"></span>
            <span class="msc-learn-progress__node" data-msc-progress-guide="MSC-GUIDE-032"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="msc-learn-progress__footer" aria-hidden="true">
      <span>4 sections</span>
      <span>16 guides</span>
      <span data-msc-progress-percent>0% complete</span>
    </div>
  </aside>
</template>

<template data-msc-network-mining-companion>
  <aside class="msc-network-mining-companion" aria-label="Animated Bitcoin mining competition">
    <svg class="msc-network-mining-race" viewBox="0 0 560 280" role="img" aria-labelledby="msc-network-mining-title msc-network-mining-desc">
      <title id="msc-network-mining-title">Miners competing for a Bitcoin block</title>
      <desc id="msc-network-mining-desc">Four identical miners compete for one block. Three fade back, one miner remains highlighted and moves toward the block, and the block glows when it is found.</desc>

      <defs>
        <g id="msc-network-miner-icon">
          <rect x="0" y="0" width="58" height="48" rx="7" />
          <circle cx="18" cy="24" r="9" />
          <circle cx="40" cy="24" r="9" />
          <circle cx="18" cy="24" r="2.2" class="msc-network-mining-race__solid" />
          <circle cx="40" cy="24" r="2.2" class="msc-network-mining-race__solid" />
          <path d="M8 9H50M8 39H50" />
        </g>
      </defs>

      <g class="msc-network-mining-race__sequence" aria-hidden="true">
        <g class="msc-network-mining-race__miner msc-network-mining-race__miner--rest" transform="translate(66 116)">
          <use href="#msc-network-miner-icon" />
        </g>
        <g class="msc-network-mining-race__miner msc-network-mining-race__miner--rest" transform="translate(136 116)">
          <use href="#msc-network-miner-icon" />
        </g>
        <g class="msc-network-mining-race__miner msc-network-mining-race__miner--rest" transform="translate(206 116)">
          <use href="#msc-network-miner-icon" />
        </g>
        <g class="msc-network-mining-race__miner msc-network-mining-race__miner--winner" transform="translate(276 116)">
          <use href="#msc-network-miner-icon" />
        </g>

        <path class="msc-network-mining-race__connection" d="M376 140H430" />

        <g class="msc-network-mining-race__block">
          <rect class="msc-network-mining-race__block-halo" x="420" y="96" width="94" height="88" rx="14" />
          <rect x="430" y="106" width="74" height="68" rx="8" />
          <rect x="442" y="118" width="50" height="44" rx="5" />
          <path d="M452 130H482M452 140H476M452 150H484" />
        </g>
      </g>
    </svg>
  </aside>
</template>

<template data-msc-network-retarget-companion>
  <aside class="msc-network-retarget-companion" aria-label="Bitcoin difficulty retarget instrument">
    <p class="msc-network-retarget-companion__eyebrow">Retarget instrument</p>
    <h4 class="msc-network-retarget-companion__title">2,016-block control window</h4>

    <div class="msc-network-retarget-instrument">
      <div class="msc-network-retarget-instrument__window">
        <span>Period start</span>
        <strong>2,016 blocks</strong>
        <span>Retarget boundary</span>
      </div>

      <div class="msc-network-retarget-gauge" aria-label="Faster blocks lower the target and raise difficulty; slower blocks raise the target and lower difficulty">
        <span class="msc-network-retarget-gauge__label">Faster blocks</span>
        <div class="msc-network-retarget-gauge__track" aria-hidden="true">
          <span class="msc-network-retarget-gauge__marker"></span>
        </div>
        <span class="msc-network-retarget-gauge__label">Slower blocks</span>
      </div>

      <div class="msc-network-retarget-effects">
        <div class="msc-network-retarget-effect">
          <span>Faster period</span>
          <strong>Target ↓</strong>
          <span>Difficulty ↑</span>
        </div>
        <div class="msc-network-retarget-effect">
          <span>Reference pace</span>
          <strong>600 sec</strong>
          <span>Average spacing</span>
        </div>
        <div class="msc-network-retarget-effect">
          <span>Slower period</span>
          <strong>Target ↑</strong>
          <span>Difficulty ↓</span>
        </div>
      </div>

      <div class="msc-network-retarget-metrics" aria-label="Difficulty adjustment parameters">
        <span>2,016-block interval</span>
        <span>1,209,600-sec target period</span>
        <span>0.25×–4× timespan clamp</span>
      </div>
    </div>
  </aside>
</template>

<script>
  (() => {
    const script = document.currentScript;
    const scope = script.closest('.shopify-section') || document;
    const card = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-017"]');
    const template = scope.querySelector('template[data-msc-network-mining-companion]');

    if (card && template && !card.querySelector('.msc-network-mining-companion')) {
      card.appendChild(template.content.cloneNode(true));
    }
  })();
</script>

<script>
  (() => {
    const script = document.currentScript;
    const scope = script.closest('.shopify-section') || document;
    const card = scope.querySelector('.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-020"]');
    const template = scope.querySelector('template[data-msc-network-retarget-companion]');

    if (card && template && !card.querySelector('.msc-network-retarget-companion')) {
      card.appendChild(template.content.cloneNode(true));
    }
  })();
</script>

{% schema %}
{
  "name": "MSC Learn network hub",
  "settings": []
}
{% endschema %}