<style>
  body [data-msc-ecosystem-radar] .msc-tools-axis-overlay {
    display: none;
  }

  body [data-msc-ecosystem-radar] .msc-tools-launch {
    justify-content: center !important;
    align-items: center !important;
    padding-inline: 1rem !important;
    text-align: center !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-launch > span:first-child {
    display: block !important;
    width: 100% !important;
    text-align: center !important;
    text-transform: uppercase;
  }

  body [data-msc-ecosystem-radar] .msc-tools-launch__arrow {
    display: none !important;
  }

  body [data-msc-ecosystem-radar] .msc-tools-launch--inscriber {
    border-color: rgba(212,190,153,.18) !important;
    color: var(--msc-paper-soft) !important;
    background: rgba(255,255,255,.035) !important;
  }

  @media screen and (min-width: 991px) {
    body [data-msc-ecosystem-radar] .msc-tools-price {
      min-height: 35.5rem !important;
      display: block !important;
      position: relative !important;
      justify-content: initial !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price::before {
      display: none !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__heading {
      position: absolute !important;
      inset: var(--msc-tools-inset) var(--msc-tools-inset) auto !important;
      z-index: 4 !important;
      display: block !important;
      pointer-events: none;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__heading > div:first-child {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      transform: none !important;
      text-align: left !important;
      white-space: nowrap;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__pair {
      position: absolute !important;
      top: 0 !important;
      left: 50% !important;
      width: max-content !important;
      transform: translateX(-50%) !important;
      display: flex !important;
      align-items: baseline !important;
      gap: .4rem !important;
      text-align: center !important;
      white-space: nowrap;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__pair .msc-tools-price__label::after {
      content: ":";
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__pair .msc-tools-price__meta-value {
      display: inline !important;
      margin: 0 !important;
      color: var(--msc-paper-soft);
      font-size: .94rem;
      line-height: 1;
      letter-spacing: .1em;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__display {
      position: absolute !important;
      z-index: 4 !important;
      top: calc(var(--msc-tools-inset) + 1.8rem) !important;
      left: var(--msc-tools-inset) !important;
      margin: 0 !important;
      text-align: left !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__value {
      font-size: clamp(1.45rem, 1.6vw, 2rem) !important;
      line-height: 1 !important;
      letter-spacing: -.025em !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__change {
      display: block !important;
      min-height: 0 !important;
      margin-top: .3rem !important;
      font-size: 1.05rem !important;
      line-height: 1 !important;
      letter-spacing: 0 !important;
      text-align: left !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-trace {
      position: absolute !important;
      z-index: 2 !important;
      top: 8.35rem !important;
      right: auto !important;
      left: var(--msc-tools-inset) !important;
      bottom: auto !important;
      flex: none !important;
      width: calc(100% - (2 * var(--msc-tools-inset))) !important;
      height: calc(100% - 10rem) !important;
      min-height: 0 !important;
      max-height: none !important;
      margin: 0 !important;
      overflow: visible !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-axis-overlay {
      display: block !important;
      position: absolute !important;
      z-index: 3 !important;
      top: 8.35rem !important;
      left: var(--msc-tools-inset) !important;
      width: calc(100% - (2 * var(--msc-tools-inset))) !important;
      height: calc(100% - 10rem) !important;
      pointer-events: none !important;
      overflow: visible !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-axis-overlay__label {
      position: absolute;
      margin: 0;
      font-family: inherit;
      font-style: normal;
      font-stretch: normal;
      line-height: 1;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
      text-shadow: 0 1px 1px rgba(3, 18, 22, .72);
    }

    body [data-msc-ecosystem-radar] .msc-tools-axis-overlay__label--price {
      color: rgba(251, 248, 239, .78);
      font-size: .94rem;
      font-weight: 650;
      letter-spacing: .01em;
      transform: translate(-100%, -50%);
    }

    body [data-msc-ecosystem-radar] .msc-tools-axis-overlay__label--time {
      color: rgba(212, 190, 153, .7);
      font-size: .88rem;
      font-weight: 600;
      letter-spacing: .02em;
      transform: translate(-50%, -50%);
    }

    body [data-msc-ecosystem-radar] .msc-tools-axis-overlay__label--time[data-axis-anchor="start"] {
      transform: translate(0, -50%);
    }

    body [data-msc-ecosystem-radar] .msc-tools-axis-overlay__label--time[data-axis-anchor="end"] {
      transform: translate(-100%, -50%);
    }

    body [data-msc-ecosystem-radar] .msc-tools-price[data-axis-html-labels="true"] .msc-tools-trace__axis-label {
      opacity: 0 !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-price__meta {
      display: none !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-trace__axis-grid {
      stroke: rgba(212, 190, 153, .16) !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-trace__axis-grid--time {
      stroke: rgba(212, 190, 153, .1) !important;
    }

    body [data-msc-ecosystem-radar] .msc-tools-trace__axis-domain {
      stroke: rgba(212, 190, 153, .26) !important;
    }
  }
</style>

<script>
(() => {
  'use strict';

  const ROOT = '[data-msc-ecosystem-radar]';

  function removeLegacyMeta(root) {
    if (!root) return;
    const meta = root.querySelector('.msc-tools-price__meta');
    if (meta) meta.remove();
  }

  function renderAxisOverlay(root, svg) {
    const pricePanel = root && root.querySelector('.msc-tools-price');
    if (!pricePanel || !svg || !svg.viewBox || !svg.viewBox.baseVal) return;

    const viewBox = svg.viewBox.baseVal;
    const width = viewBox.width || 720;
    const height = viewBox.height || 150;
    if (!width || !height) return;

    let overlay = pricePanel.querySelector('[data-msc-tools-axis-overlay]');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.className = 'msc-tools-axis-overlay';
      overlay.setAttribute('data-msc-tools-axis-overlay', '');
      overlay.setAttribute('aria-hidden', 'true');
      pricePanel.appendChild(overlay);
    }

    overlay.replaceChildren();

    svg.querySelectorAll('.msc-tools-trace__axis-label--price').forEach((label) => {
      const x = Number(label.getAttribute('x'));
      const y = Number(label.getAttribute('y'));
      if (!Number.isFinite(x) || !Number.isFinite(y)) return;

      const item = document.createElement('span');
      item.className = 'msc-tools-axis-overlay__label msc-tools-axis-overlay__label--price';
      item.textContent = label.textContent || '';
      item.style.left = `${(x / width) * 100}%`;
      item.style.top = `${(y / height) * 100}%`;
      overlay.appendChild(item);
    });

    svg.querySelectorAll('.msc-tools-trace__axis-label--time').forEach((label) => {
      const x = Number(label.getAttribute('x'));
      const y = Number(label.getAttribute('y'));
      if (!Number.isFinite(x) || !Number.isFinite(y)) return;

      const item = document.createElement('span');
      item.className = 'msc-tools-axis-overlay__label msc-tools-axis-overlay__label--time';
      item.textContent = label.textContent || '';
      item.dataset.axisAnchor = label.getAttribute('text-anchor') || 'middle';
      item.style.left = `${(x / width) * 100}%`;
      item.style.top = `${(y / height) * 100}%`;
      overlay.appendChild(item);
    });

    pricePanel.dataset.axisHtmlLabels = 'true';
  }

  function refineAxisLabels(root) {
    const svg = root && root.querySelector('.msc-tools-trace');
    if (!svg) return;

    svg.querySelectorAll('.msc-tools-trace__axis-label--price').forEach((label) => {
      label.setAttribute('x', '698');
      label.setAttribute('text-anchor', 'end');
    });

    svg.querySelectorAll('.msc-tools-trace__axis-label--time').forEach((label) => {
      label.setAttribute('y', '143');
    });

    renderAxisOverlay(root, svg);
  }

  function install(root) {
    if (!root) return;
    removeLegacyMeta(root);
    refineAxisLabels(root);

    const svg = root.querySelector('.msc-tools-trace');
    if (!svg || svg.dataset.axisRefinementInitialized === 'true') return;
    svg.dataset.axisRefinementInitialized = 'true';

    const observer = new MutationObserver(() => refineAxisLabels(root));
    observer.observe(svg, { childList: true, subtree: true });
  }

  function init(scope = document) {
    if (scope.matches && scope.matches(ROOT)) install(scope);
    if (scope.querySelectorAll) scope.querySelectorAll(ROOT).forEach(install);
  }

  init(document);
  document.addEventListener('shopify:section:load', (event) => init(event.target));
})();
</script>

{% schema %}
{
  "name": "Tools market layout",
  "settings": []
}
{% endschema %}
