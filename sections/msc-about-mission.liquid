{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-about-mission.css' | asset_url | stylesheet_tag }}
{{ 'msc-about-contribute.css' | asset_url | stylesheet_tag }}

<section class="msc-about-mission" id="MscAboutMission-{{ section.id }}">
  <div class="msc-container">
    <header class="msc-about-mission__intro">
      <p class="msc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="msc-title msc-about-mission__title">{{ section.settings.heading | escape }}</h1>
      <div class="msc-subtitle msc-about-mission__copy rte">{{ section.settings.hero_copy }}</div>
    </header>

    <div class="msc-mission-current" aria-label="Mempool Surf Club mission story">
      <div class="msc-mission-current__topbar">
        <div class="msc-mission-current__identity"><strong>MSC FIELD LOG</strong><span>MISSION CURRENT</span></div>
        <div class="msc-mission-current__code">MSC / STORY-01</div>
      </div>

      <div class="msc-mission-current__field">
        <div class="msc-mission-current__statement">
          <div class="msc-mission-current__bitcoin" aria-hidden="true">
            <svg viewBox="0 0 450 913" focusable="false">
              <path d="M103 913V815H0V101H103V0H170V101H172Q207 101 236 104V0H303V115Q367 131 399.5 171Q432 211 432 282Q432 343 410 385Q388 427 347 436V441Q376 448 399 466Q422 484 436 518Q450 552 450 608Q450 684 411 734.5Q372 785 303 804V913H236V815Q227 815 217 815H170V913ZM189 384Q239 384 258 363Q277 342 277 302Q277 261 254 243Q231 225 181 225H151V384ZM151 504V690H200Q252 690 272.5 663.5Q293 637 293 593Q293 553 272 528.5Q251 504 195 504Z" />
            </svg>
          </div>
          <div>
            <span>WHY WE BUILD</span>
            <h2>WE WANT MORE PEOPLE TO UNDERSTAND WHAT BITCOIN IS DOING.</h2>
          </div>
          <p>Not just price. The network, the builders, the ideas, the tools, and the culture moving around it.</p>
        </div>

        <div class="msc-mission-current__route" aria-hidden="true">
          <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
            <path class="msc-mission-current__route-ghost" d="M0 66 C120 66 126 28 240 34 S386 92 480 70 S596 20 720 42 S850 98 960 64 S1080 36 1200 54" />
            <path class="msc-mission-current__route-line" d="M0 66 C120 66 126 28 240 34 S386 92 480 70 S596 20 720 42 S850 98 960 64 S1080 36 1200 54" />
          </svg>
        </div>

        <div class="msc-mission-current__steps">
          <article class="msc-mission-step">
            <span>01 / WATCH</span>
            <h3>FOLLOW THE SIGNAL</h3>
            <p>We watch blocks, fees, infrastructure, builders, protocols, and the movements shaping Bitcoin.</p>
          </article>
          <article class="msc-mission-step">
            <span>02 / TEACH</span>
            <h3>MAKE BITCOIN UNDERSTANDABLE</h3>
            <p>We turn complexity into clear learning guides so more people can understand what is happening and why.</p>
          </article>
          <article class="msc-mission-step">
            <span>03 / BUILD</span>
            <h3>CREATE USEFUL TOOLS</h3>
            <p>We build interfaces that make the network easier to inspect, navigate, and learn from.</p>
          </article>
          <article class="msc-mission-step">
            <span>04 / CARRY</span>
            <h3>BRING THE CULTURE OFFLINE</h3>
            <p>We make apparel and objects for people who want to wear, carry, and share their connection to Bitcoin.</p>
          </article>
          <article class="msc-mission-step">
            <span>05 / KEEP GOING</span>
            <h3>IMPROVE THE CLUBHOUSE</h3>
            <p>We keep researching, publishing, designing, experimenting, and improving the platform as Bitcoin evolves.</p>
          </article>
        </div>
      </div>

      <div class="msc-mission-current__footer" aria-label="Mempool Surf Club mission principles">
        <span><small>FOUNDATION</small><strong>BITCOIN FIRST</strong></span>
        <span><small>METHOD</small><strong>LEARN + BUILD</strong></span>
        <span><small>MODEL</small><strong>INDEPENDENT</strong></span>
        <span><small>STATUS</small><strong>ALWAYS LEARNING</strong></span>
      </div>
    </div>

    <section class="msc-contribute" aria-labelledby="MscContribute-{{ section.id }}" data-connected="false">
      <div class="msc-contribute__story">
        <p class="msc-section-kicker">{{ section.settings.contribution_kicker | escape }}</p>
        <h2 id="MscContribute-{{ section.id }}">{{ section.settings.contribution_heading | escape }}</h2>
        <div class="rte">{{ section.settings.contribution_copy }}</div>
        <div class="msc-contribute__impact" aria-label="What contributions help MSC build">
          <span>TOOLS</span><span>LEARNING GUIDES</span><span>HOSTING + RESEARCH</span><span>DESIGN + IMPROVEMENTS</span>
        </div>
      </div>

      <div class="msc-contribute__terminal">
        <div class="msc-contribute__topbar">
          <span>CONTRIBUTION TERMINAL</span>
          <strong class="msc-contribute__status-chip" data-msc-terminal-state>READY</strong>
        </div>

        <div class="msc-contribute__body">
          <div class="msc-contribute__wallet">
            <div class="msc-contribute__wallet-copy">
              <span>WALLET</span>
              <strong data-msc-wallet-state>NOT CONNECTED</strong>
            </div>
            <div class="msc-contribute__wallet-actions">
              <button class="msc-contribute__button" type="button" data-msc-wallet-connect>CONNECT WALLET</button>
              <button class="msc-contribute__button msc-contribute__button--quiet" type="button" data-msc-wallet-disconnect>DISCONNECT</button>
            </div>
          </div>

          <div class="msc-contribute__amount-panel">
            <span class="msc-contribute__amount-label">AMOUNT / SATS</span>
            <div class="msc-contribute__presets" aria-label="Contribution amount presets">
              <button class="msc-contribute__preset" type="button" data-msc-sats="1000">1K</button>
              <button class="msc-contribute__preset is-active" type="button" data-msc-sats="5000">5K</button>
              <button class="msc-contribute__preset" type="button" data-msc-sats="10000">10K</button>
              <button class="msc-contribute__preset" type="button" data-msc-sats="25000">25K</button>
            </div>
            <label class="msc-contribute__amount">
              <input type="number" min="1" step="1" inputmode="numeric" value="5000" aria-label="Contribution amount in satoshis" data-msc-amount>
              <span>SATS</span>
            </label>
          </div>

          <button class="msc-contribute__button msc-contribute__submit" type="button" data-msc-contribute disabled>CONTRIBUTE</button>
          <p class="msc-contribute__message" aria-live="polite" data-msc-contribution-message>
            {% if section.settings.contribution_address != blank %}Connect a wallet to contribute.{% else %}Wallet connection is ready. The MSC receiving destination must be configured before funds can be sent.{% endif %}
          </p>
          <p class="msc-contribute__footnote">Your wallet controls authorization. Funds move only when you initiate and approve a contribution.</p>
        </div>
      </div>
    </section>
  </div>
</section>

<script type="module">
  (() => {
    const root = document.getElementById('MscAboutMission-{{ section.id }}');
    if (!root || root.dataset.mscContributionReady === 'true') return;
    root.dataset.mscContributionReady = 'true';

    const panel = root.querySelector('.msc-contribute');
    const connectButton = root.querySelector('[data-msc-wallet-connect]');
    const disconnectButton = root.querySelector('[data-msc-wallet-disconnect]');
    const walletState = root.querySelector('[data-msc-wallet-state]');
    const terminalState = root.querySelector('[data-msc-terminal-state]');
    const amountInput = root.querySelector('[data-msc-amount]');
    const contributeButton = root.querySelector('[data-msc-contribute]');
    const message = root.querySelector('[data-msc-contribution-message]');
    const presets = Array.from(root.querySelectorAll('[data-msc-sats]'));
    const contributionAddress = {{ section.settings.contribution_address | strip | json }};

    let provider = null;
    let bitcoinConnect = null;
    let loading = false;

    const setMessage = (text, tone = '') => {
      message.textContent = text;
      message.dataset.tone = tone;
    };

    const validAmount = () => {
      const value = Number(amountInput.value);
      return Number.isSafeInteger(value) && value > 0 ? value : null;
    };

    const updateSubmit = () => {
      contributeButton.disabled = loading || !provider || !contributionAddress || !validAmount();
    };

    const connectorLabel = () => {
      try {
        const config = bitcoinConnect?.getConnectorConfig?.();
        return config?.connectorName ? String(config.connectorName).toUpperCase() : 'WALLET CONNECTED';
      } catch (_) {
        return 'WALLET CONNECTED';
      }
    };

    const setConnected = (nextProvider) => {
      provider = nextProvider || null;
      panel.dataset.connected = provider ? 'true' : 'false';
      walletState.textContent = provider ? connectorLabel() : 'NOT CONNECTED';
      terminalState.textContent = provider ? 'CONNECTED' : 'READY';
      if (provider) {
        setMessage(contributionAddress ? 'Choose an amount, then contribute.' : 'Wallet connected. The MSC receiving destination must be configured before funds can be sent.');
      } else {
        setMessage(contributionAddress ? 'Connect a wallet to contribute.' : 'Wallet connection is ready. The MSC receiving destination must be configured before funds can be sent.');
      }
      updateSubmit();
    };

    const resolveLightningInvoice = async (address, sats) => {
      const parts = String(address || '').trim().split('@');
      if (parts.length !== 2) throw new Error('MSC contribution destination is not a valid Lightning address.');

      const username = parts[0].toLowerCase();
      const domain = parts[1].toLowerCase();
      if (!/^[a-z0-9._+-]+$/.test(username) || !/^[a-z0-9.-]+\.[a-z]{2,}$/.test(domain)) {
        throw new Error('MSC contribution destination is not a valid Lightning address.');
      }

      const discoveryUrl = `https://${domain}/.well-known/lnurlp/${encodeURIComponent(username)}`;
      const discoveryResponse = await fetch(discoveryUrl, { headers: { Accept: 'application/json' } });
      if (!discoveryResponse.ok) throw new Error('Could not reach the MSC contribution destination.');

      const params = await discoveryResponse.json();
      if (params?.status === 'ERROR') throw new Error(params.reason || 'Contribution destination returned an error.');
      if (params?.tag !== 'payRequest' || !params?.callback) throw new Error('Contribution destination did not return a valid payment request.');

      const msats = sats * 1000;
      if (!Number.isSafeInteger(msats)) throw new Error('Contribution amount is too large.');
      if (Number.isFinite(params.minSendable) && msats < params.minSendable) {
        throw new Error(`Minimum contribution is ${Math.ceil(params.minSendable / 1000)} sats.`);
      }
      if (Number.isFinite(params.maxSendable) && msats > params.maxSendable) {
        throw new Error(`Maximum contribution is ${Math.floor(params.maxSendable / 1000)} sats.`);
      }

      const callback = new URL(params.callback);
      if (callback.protocol !== 'https:') throw new Error('Contribution destination returned an insecure callback.');
      callback.searchParams.set('amount', String(msats));

      const invoiceResponse = await fetch(callback.toString(), { headers: { Accept: 'application/json' } });
      if (!invoiceResponse.ok) throw new Error('Could not create the contribution invoice.');

      const invoice = await invoiceResponse.json();
      if (invoice?.status === 'ERROR') throw new Error(invoice.reason || 'Could not create the contribution invoice.');
      if (!invoice?.pr || typeof invoice.pr !== 'string') throw new Error('Contribution destination did not return a Lightning invoice.');
      return invoice.pr;
    };

    const initContribution = async () => {
      try {
        bitcoinConnect = await import('https://esm.sh/@getalby/bitcoin-connect@3.12.2');
        bitcoinConnect.init({
          appName: 'Mempool Surf Club',
          showBalance: false,
          persistConnection: true
        });

        bitcoinConnect.onConnected((nextProvider) => setConnected(nextProvider));
        bitcoinConnect.onDisconnected(() => setConnected(null));

        connectButton.addEventListener('click', async () => {
          try {
            terminalState.textContent = 'CONNECTING';
            setMessage('Choose a wallet to connect.');
            await bitcoinConnect.launchModal();
          } catch (error) {
            terminalState.textContent = provider ? 'CONNECTED' : 'READY';
            setMessage(error?.message || 'Wallet connection was not completed.', 'error');
          }
        });

        disconnectButton.addEventListener('click', async () => {
          try {
            await bitcoinConnect.disconnect();
          } finally {
            setConnected(null);
          }
        });

        presets.forEach((button) => {
          button.addEventListener('click', () => {
            amountInput.value = button.dataset.mscSats;
            presets.forEach((item) => item.classList.toggle('is-active', item === button));
            updateSubmit();
          });
        });

        amountInput.addEventListener('input', () => {
          presets.forEach((item) => item.classList.toggle('is-active', item.dataset.mscSats === amountInput.value));
          updateSubmit();
        });

        contributeButton.addEventListener('click', async () => {
          const sats = validAmount();
          if (!sats || !contributionAddress || loading) return;

          loading = true;
          updateSubmit();
          terminalState.textContent = 'PREPARING';
          setMessage(`Preparing ${sats.toLocaleString()} sat contribution…`);

          try {
            const activeProvider = provider || await bitcoinConnect.requestProvider();
            setConnected(activeProvider);
            const invoice = await resolveLightningInvoice(contributionAddress, sats);

            terminalState.textContent = 'AWAITING APPROVAL';
            setMessage('Approve the contribution in your wallet.');
            const result = await activeProvider.sendPayment(invoice);

            if (!result?.preimage) throw new Error('The wallet did not confirm the payment.');
            terminalState.textContent = 'SENT';
            setMessage(`Contribution sent — ${sats.toLocaleString()} sats. Thank you for helping MSC keep building.`, 'success');
          } catch (error) {
            terminalState.textContent = provider ? 'CONNECTED' : 'READY';
            setMessage(error?.message || 'Contribution was not completed.', 'error');
          } finally {
            loading = false;
            updateSubmit();
          }
        });

        setConnected(null);
      } catch (error) {
        connectButton.disabled = true;
        terminalState.textContent = 'UNAVAILABLE';
        setMessage('Wallet connection is temporarily unavailable. Please try again later.', 'error');
      }
    };

    initContribution();
  })();
</script>

{% schema %}
{
  "name": "MSC About Mission",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"ABOUT MEMPOOL SURF CLUB"},
    {"type":"text","id":"heading","label":"Hero heading","default":"BUILT TO READ THE WHOLE BITCOIN OCEAN."},
    {"type":"richtext","id":"hero_copy","label":"Hero copy","default":"<p>We built Mempool Surf Club because Bitcoin is too important to reduce to a price chart. We follow the network, turn complexity into learning guides, build useful tools, document the culture, and make things people are proud to wear and carry.</p>"},
    {"type":"text","id":"contribution_kicker","label":"Contribution kicker","default":"CONTRIBUTE TO MSC"},
    {"type":"text","id":"contribution_heading","label":"Contribution heading","default":"KEEP THE CLUBHOUSE MOVING."},
    {"type":"richtext","id":"contribution_copy","label":"Contribution copy","default":"<p>Contributions help fund hosting, research, new tools, learning guides, design, and the time it takes to keep MSC useful, independent, and improving.</p>"},
    {"type":"text","id":"contribution_address","label":"MSC receiving Lightning address","info":"Required before connected wallets can send contributions."}
  ],
  "presets": [{"name":"MSC About Mission"}]
}
{% endschema %}
