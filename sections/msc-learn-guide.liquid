{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'msc-learn-hub-progress.js' | asset_url }}" defer="defer"></script>
{%- assign pilot_registry_id = section.settings.registry_id | strip -%}
{%- case pilot_registry_id -%}
  {%- when 'MSC-GUIDE-001' -%}
    {% render 'msc-learn-guide-001-runtime' %}
    <style>
      .msc-learn-page[data-msc-registry-id="MSC-GUIDE-001"] .msc-learn-guide__category-link,
      .msc-learn-page[data-msc-registry-id="MSC-GUIDE-001"] a.msc-learn-prev-next__item {
        color: inherit;
        text-decoration: none;
      }
      .msc-learn-page[data-msc-registry-id="MSC-GUIDE-001"] .msc-learn-guide__category-link:hover,
      .msc-learn-page[data-msc-registry-id="MSC-GUIDE-001"] a.msc-learn-prev-next__item:hover strong {
        color: var(--msc-guide-sand);
      }
    </style>
    <script>
      (() => {
        const script = document.currentScript;
        const scope = script.closest('.shopify-section') || document;
        const page = scope.querySelector('.msc-learn-page[data-msc-registry-id="MSC-GUIDE-001"]');
        if (!page) return;

        page.removeAttribute('data-msc-preview-only');

        const categoryCrumb = page.querySelector('.msc-learn-breadcrumbs li:nth-child(2) span');
        if (categoryCrumb) {
          const link = document.createElement('a');
          link.href = '/pages/learn-bitcoin-basics';
          link.textContent = categoryCrumb.textContent;
          link.className = 'msc-learn-guide__category-link';
          categoryCrumb.replaceWith(link);
        }

        const categoryNav = page.querySelector('.msc-learn-prev-next__item:nth-child(2)');
        if (categoryNav && categoryNav.tagName !== 'A') {
          const link = document.createElement('a');
          link.href = '/pages/learn-bitcoin-basics';
          link.className = categoryNav.className;
          link.innerHTML = '<span>Category</span><strong>Bitcoin Basics</strong><small>Return to hub</small>';
          categoryNav.replaceWith(link);
        }
      })();
    </script>
  {%- else -%}
    <section class="msc-shell msc-learn-page" data-msc-preview-only="true">
      <div class="msc-container msc-learn-page__container">
        <header class="msc-learn-page__header">
          <p class="msc-section-kicker">Learn runtime preview</p>
          <h1>Guide preview unavailable</h1>
          <p>No structured runtime package is registered for {{ pilot_registry_id | escape }}.</p>
        </header>
      </div>
    </section>
{%- endcase -%}
{% schema %}
{
  "name": "MSC Learn guide",
  "settings": [
    {
      "type": "text",
      "id": "registry_id",
      "label": "Registry ID",
      "default": "MSC-GUIDE-001",
      "info": "Preview-only binding. Do not enter a handle or URL."
    }
  ]
}
{% endschema %}