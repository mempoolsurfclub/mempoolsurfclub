{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-hub-progress.css' | asset_url | stylesheet_tag }}
{{ 'msc-learn-guide-template.css' | asset_url | stylesheet_tag }}
<script src="{{ 'msc-learn-hub-progress.js' | asset_url }}" defer="defer"></script>

{%- assign pilot_registry_id = section.settings.registry_id | strip -%}
{%- case pilot_registry_id -%}
  {%- when 'MSC-GUIDE-001' -%}
    {% render 'msc-learn-guide-001-runtime' %}
    <template data-msc-guide-next-template="MSC-GUIDE-001">
      {% render 'msc-learn-guide-transition',
        current_registry_id: 'MSC-GUIDE-001',
        next_registry_id: 'MSC-GUIDE-002',
        next_number: '002',
        next_title: 'Why Does Bitcoin Matter?',
        next_description: 'Bitcoin matters because it combines open participation, independently verifiable rules, scarce digital units, and ownership through cryptographic keys.',
        category_label: 'Bitcoin Basics',
        completed_count: 1,
        total_count: 16,
        remaining_count: 15,
        next_active: false
      %}
    </template>
  {%- else -%}
    <section class="msc-shell msc-learn-page" data-msc-preview-only="true">
      <div class="msc-container msc-learn-page__container">
        <header class="msc-learn-page__header">
          <p class="msc-section-kicker">Learn runtime preview</p>
          <h1>Guide preview unavailable</h1>
          <p>No structured runtime package is registered for {{ pilot_registry_id | escape }}.</p>
        </header>
      </div>
    </section>
{%- endcase -%}

<script>
  (() => {
    const mountGuideTransitions = () => {
      document.querySelectorAll('.msc-learn-page[data-msc-registry-id^="MSC-GUIDE-"]').forEach((page) => {
        const registryId = page.getAttribute('data-msc-registry-id');
        const template = document.querySelector(`template[data-msc-guide-next-template="${registryId}"]`);
        const navigation = page.querySelector('.msc-learn-prev-next');
        const keyTerms = page.querySelector('.msc-learn-key-terms');
        if (!template || !navigation || !keyTerms || page.querySelector('[data-msc-guide-transition]')) return;
        navigation.setAttribute('aria-hidden', 'true');
        keyTerms.before(template.content.cloneNode(true));
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountGuideTransitions, { once: true });
    } else {
      mountGuideTransitions();
    }

    document.addEventListener('shopify:section:load', mountGuideTransitions);
  })();
</script>

{% schema %}
{
  "name": "MSC Learn guide",
  "settings": [
    {
      "type": "text",
      "id": "registry_id",
      "label": "Registry ID",
      "default": "MSC-GUIDE-001",
      "info": "Preview-only binding. Do not enter a handle or URL."
    }
  ]
}
{% endschema %}
