<style>
  .section--msc-home-background-normalize {
    display: contents;
  }

  /* Homepage canvas normalization.
   * Keep one continuous canvas, but render it with the exact established MSC
   * background treatment used elsewhere: shared gradient, 42px chart grid,
   * and the standard vertical grid fade. */
  body:has(.section--msc-home-background-normalize) #MainContent {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(212, 190, 153, 0.24), transparent 36rem),
      radial-gradient(circle at bottom right, rgba(78, 107, 113, 0.32), transparent 44rem),
      linear-gradient(135deg, #10282d 0%, #173c43 42%, #4e6b71 100%) !important;
    color: var(--msc-paper-soft);
  }

  body:has(.section--msc-home-background-normalize) #MainContent::before {
    content: "" !important;
    display: block !important;
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px) !important;
    background-size: 42px 42px !important;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,.85), transparent 92%);
    mask-image: linear-gradient(to bottom, rgba(0,0,0,.85), transparent 92%);
  }

  body:has(.section--msc-home-background-normalize) .msc-home-hero,
  body:has(.section--msc-home-background-normalize) .msc-home-samples {
    background: transparent !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-hero {
    border-bottom: 0 !important;
    padding-bottom: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-hero::before,
  body:has(.section--msc-home-background-normalize) .msc-home-samples::before {
    content: none !important;
    display: none !important;
  }

  /* Tighten the first homepage handoff so the Journal starts on the same
   * controlled spacing rhythm used inside its heading block. */
  body:has(.section--msc-home-background-normalize) .msc-home-sample--journal {
    padding-top: clamp(2.4rem, 3vw, 3.2rem) !important;
    padding-bottom: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-sample--journal .msc-home-sample__heading {
    margin-bottom: .9rem;
  }

  /* The Learn widget now carries the full section hierarchy on its own. Remove
   * the redundant outer Learn label/action row and reclaim that vertical space. */
  body:has(.section--msc-home-background-normalize) .msc-home-sample--learn {
    padding-top: clamp(1.4rem, 2vw, 2rem) !important;
    padding-bottom: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-sample--learn .msc-home-sample__heading {
    display: none !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-sample--shop {
    padding-top: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  /* Frame the homepage transaction path as its own balanced sub-panel. With
   * the CTA removed, let the five-stage route itself fill the panel cleanly. */
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path {
    display: grid;
    align-self: center;
    align-content: center;
    gap: 0;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: clamp(2.2rem, 2.8vw, 3rem) clamp(1.7rem, 2.3vw, 2.4rem);
    border: 1px solid rgba(212,190,153,.34);
    border-radius: 16px;
    background: rgba(7,31,36,.14);
  }

  /* Keep the nodes visually distinct from the rail so each transaction stage
   * reads as a separate technical checkpoint. */
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps span {
    position: relative;
    z-index: 2;
    width: 4.75rem;
    height: 4.75rem;
    border-color: rgba(212,190,153,.62);
    background:
      radial-gradient(circle at 50% 42%, rgba(212,190,153,.08), rgba(16,40,45,.97) 68%);
    box-shadow:
      inset 0 0 0 3px rgba(212,190,153,.035),
      0 0 0 3px rgba(7,31,36,.18);
    animation: mscHomeRouteNode 11s ease-in-out infinite;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps strong {
    color: rgba(251,248,239,.88);
    font-weight: 740;
    letter-spacing: .01em;
    animation: mscHomeRouteLabel 11s ease-in-out infinite;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(1) span,
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(1) strong {
    animation-delay: 0s;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(2) span,
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(2) strong {
    animation-delay: 2s;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(3) span,
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(3) strong {
    animation-delay: 4s;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(4) span,
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(4) strong {
    animation-delay: 6s;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(5) span,
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(5) strong {
    animation-delay: 8s;
  }

  @keyframes mscHomeRouteNode {
    0%, 20%, 100% {
      border-color: rgba(212,190,153,.62);
      box-shadow:
        inset 0 0 0 3px rgba(212,190,153,.035),
        0 0 0 3px rgba(7,31,36,.18);
      transform: scale(1);
    }
    7%, 13% {
      border-color: rgba(232,211,173,.96);
      box-shadow:
        inset 0 0 0 3px rgba(212,190,153,.08),
        0 0 0 3px rgba(212,190,153,.08),
        0 0 22px rgba(232,211,173,.28);
      transform: scale(1.035);
    }
  }

  @keyframes mscHomeRouteLabel {
    0%, 20%, 100% {
      color: rgba(251,248,239,.88);
      text-shadow: none;
      opacity: .9;
    }
    7%, 13% {
      color: var(--msc-paper-soft, #fbf8ef);
      text-shadow: 0 0 12px rgba(212,190,153,.18);
      opacity: 1;
    }
  }

  /* Remove the homepage route CTA from layout; the animated route is the sole
   * focus of the right-hand panel. */
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route__cta {
    display: none !important;
  }

  @media screen and (min-width: 641px) {
    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps {
      padding: .8rem 0 .35rem;
      align-items: start;
    }

    /* Lock every desktop checkpoint to identical node and label rows so the
     * five labels share one clean visual baseline. */
    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li {
      grid-template-rows: 4.75rem 1.35rem;
      align-items: start;
      gap: 1rem;
    }

    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps strong {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      width: 100%;
      min-height: 1.35rem;
      line-height: 1;
      text-align: center;
      white-space: nowrap;
    }

    /* Replace the single rail behind all five nodes with discrete segments
     * between checkpoints, so no line is visible through any circle. */
    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps::before {
      content: none !important;
      display: none !important;
    }

    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:not(:last-child)::before {
      content: "";
      position: absolute;
      z-index: 0;
      top: 2.375rem;
      left: calc(50% + 2.375rem);
      width: calc(100% + .85rem - 4.75rem);
      height: 2px;
      background: linear-gradient(90deg,
        rgba(212,190,153,.34),
        rgba(212,190,153,.64),
        rgba(212,190,153,.34));
      box-shadow: 0 0 8px rgba(212,190,153,.06);
      opacity: .58;
      animation: mscHomeRouteRail 11s ease-in-out infinite;
    }

    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(1)::before {
      animation-delay: 1s;
    }

    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(2)::before {
      animation-delay: 3s;
    }

    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(3)::before {
      animation-delay: 5s;
    }

    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:nth-child(4)::before {
      animation-delay: 7s;
    }

    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li::after {
      content: "";
      position: absolute;
      top: 4.75rem;
      left: 50%;
      width: 1px;
      height: .6rem;
      background: rgba(212,190,153,.36);
      transform: translateX(-50%);
    }
  }

  @keyframes mscHomeRouteRail {
    0%, 20%, 100% {
      opacity: .46;
      box-shadow: 0 0 8px rgba(212,190,153,.04);
    }
    7%, 13% {
      opacity: 1;
      box-shadow: 0 0 14px rgba(232,211,173,.22);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps span,
    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps strong,
    body:has(.section--msc-home-background-normalize) .msc-home-learn-route__path .msc-learn-route__steps li:not(:last-child)::before {
      animation: none !important;
    }
  }

  @media screen and (min-width: 901px) {
    body:has(.section--msc-home-background-normalize) .msc-home-sample--journal .msc-home-sample__destination {
      align-self: flex-end;
      margin-bottom: .2rem;
      line-height: 1.5;
    }
  }

  /* Keep the homepage samples visually continuous: no decorative chapter rules
   * between the Journal, Learn, and Shop previews. Widget borders remain intact. */
  body:has(.section--msc-home-background-normalize) .msc-home-sample + .msc-home-sample::before {
    content: none !important;
    display: none !important;
  }
</style>

{% schema %}
{
  "name": "MSC Home background",
  "tag": "section",
  "class": "section section--msc-home-background-normalize",
  "settings": []
}
{% endschema %}
