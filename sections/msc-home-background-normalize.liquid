<style>
  .section--msc-home-background-normalize {
    display: contents;
  }

  /* Homepage canvas normalization.
   * Keep one continuous canvas, but render it with the exact established MSC
   * background treatment used elsewhere: shared gradient, 42px chart grid,
   * and the standard vertical grid fade. */
  body:has(.section--msc-home-background-normalize) #MainContent {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(212, 190, 153, 0.24), transparent 36rem),
      radial-gradient(circle at bottom right, rgba(78, 107, 113, 0.32), transparent 44rem),
      linear-gradient(135deg, #10282d 0%, #173c43 42%, #4e6b71 100%) !important;
    color: var(--msc-paper-soft);
  }

  body:has(.section--msc-home-background-normalize) #MainContent::before {
    content: "" !important;
    display: block !important;
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px) !important;
    background-size: 42px 42px !important;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,.85), transparent 92%);
    mask-image: linear-gradient(to bottom, rgba(0,0,0,.85), transparent 92%);
  }

  body:has(.section--msc-home-background-normalize) .msc-home-hero,
  body:has(.section--msc-home-background-normalize) .msc-home-samples {
    background: transparent !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-hero {
    border-bottom: 0 !important;
    padding-bottom: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-hero::before,
  body:has(.section--msc-home-background-normalize) .msc-home-samples::before {
    content: none !important;
    display: none !important;
  }

  /* Tighten the first homepage handoff so the Journal starts on the same
   * controlled spacing rhythm used inside its heading block. */
  body:has(.section--msc-home-background-normalize) .msc-home-sample--journal {
    padding-top: clamp(2.4rem, 3vw, 3.2rem) !important;
    padding-bottom: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-sample--journal .msc-home-sample__heading {
    margin-bottom: .9rem;
  }

  /* Match the Learn handoff and internal heading rhythm to the tightened
   * Field Journal section directly above it, then carry that same spacing
   * into the Shop handoff below. */
  body:has(.section--msc-home-background-normalize) .msc-home-sample--learn {
    padding-top: clamp(2.4rem, 3vw, 3.2rem) !important;
    padding-bottom: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-sample--shop {
    padding-top: clamp(2.4rem, 3vw, 3.2rem) !important;
  }

  body:has(.section--msc-home-background-normalize) .msc-home-sample--learn .msc-home-sample__heading {
    margin-bottom: .9rem;
  }

  /* Keep the homepage-only route controls compact without changing the shared
   * Learn route component elsewhere on the site. */
  body:has(.section--msc-home-background-normalize) .msc-home-learn-route .msc-learn-route__cta {
    margin-top: .8rem;
  }

  @media screen and (min-width: 901px) {
    body:has(.section--msc-home-background-normalize) .msc-home-sample--journal .msc-home-sample__destination,
    body:has(.section--msc-home-background-normalize) .msc-home-sample--learn .msc-home-sample__destination {
      align-self: flex-end;
      margin-bottom: .2rem;
      line-height: 1.5;
    }

    /* Give the Learn heading the full available desktop span so it reads as
     * one continuous title line, matching the Field Journal title treatment. */
    body:has(.section--msc-home-background-normalize) .msc-home-sample--learn .msc-home-sample__heading-copy {
      flex: 1 1 auto;
      min-width: 0;
      max-width: none;
    }
  }

  @media screen and (min-width: 991px) {
    /* The shared route component centers the transaction steps in the full
     * widget height. On the homepage, raise that path so it aligns with the
     * visual center of the route title rather than the title+copy+CTA stack. */
    body:has(.section--msc-home-background-normalize) .msc-home-learn-route .msc-learn-route__steps {
      transform: translateY(-2rem);
    }
  }

  /* Keep the homepage samples visually continuous: no decorative chapter rules
   * between the Journal, Learn, and Shop previews. Widget borders remain intact. */
  body:has(.section--msc-home-background-normalize) .msc-home-sample + .msc-home-sample::before {
    content: none !important;
    display: none !important;
  }
</style>

{% schema %}
{
  "name": "MSC Home background",
  "tag": "section",
  "class": "section section--msc-home-background-normalize",
  "settings": []
}
{% endschema %}
