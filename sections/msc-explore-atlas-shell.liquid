                <circle class="msc-atlas-map__entity-dot" cx="982" cy="401" r="4.5" /><line class="msc-atlas-map__entity-line" x1="987" y1="401" x2="1003" y2="401" /><text class="msc-atlas-map__entity-label" x="1008" y="405">BITCOIN CORE</text>
              </g>
              <g class="msc-atlas-map__entity" data-atlas-entity="Lightning Network & BOLT Specifications" data-atlas-entity-region="network" role="button" tabindex="-1" aria-hidden="true" aria-pressed="false">
                <circle class="msc-atlas-map__entity-dot" cx="1032" cy="327" r="4.5" /><line class="msc-atlas-map__entity-line" x1="1037" y1="327" x2="1053" y2="327" /><text class="msc-atlas-map__entity-label" x="1058" y="331">LIGHTNING NETWORK</text>
              </g>
              <g class="msc-atlas-map__entity" data-atlas-entity="mempool.space" data-atlas-entity-region="network" role="button" tabindex="-1" aria-hidden="true" aria-pressed="false">
                <circle class="msc-atlas-map__entity-dot" cx="1074" cy="414" r="4.5" /><line class="msc-atlas-map__entity-line" x1="1079" y1="414" x2="1095" y2="414" /><text class="msc-atlas-map__entity-label" x="1100" y="418">MEMPOOL.SPACE</text>
              </g>
            </g>
          </g>

          <g class="msc-atlas-map__compass" transform="translate(1110 60)" aria-hidden="true">
            <circle cx="0" cy="0" r="28" />
            <path d="M0 -34 L0 34 M-34 0 L34 0 M0 -24 L7 0 L0 24 L-7 0 Z" />
            <circle cx="0" cy="0" r="4" />
          </g>
          <text class="msc-atlas-map__compass-text" x="1105" y="19" aria-hidden="true">N</text>
        </svg>

        <aside class="msc-atlas-inspect" data-atlas-inspect hidden aria-live="polite">
          <div class="msc-atlas-inspect__top">
            <div>
              <span class="msc-atlas-inspect__kicker">ATLAS / INSPECT</span>
              <h2 class="msc-atlas-inspect__title" data-atlas-inspect-title>CHARTED ENTITY</h2>
            </div>
            <button class="msc-atlas-inspect__close" type="button" data-atlas-inspect-close aria-label="Close entity inspection">×</button>
          </div>
          <span class="msc-atlas-inspect__meta" data-atlas-inspect-meta>PROFILE ROUTE PENDING</span>
        </aside>
      </div>

      <nav class="msc-atlas-window__nav" aria-label="Explore Atlas regions">
        {%- for block in section.blocks -%}
          {%- if block.type == 'region' -%}
            {%- assign region_slug = block.settings.title | handleize -%}
            <button
              class="msc-atlas-region"
              type="button"
              data-atlas-target="{{ region_slug }}"
              aria-pressed="false"
              {{ block.shopify_attributes }}
            >
              <span class="msc-atlas-region__index">{%- if forloop.index < 10 -%}0{%- endif -%}{{ forloop.index }}</span>
              <strong>{{ block.settings.title | escape }}</strong>
              <span class="msc-atlas-region__state" data-atlas-target-state>CHART</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MSC Explore Atlas Shell",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EXPLORE THE BITCOIN OCEAN."
    },
    {
      "type": "richtext",
      "id": "supporting_copy",
      "label": "Supporting copy",
      "default": "<p>Navigate the Bitcoin ecosystem through eight charted regions. Hover to preview a region, then select it to hold the view and inspect what is charted inside.</p>"
    }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Atlas region",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Region name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Future region link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MSC Explore Atlas Shell"
    }
  ]
}
{% endschema %}
