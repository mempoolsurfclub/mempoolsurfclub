{% schema %}
{
  "name": "MSC Explore Atlas Shell",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EXPLORE THE BITCOIN OCEAN."
    },
    {
      "type": "richtext",
      "id": "supporting_copy",
      "label": "Supporting copy",
      "default": "<p>Navigate the Bitcoin ecosystem through eight charted regions. Hover to preview a region, then select it to hold the view and inspect what is charted inside.</p>"
    }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Atlas region",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Region name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Future region link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MSC Explore Atlas Shell"
    }
  ]
}
{% endschema %}