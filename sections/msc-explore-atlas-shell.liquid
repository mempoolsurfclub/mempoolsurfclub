          <desc id="AtlasMapDesc-{{ section.id }}">A nautical chart of eight Bitcoin ecosystem regions: Ordinals, Runes, Wallets, Marketplaces, Mining, Payments, Exchanges, and Network.</desc>

          <defs>
            <pattern id="AtlasMinorGrid-{{ section.id }}" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(212,190,153,.12)" stroke-width=".7" />
            </pattern>
            <pattern id="AtlasMajorGrid-{{ section.id }}" width="120" height="120" patternUnits="userSpaceOnUse">
              <rect width="120" height="120" fill="url(#AtlasMinorGrid-{{ section.id }})" />
              <path d="M 120 0 L 0 0 0 120" fill="none" stroke="rgba(212,190,153,.18)" stroke-width="1" />
