<script src="{{ 'msc-explore-atlas.js' | asset_url }}" defer></script>

<section class="msc-shell msc-explore-atlas-shell" id="MscExploreAtlas-{{ section.id }}">
  <div class="msc-container">
    <header class="msc-explore-atlas-intro">
      <div class="msc-eyebrow msc-explore-atlas-intro__kicker">MSC ATLAS / EXPLORE</div>
      <h1 class="msc-title msc-explore-atlas-intro__title">{{ section.settings.heading | escape }}</h1>
      <div class="msc-subtitle msc-explore-atlas-intro__copy rte">{{ section.settings.supporting_copy }}</div>
    </header>

    <div class="msc-atlas-window" data-atlas aria-label="MSC Atlas Bitcoin ecosystem navigation">
      <div class="msc-atlas-window__top">
        <div class="msc-atlas-window__identity">
          <span>MSC ATLAS</span>
          <strong>BITCOIN OCEAN</strong>
        </div>
        <div class="msc-atlas-window__readout">
          <span>VIEW</span>
          <strong data-atlas-mode>FULL OCEAN</strong>
        </div>
        <div class="msc-atlas-window__readout">
          <span>REGION</span>
          <strong data-atlas-region-label>ALL 08</strong>
        </div>
      </div>

      <div class="msc-atlas-window__viewport" data-atlas-viewport>
        <p class="visually-hidden" id="AtlasInstructions-{{ section.id }}">
          Hover or focus a charted region to preview it. Select a region to lock the view. Select a charted entity to inspect it. Press Escape to return to the full ocean.
        </p>
        <span class="visually-hidden" aria-live="polite" data-atlas-live>Full Bitcoin Ocean view</span>
        <span class="msc-atlas-window__coord msc-atlas-window__coord--nw">N 08 / W 21</span>
        <span class="msc-atlas-window__coord msc-atlas-window__coord--se">S 08 / E 21</span>

