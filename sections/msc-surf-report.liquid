{{ 'mempool-ui.css' | asset_url | stylesheet_tag }}
{{ 'msc-continuous-page-background.css' | asset_url | stylesheet_tag }}

<style>
  #SurfReport-{{ section.id }} .msc-tools-hero {
    padding-block-start: clamp(3rem, 3.5vw, 4rem);
    padding-block-end: clamp(4.8rem, 7vw, 7.2rem);
  }

  #SurfReport-{{ section.id }} .msc-tools-hero__identity {
    max-width: 118rem;
    margin: 0 auto clamp(2.4rem, 3vw, 3.2rem);
    text-align: center;
  }

  #SurfReport-{{ section.id }} .msc-tools-hero__identity .msc-title {
    margin-top: 1.45rem;
    color: var(--msc-sand);
  }

  #SurfReport-{{ section.id }} .msc-tools-hero__identity .msc-subtitle {
    max-width: 118rem;
  }

  @media screen and (min-width: 761px) {
    #SurfReport-{{ section.id }} .msc-tools-hero__identity {
      display: grid;
      grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
      grid-template-areas:
        "kicker kicker"
        "title copy";
      column-gap: clamp(3.2rem, 4vw, 4.8rem);
      row-gap: 1.35rem;
      align-items: start;
      max-width: none;
      text-align: left;
    }

    #SurfReport-{{ section.id }} .msc-tools-hero__identity .msc-eyebrow {
      grid-area: kicker;
      justify-self: start;
      margin: 0 0 .25rem;
    }

    #SurfReport-{{ section.id }} .msc-tools-hero__identity .msc-title {
      grid-area: title;
      align-self: start;
      max-width: none;
      margin: 0;
    }

    #SurfReport-{{ section.id }} .msc-tools-hero__identity .msc-subtitle {
      grid-area: copy;
      align-self: end;
      width: 100%;
      max-width: none;
      margin: 0;
      text-align: left;
    }
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit {
    --msc-tools-space: clamp(1rem, 1.5vw, 1.4rem);
    --msc-tools-inset: clamp(1.25rem, 1.9vw, 1.8rem);
    position: relative;
    overflow: hidden;
    padding: var(--msc-tools-inset);
    border: 1px solid rgba(212, 190, 153, .36);
    border-radius: 30px;
    background:
      linear-gradient(rgba(212,190,153,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212,190,153,.035) 1px, transparent 1px),
      radial-gradient(circle at 50% 45%, rgba(212,190,153,.12), transparent 38%),
      linear-gradient(145deg, rgba(7, 31, 36, .92), rgba(20, 54, 61, .86));
    background-size: 34px 34px, 34px 34px, auto, auto;
    box-shadow: 0 26px 80px rgba(5, 20, 24, .34), inset 0 1px 0 rgba(255,255,255,.05);
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__topline {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--msc-tools-space);
    padding: 0 0 var(--msc-tools-space);
    border-bottom: 1px solid rgba(212,190,153,.18);
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__status {
    display: grid;
    gap: .28rem;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__status-title,
  #SurfReport-{{ section.id }} .msc-tools-cockpit__status-subtitle,
  #SurfReport-{{ section.id }} .msc-tools-cockpit__system {
    margin: 0;
    text-transform: uppercase;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__status-title {
    color: var(--msc-paper-soft);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: .09em;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__status-subtitle {
    color: var(--msc-sand);
    font-size: .94rem;
    line-height: 1.1;
    letter-spacing: .14em;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__system {
    color: var(--msc-paper-soft);
    font-size: 1rem;
    line-height: 1.1;
    letter-spacing: .16em;
    text-align: right;
    white-space: nowrap;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__deck {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(15rem, .62fr) minmax(0, 1.7fr) minmax(15rem, .62fr);
    gap: var(--msc-tools-space);
    align-items: stretch;
    padding-top: var(--msc-tools-space);
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__rail {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    gap: var(--msc-tools-space);
  }

  #SurfReport-{{ section.id }} .msc-tools-readout {
    min-height: 8.8rem;
    padding: var(--msc-tools-inset);
    border: 1px solid rgba(212,190,153,.16);
    border-radius: 16px;
    background: rgba(255,255,255,.035);
  }

  #SurfReport-{{ section.id }} .msc-tools-readout__label,
  #SurfReport-{{ section.id }} .msc-tools-price__label,
  #SurfReport-{{ section.id }} .msc-tools-price__meta-label {
    margin: 0;
    color: rgba(251,248,239,.48);
    font-size: .94rem;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #SurfReport-{{ section.id }} .msc-tools-readout__value {
    margin: .72rem 0 .3rem;
    color: var(--msc-paper-soft);
    font-size: clamp(1.45rem, 1.6vw, 2rem);
    line-height: 1;
    letter-spacing: -.025em;
  }

  #SurfReport-{{ section.id }} .msc-tools-readout__note {
    margin: 0;
    color: var(--msc-sand);
    font-size: 1.05rem;
  }

  #SurfReport-{{ section.id }} .msc-tools-price {
    position: relative;
    display: flex;
    min-height: 33rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: var(--msc-tools-inset);
    border: 1px solid rgba(212,190,153,.28);
    border-radius: 22px;
    background:
      radial-gradient(circle at 50% 42%, rgba(212,190,153,.095), transparent 46%),
      linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.015));
  }

  #SurfReport-{{ section.id }} .msc-tools-price::before {
    content: "";
    position: absolute;
    inset: 9% 8%;
    border: 1px solid rgba(212,190,153,.08);
    border-radius: 999px 999px 24px 24px;
    transform: perspective(800px) rotateX(62deg) translateY(-10%);
    transform-origin: 50% 100%;
    pointer-events: none;
  }

  #SurfReport-{{ section.id }} .msc-tools-price__heading {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: var(--msc-tools-space);
    align-items: flex-start;
  }

  #SurfReport-{{ section.id }} .msc-tools-price__pair {
    text-align: right;
  }

  #SurfReport-{{ section.id }} .msc-tools-price__display {
    position: relative;
    z-index: 2;
    margin: clamp(2.6rem, 4vw, 4.2rem) 0 0;
    text-align: center;
  }

  #SurfReport-{{ section.id }} .msc-tools-price__value {
    color: var(--msc-paper-soft);
    font-size: clamp(4.3rem, 7vw, 8rem);
    line-height: .86;
    letter-spacing: -.065em;
    text-shadow: 0 12px 34px rgba(3,18,22,.34);
  }

  #SurfReport-{{ section.id }} .msc-tools-price__change {
    display: block;
    min-height: 1.8rem;
    margin-top: 1.25rem;
    color: var(--msc-sand);
    font-size: 1.25rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #SurfReport-{{ section.id }} .msc-tools-trace {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 11rem;
    margin: 1rem 0 .6rem;
    overflow: visible;
  }

  #SurfReport-{{ section.id }} .msc-tools-trace__grid {
    stroke: rgba(212,190,153,.08);
    stroke-width: 1;
  }

  #SurfReport-{{ section.id }} .msc-tools-trace__path {
    fill: none;
    stroke: rgba(212,190,153,.92);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 7 8;
    animation: mscToolsTrace 18s linear infinite;
  }

  #SurfReport-{{ section.id }} .msc-tools-trace__ghost {
    fill: none;
    stroke: rgba(251,248,239,.16);
    stroke-width: 7;
    filter: blur(5px);
  }

  #SurfReport-{{ section.id }} .msc-tools-price__meta {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--msc-tools-space);
  }

  #SurfReport-{{ section.id }} .msc-tools-price__meta-item {
    padding-top: 1rem;
    border-top: 1px solid rgba(212,190,153,.16);
  }

  #SurfReport-{{ section.id }} .msc-tools-price__meta-value {
    display: block;
    margin-top: .45rem;
    color: rgba(251,248,239,.78);
    font-size: 1.05rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__search {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--msc-tools-space);
    align-items: center;
    margin-top: var(--msc-tools-space);
    padding: 1rem;
    border: 1px solid rgba(212,190,153,.18);
    border-radius: 17px;
    background: rgba(3,18,22,.28);
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__search-label {
    color: var(--msc-sand);
    font-size: .95rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__search input {
    min-width: 0;
    width: 100%;
    border: 0;
    outline: 0;
    padding: 1rem;
    color: var(--msc-paper-soft);
    background: transparent;
    font: inherit;
    font-size: 1.25rem;
  }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__search input::placeholder { color: rgba(251,248,239,.42); }

  #SurfReport-{{ section.id }} .msc-tools-cockpit__search button {
    border: 1px solid rgba(212,190,153,.34);
    border-radius: 12px;
    padding: 1rem;
    color: var(--msc-ink);
    background: var(--msc-sand);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  #SurfReport-{{ section.id }} .msc-tools-launches {
    margin-top: var(--msc-tools-space);
  }

  #SurfReport-{{ section.id }} .msc-tools-launches__row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--msc-tools-space);
  }

  #SurfReport-{{ section.id }} .msc-tools-launch {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--msc-tools-space);
    padding: 1rem;
    border: 1px solid rgba(212,190,153,.18);
    border-radius: 14px;
    color: rgba(251,248,239,.76);
    background: rgba(255,255,255,.035);
    text-decoration: none;
    font-size: 1.08rem;
    line-height: 1.25;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  #SurfReport-{{ section.id }} .msc-tools-launch:hover {
    transform: translateY(-2px);
    border-color: rgba(212,190,153,.46);
    background: rgba(255,255,255,.07);
  }

  #SurfReport-{{ section.id }} .msc-tools-launch--inscriber {
    border-color: rgba(212,190,153,.42);
    color: var(--msc-paper-soft);
    background: linear-gradient(180deg, rgba(212,190,153,.12), rgba(255,255,255,.035));
  }

  #SurfReport-{{ section.id }} .msc-tools-launch__arrow { color: var(--msc-sand); }

  @keyframes mscToolsTrace {
    to { stroke-dashoffset: -90; }
  }

  @media (prefers-reduced-motion: reduce) {
    #SurfReport-{{ section.id }} .msc-tools-trace__path { animation: none; }
  }

  @media screen and (min-width: 991px) {
    #SurfReport-{{ section.id }} .msc-tools-hero__identity .msc-title {
      font-size: clamp(4.5rem, 5vw, 6.2rem);
      line-height: .9;
      letter-spacing: -.06em;
    }
  }

  @media screen and (max-width: 990px) {
    #SurfReport-{{ section.id }} .msc-tools-cockpit__deck {
      grid-template-columns: 1fr 1.6fr;
    }

    #SurfReport-{{ section.id }} .msc-tools-cockpit__rail--right {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: none;
    }

    #SurfReport-{{ section.id }} .msc-tools-launches__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 700px) {
    #SurfReport-{{ section.id }} .msc-tools-hero__identity { text-align: left; }
    #SurfReport-{{ section.id }} .msc-tools-hero__identity .msc-subtitle { margin-left: 0; }

    #SurfReport-{{ section.id }} .msc-tools-cockpit__deck {
      grid-template-columns: 1fr;
    }

    #SurfReport-{{ section.id }} .msc-tools-cockpit__rail,
    #SurfReport-{{ section.id }} .msc-tools-cockpit__rail--right {
      grid-column: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
    }

    #SurfReport-{{ section.id }} .msc-tools-price { order: -1; min-height: 29rem; }
    #SurfReport-{{ section.id }} .msc-tools-price__value { font-size: clamp(4rem, 15vw, 6.2rem); }

    #SurfReport-{{ section.id }} .msc-tools-cockpit__search {
      grid-template-columns: 1fr auto;
    }

    #SurfReport-{{ section.id }} .msc-tools-cockpit__search-label { display: none; }
  }

  @media screen and (max-width: 520px) {
    #SurfReport-{{ section.id }} .msc-tools-cockpit { border-radius: 22px; }
    #SurfReport-{{ section.id }} .msc-tools-cockpit__topline { align-items: flex-start; }
    #SurfReport-{{ section.id }} .msc-tools-cockpit__rail,
    #SurfReport-{{ section.id }} .msc-tools-cockpit__rail--right,
    #SurfReport-{{ section.id }} .msc-tools-launches__row { grid-template-columns: 1fr; }
    #SurfReport-{{ section.id }} .msc-tools-price__meta { grid-template-columns: 1fr; }
    #SurfReport-{{ section.id }} .msc-tools-price__meta-item { display: flex; justify-content: space-between; gap: 1rem; }
    #SurfReport-{{ section.id }} .msc-tools-price__meta-value { margin-top: 0; text-align: right; }
    #SurfReport-{{ section.id }} .msc-tools-cockpit__search { grid-template-columns: 1fr; }
  }
</style>

<section class="msc-shell" id="SurfReport-{{ section.id }}">
  <div class="msc-block msc-tools-hero">
    <div class="msc-container">
      <div class="msc-tools-hero__identity">
        <div class="msc-eyebrow">{{ section.settings.kicker }}</div>
        <h1 class="msc-title">{{ section.settings.heading }}</h1>
        <p class="msc-subtitle">{{ section.settings.subheading }}</p>
      </div>

      <div class="msc-tools-cockpit" data-msc-ecosystem-radar>
        <div class="msc-tools-cockpit__topline">
          <div class="msc-tools-cockpit__status">
            <p class="msc-tools-cockpit__status-title">BTC SURF REPORT</p>
            <p class="msc-tools-cockpit__status-subtitle">TOOLS SYSTEM</p>
          </div>
          <p class="msc-tools-cockpit__system">MSC NAV CONSOLE / BTC-01</p>
        </div>

        <div class="msc-tools-cockpit__deck">
          <div class="msc-tools-cockpit__rail" aria-label="Network conditions">
            <article class="msc-tools-readout">
              <p class="msc-tools-readout__label">Fee Environment</p>
              <p class="msc-tools-readout__value">— sat/vB</p>
              <p class="msc-tools-readout__note">Fastest fee · API pending</p>
            </article>
            <article class="msc-tools-readout">
              <p class="msc-tools-readout__label">Mempool Congestion</p>
              <p class="msc-tools-readout__value">— MB</p>
              <p class="msc-tools-readout__note">Pending flow</p>
            </article>
            <article class="msc-tools-readout">
              <p class="msc-tools-readout__label">Latest Block</p>
              <p class="msc-tools-readout__value">—</p>
              <p class="msc-tools-readout__note">Network tip · API pending</p>
            </article>
          </div>

          <article class="msc-tools-price" aria-label="Live Bitcoin price instrument">
            <div class="msc-tools-price__heading">
              <div>
                <p class="msc-tools-price__label">Price Current</p>
              </div>
              <div class="msc-tools-price__pair">
                <p class="msc-tools-price__label">Market Tide</p>
                <span class="msc-tools-price__meta-value">Reading live</span>
              </div>
            </div>

            <div class="msc-tools-price__display" aria-live="polite">
              <div class="msc-tools-price__value" data-btc-price>—</div>
              <span class="msc-tools-price__change" data-btc-change>Connecting</span>
            </div>

            <svg class="msc-tools-trace" viewBox="0 0 720 150" preserveAspectRatio="none" aria-hidden="true">
              <path class="msc-tools-trace__grid" d="M0 30H720 M0 75H720 M0 120H720 M120 0V150 M240 0V150 M360 0V150 M480 0V150 M600 0V150" />
              <path class="msc-tools-trace__ghost" d="M0 112 C55 104 80 84 122 92 S196 119 232 95 S292 44 338 67 S405 108 448 79 S516 55 554 64 S625 99 720 34" />
              <path class="msc-tools-trace__path" d="M0 112 C55 104 80 84 122 92 S196 119 232 95 S292 44 338 67 S405 108 448 79 S516 55 554 64 S625 99 720 34" />
            </svg>

            <div class="msc-tools-price__meta">
              <div class="msc-tools-price__meta-item">
                <p class="msc-tools-price__meta-label">24H Drift</p>
                <span class="msc-tools-price__meta-value">Live market change</span>
              </div>
              <div class="msc-tools-price__meta-item">
                <p class="msc-tools-price__meta-label">Trend Vector</p>
                <span class="msc-tools-price__meta-value">Route trace</span>
              </div>
              <div class="msc-tools-price__meta-item">
                <p class="msc-tools-price__meta-label">Signal</p>
                <span class="msc-tools-price__meta-value">BTC / USD</span>
              </div>
            </div>
          </article>

          <div class="msc-tools-cockpit__rail msc-tools-cockpit__rail--right" aria-label="Bitcoin network instrumentation">
            <article class="msc-tools-readout">
              <p class="msc-tools-readout__label">Hashrate</p>
              <p class="msc-tools-readout__value">— EH/s</p>
              <p class="msc-tools-readout__note">Network power</p>
            </article>
            <article class="msc-tools-readout">
              <p class="msc-tools-readout__label">Difficulty</p>
              <p class="msc-tools-readout__value">— T</p>
              <p class="msc-tools-readout__note">Adjustment cycle</p>
            </article>
            <article class="msc-tools-readout">
              <p class="msc-tools-readout__label">Halving Countdown</p>
              <p class="msc-tools-readout__value">— days</p>
              <p class="msc-tools-readout__note">Forecast · API pending</p>
            </article>
          </div>
        </div>

        <nav class="msc-tools-launches" aria-label="Quick launch tools">
          <div class="msc-tools-launches__row">
            <a class="msc-tools-launch" href="{{ routes.search_url }}?q=Mempool%20Fee%20Navigator&amp;type=page"><span>Mempool / Fee Navigator</span><span class="msc-tools-launch__arrow">↗</span></a>
            <a class="msc-tools-launch msc-tools-launch--inscriber" href="{{ routes.search_url }}?q=MSC%20Inscriber&amp;type=page"><span>MSC Inscriber</span><span class="msc-tools-launch__arrow">↗</span></a>
            <a class="msc-tools-launch" href="{{ routes.search_url }}?q=Transaction%20Analyzer&amp;type=page"><span>Transaction Analyzer</span><span class="msc-tools-launch__arrow">↗</span></a>
            <a class="msc-tools-launch" href="{{ routes.search_url }}?q=Block%20Explorer&amp;type=page"><span>Block Explorer</span><span class="msc-tools-launch__arrow">↗</span></a>
            <a class="msc-tools-launch" href="{{ routes.search_url }}?q=UTXO%20Planner&amp;type=page"><span>UTXO Planner</span><span class="msc-tools-launch__arrow">↗</span></a>
          </div>
        </nav>

        <form class="msc-tools-cockpit__search" action="{{ routes.search_url }}" method="get" role="search">
          <span class="msc-tools-cockpit__search-label">Tool Search</span>
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder }}" aria-label="Search tools, transactions, addresses, blocks, scripts, or wallets">
          <input type="hidden" name="type" value="article,page,product">
          <button type="submit">{{ section.settings.search_button }}</button>
        </form>
      </div>
    </div>
  </div>

  <div class="msc-block">
    <div class="msc-container">
      <p class="msc-section-kicker">Tool Library</p>
      <h2 class="msc-section-title">Browse Tools</h2>
      <div class="msc-tool-grid">
        <a class="msc-tool-card msc-glass-card" href="#"><div><h3>Wallets</h3><p>Discover trusted Bitcoin wallets for securely storing, sending, and receiving bitcoin.</p></div><span class="msc-card-arrow">Enter →</span></a>
        <a class="msc-tool-card msc-glass-card" href="#"><div><h3>Explorers</h3><p>Inspect blocks, transactions, addresses, inscriptions, and live network activity.</p></div><span class="msc-card-arrow">Enter →</span></a>
        <a class="msc-tool-card msc-glass-card" href="#"><div><h3>Transactions</h3><p>Broadcast, decode, verify, and estimate Bitcoin transactions with confidence.</p></div><span class="msc-card-arrow">Enter →</span></a>
        <a class="msc-tool-card msc-glass-card" href="#"><div><h3>Mining</h3><p>Explore mining pools, ASIC hardware, profitability, firmware, and network statistics.</p></div><span class="msc-card-arrow">Enter →</span></a>
        <a class="msc-tool-card msc-glass-card" href="#"><div><h3>Lightning</h3><p>Discover Lightning wallets, nodes, routing tools, and instant payment applications.</p></div><span class="msc-card-arrow">Enter →</span></a>
        <a class="msc-tool-card msc-glass-card" href="#"><div><h3>Markets</h3><p>Track Bitcoin price, ETFs, on-chain metrics, market data, and trading activity.</p></div><span class="msc-card-arrow">Enter →</span></a>
