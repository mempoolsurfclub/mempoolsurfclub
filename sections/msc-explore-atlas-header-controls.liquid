    const pad4 = (value) => String(Math.max(0, Math.min(9999, value))).padStart(4, '0');
    const clamp01 = (value) => Math.max(0, Math.min(1, value));

    const regionLabel = (atlas, slug) => {
      if (!slug) return '';
      const region = [...atlas.querySelectorAll('[data-atlas-region-shape]')]
