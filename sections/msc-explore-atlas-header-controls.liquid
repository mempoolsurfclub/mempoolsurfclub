<script>
  (() => {
    const initAtlasHeaderControls = () => {
      const source = document.querySelector('[data-msc-atlas-search-source]');
      const prototypeForm = source?.querySelector('form');
      const atlases = [...document.querySelectorAll('[data-atlas]')];

      if (!prototypeForm || !atlases.length) {
        source?.remove();
        return;
      }

      atlases.forEach((atlas, index) => {
        const topBar = atlas.querySelector('.msc-atlas-window__top');
        const locationLabel = atlas.querySelector('[data-atlas-region-label]');
        const locationGroup = locationLabel?.closest('.msc-atlas-window__readout');
        const locationPrefix = locationGroup?.querySelector('span');

        if (!topBar || !locationGroup || !locationLabel) return;

        topBar.classList.add('msc-atlas-window__top--site-search');
        topBar.style.setProperty('grid-template-columns', 'var(--msc-atlas-header-columns)', 'important');

        locationGroup.classList.add('msc-atlas-window__location');
        locationGroup.style.setProperty('position', 'static', 'important');
        locationGroup.style.setProperty('left', 'auto', 'important');
        locationGroup.style.setProperty('top', 'auto', 'important');
        locationGroup.style.setProperty('transform', 'none', 'important');
        locationGroup.style.setProperty('display', 'flex', 'important');
        locationGroup.style.setProperty('justify-content', 'flex-end', 'important');
        locationGroup.style.setProperty('text-align', 'right', 'important');
        if (locationPrefix) locationPrefix.style.setProperty('display', 'none', 'important');

        if (!topBar.querySelector('.msc-atlas-header-search')) {
          const form = index === 0 ? prototypeForm : prototypeForm.cloneNode(true);
          const input = form.querySelector('input[type="search"]');
          const label = form.querySelector('label');

          form.classList.add('msc-atlas-header-search');
          if (input) {
            const inputId = `MscAtlasSiteSearch-${index + 1}`;
            input.id = inputId;
            if (label) label.htmlFor = inputId;
          }

          form.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') event.stopPropagation();
          });

          topBar.insertBefore(form, locationGroup);
        }

        const updateLocation = () => {
          const slug = atlas.dataset.atlasActive || '';
          const region = slug
            ? [...atlas.querySelectorAll('[data-atlas-region-shape]')]
                .find((item) => item.dataset.atlasRegionShape === slug)
            : null;
          const label = slug
            ? (region?.dataset.atlasRegionLabel || slug.toUpperCase())
            : 'BITCOIN NETWORK';

          if (locationLabel.textContent !== label) locationLabel.textContent = label;
        };

        updateLocation();
        new MutationObserver(updateLocation).observe(atlas, {
          attributes: true,
          attributeFilter: ['data-atlas-active']
        });
      });

      source.remove();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAtlasHeaderControls, { once: true });
    } else {
      window.requestAnimationFrame(initAtlasHeaderControls);
    }
  })();
</script>

