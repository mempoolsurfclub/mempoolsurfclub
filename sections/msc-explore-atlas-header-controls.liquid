            <span class="msc-atlas-navhud__surf-dots"></span>
          </div>
          <div class="msc-atlas-navhud__surf-scale">
            <span class="msc-atlas-navhud__surf-marker" data-atlas-hud-surf></span>
          </div>
        </div>

        <div class="msc-atlas-navhud__telemetry">
          <span class="msc-atlas-navhud__corner msc-atlas-navhud__corner--tl"></span>
          <span class="msc-atlas-navhud__corner msc-atlas-navhud__corner--tr"></span>
          <span class="msc-atlas-navhud__corner msc-atlas-navhud__corner--bl"></span>
          <span class="msc-atlas-navhud__corner msc-atlas-navhud__corner--br"></span>

          <div class="msc-atlas-navhud__telemetry-row">
            <span class="msc-atlas-navhud__telemetry-label">COORDINATES //</span>
            <strong class="msc-atlas-navhud__telemetry-value msc-atlas-navhud__telemetry-value--coordinates" data-atlas-hud-coords>----X ----Y</strong>
          </div>
          <div class="msc-atlas-navhud__telemetry-row">
            <span class="msc-atlas-navhud__telemetry-label">SECTOR //</span>
            <strong class="msc-atlas-navhud__telemetry-value" data-atlas-hud-sector>OPEN WATER</strong>
          </div>
          <div class="msc-atlas-navhud__telemetry-row">
            <span class="msc-atlas-navhud__telemetry-label">SIGNAL //</span>
            <strong class="msc-atlas-navhud__telemetry-value" data-atlas-hud-signal>STANDBY</strong>
          </div>
          <div class="msc-atlas-navhud__lock">
            <span class="msc-atlas-navhud__micro">GRID LOCK // <b data-atlas-hud-lock>STANDBY</b></span>
          </div>
        </div>

        <div class="msc-atlas-navhud__bearing">
          <span class="msc-atlas-navhud__label">ATLAS BEARING</span>
          <div class="msc-atlas-navhud__bearing-body">
            <svg class="msc-atlas-navhud__compass" viewBox="0 0 74 74" aria-hidden="true">
              <circle cx="37" cy="37" r="29"></circle>
              <circle cx="37" cy="37" r="24" stroke-dasharray="2 4"></circle>
              <line x1="37" y1="4" x2="37" y2="14"></line>
              <line x1="37" y1="60" x2="37" y2="70"></line>
              <line x1="4" y1="37" x2="14" y2="37"></line>
              <line x1="60" y1="37" x2="70" y2="37"></line>
              <path d="M16 16 L22 22 M52 52 L58 58 M58 16 L52 22 M22 52 L16 58"></path>
              <g class="msc-atlas-navhud__needle" data-atlas-hud-needle>
                <path d="M37 9 L41 37 L37 44 L33 37 Z"></path>
              </g>
              <circle cx="37" cy="37" r="2.2"></circle>
            </svg>
            <svg class="msc-atlas-navhud__trace" viewBox="0 0 180 42" preserveAspectRatio="none" aria-hidden="true">
              <path data-atlas-hud-trace d="M0 22 L24 22 L48 22 L72 22 L96 22 L120 22 L144 22 L180 22"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="msc-atlas-navhud__right">
        <div class="msc-atlas-navhud__right-status">
          <div>
            <span class="msc-atlas-navhud__label">CHART CURRENT</span>
            <div class="msc-atlas-navhud__current-line"></div>
          </div>
          <div class="msc-atlas-navhud__status-block">
            <span class="msc-atlas-navhud__micro">CHART MODE</span>
            <strong class="msc-atlas-navhud__status-value">NAV</strong>
          </div>
          <div class="msc-atlas-navhud__status-block">
            <span class="msc-atlas-navhud__micro">ATLAS ROUTE</span>
            <strong class="msc-atlas-navhud__status-value" data-atlas-hud-route>STANDBY</strong>
          </div>
        </div>

        <div class="msc-atlas-navhud__scale">
          <span class="msc-atlas-navhud__micro" style="position:absolute; right:0; top:-1.35rem;">GRID SCALE</span>
          <span class="msc-atlas-navhud__scale-line"></span>
          <span class="msc-atlas-navhud__scale-label msc-atlas-navhud__scale-label--75">75</span>
          <span class="msc-atlas-navhud__scale-label msc-atlas-navhud__scale-label--50">50</span>
          <span class="msc-atlas-navhud__scale-label msc-atlas-navhud__scale-label--25">25</span>
          <span class="msc-atlas-navhud__scale-marker" data-atlas-hud-scale></span>
        </div>

        <div class="msc-atlas-navhud__grid-ref">
          <span class="msc-atlas-navhud__micro">GRID REF</span>
          <strong class="msc-atlas-navhud__status-value" data-atlas-hud-grid>--</strong>
        </div>

        <svg class="msc-atlas-navhud__route-plot" viewBox="0 0 220 126" aria-hidden="true">
          <path class="msc-atlas-navhud__route-main" d="M10 108 C52 86 91 82 119 60 C145 40 164 31 202 16"></path>
          <path d="M18 112 C62 106 80 92 105 74 M118 117 C128 83 146 65 164 43" stroke-dasharray="2 7"></path>
          <line x1="35" y1="97" x2="49" y2="91"></line>
          <line x1="89" y1="83" x2="101" y2="76"></line>
          <line x1="145" y1="43" x2="157" y2="36"></line>
          <circle cx="10" cy="108" r="3.2"></circle>
          <circle cx="56" cy="87" r="2.7"></circle>
          <circle cx="101" cy="74" r="3.2"></circle>
          <circle cx="145" cy="43" r="2.7"></circle>
          <circle cx="202" cy="16" r="3.2"></circle>
          <circle class="msc-atlas-navhud__route-pulse" cx="0" cy="0" r="2.2"></circle>
        </svg>

        <div class="msc-atlas-navhud__radar" aria-hidden="true">
          <span class="msc-atlas-navhud__radar-tick"></span>
        </div>
      </div>
    `;

    const initAtlasNavHud = () => {
      document.querySelectorAll('[data-atlas]').forEach((atlas) => {
        const viewport = atlas.querySelector('[data-atlas-viewport]');
        if (!viewport || viewport.querySelector('[data-atlas-navhud]')) return;

        const hud = document.createElement('div');
        hud.className = 'msc-atlas-navhud';
        hud.dataset.atlasNavhud = '';
        hud.setAttribute('aria-hidden', 'true');
        hud.innerHTML = navHudMarkup();
        viewport.appendChild(hud);
        atlas.classList.add('has-msc-atlas-navhud');

        const coords = hud.querySelector('[data-atlas-hud-coords]');
        const sector = hud.querySelector('[data-atlas-hud-sector]');
        const signal = hud.querySelector('[data-atlas-hud-signal]');
        const lock = hud.querySelector('[data-atlas-hud-lock]');
        const route = hud.querySelector('[data-atlas-hud-route]');
        const grid = hud.querySelector('[data-atlas-hud-grid]');
        const surf = hud.querySelector('[data-atlas-hud-surf]');
        const scale = hud.querySelector('[data-atlas-hud-scale]');
        const needle = hud.querySelector('[data-atlas-hud-needle]');
        const trace = hud.querySelector('[data-atlas-hud-trace]');

        let inside = false;
        let pendingPoint = null;
        let frame = null;
        let lastPoint = null;
        let lastTime = 0;
        let tracePhase = 0;

        const setInteractionState = (hoverSlug = '') => {
          const mode = atlas.dataset.atlasMode || 'overview';
          const lockedSlug = mode === 'locked' ? (atlas.dataset.atlasActive || '') : '';
          const effectiveSlug = lockedSlug || hoverSlug;

          if (sector) {
            sector.textContent = effectiveSlug
              ? regionLabel(atlas, effectiveSlug)
              : 'OPEN WATER';
          }

          if (mode === 'locked' && lockedSlug) {
            if (signal) signal.textContent = 'LOCKED';
            if (lock) lock.textContent = 'LOCKED';
            if (route) route.textContent = 'ACTIVE';
          } else if (inside && hoverSlug) {
            if (signal) signal.textContent = 'ACQUIRED';
            if (lock) lock.textContent = 'ENGAGED';
            if (route) route.textContent = 'ACTIVE';
          } else if (inside) {
            if (signal) signal.textContent = 'SEARCHING';
            if (lock) lock.textContent = 'STANDBY';
            if (route) route.textContent = 'ACTIVE';
          } else {
            if (signal) signal.textContent = 'STANDBY';
            if (lock) lock.textContent = lockedSlug ? 'LOCKED' : 'STANDBY';
            if (route) route.textContent = lockedSlug ? 'ACTIVE' : 'STANDBY';
          }
        };

        const updateTrace = (speed) => {
          if (!trace) return;
          tracePhase += .38;
          const amplitude = Math.max(1.5, Math.min(10, 1.5 + (speed * 18)));
          const points = [];
          const count = 8;
          for (let i = 0; i < count; i += 1) {
            const x = (180 / (count - 1)) * i;
            const wave = Math.sin((i * 1.65) + tracePhase) * amplitude;
            const taper = i === 0 || i === count - 1 ? .28 : 1;
            points.push(`${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${(22 + (wave * taper)).toFixed(1)}`);
          }
          trace.setAttribute('d', points.join(' '));
        };

        const updatePoint = (clientX, clientY) => {
          const rect = viewport.getBoundingClientRect();
          if (!rect.width || !rect.height) return;

          const x = clamp01((clientX - rect.left) / rect.width);
          const y = clamp01((clientY - rect.top) / rect.height);
          const xValue = Math.round(x * 9999);
          const yValue = Math.round((1 - y) * 9999);

          if (coords) coords.textContent = `${pad4(xValue)}X ${pad4(yValue)}Y`;
          if (surf) surf.style.left = `${(x * 100).toFixed(2)}%`;
          if (scale) scale.style.top = `${(y * 100).toFixed(2)}%`;

          const columnIndex = Math.min(GRID_COLUMNS.length - 1, Math.floor(x * GRID_COLUMNS.length));
          const rowIndex = Math.min(7, Math.floor(y * 8));
          if (grid) grid.textContent = `${GRID_COLUMNS[columnIndex]}-${String(rowIndex + 1).padStart(2, '0')}`;

          if (needle) {
            const dx = clientX - (rect.left + (rect.width / 2));
            const dy = clientY - (rect.top + (rect.height / 2));
            const bearing = (Math.atan2(dy, dx) * 180 / Math.PI) + 90;
            needle.style.transform = `rotate(${bearing.toFixed(1)}deg)`;
          }

          const hit = document.elementFromPoint(clientX, clientY);
          const region = hit?.closest?.('[data-atlas-region-shape]');
          const hoverSlug = region && atlas.contains(region)
            ? (region.dataset.atlasRegionShape || '')
            : '';
          setInteractionState(hoverSlug);

          const now = performance.now();
          let speed = 0;
          if (lastPoint && lastTime) {
            const distance = Math.hypot(clientX - lastPoint.x, clientY - lastPoint.y);
            const elapsed = Math.max(1, now - lastTime);
            speed = Math.min(1, distance / elapsed / 1.8);
          }
          lastPoint = { x: clientX, y: clientY };
          lastTime = now;
          updateTrace(speed);
        };

        const flushPoint = () => {
          frame = null;
          if (!pendingPoint) return;
          updatePoint(pendingPoint.x, pendingPoint.y);
          pendingPoint = null;
        };

        viewport.addEventListener('pointerenter', (event) => {
          inside = true;
          pendingPoint = { x: event.clientX, y: event.clientY };
          if (!frame) frame = requestAnimationFrame(flushPoint);
        }, { passive: true });

        viewport.addEventListener('pointermove', (event) => {
          inside = true;
          pendingPoint = { x: event.clientX, y: event.clientY };
          if (!frame) frame = requestAnimationFrame(flushPoint);
        }, { passive: true });

        viewport.addEventListener('pointerleave', () => {
          inside = false;
          pendingPoint = null;
          lastPoint = null;
          lastTime = 0;
          if (coords) coords.textContent = '----X ----Y';
          if (grid) grid.textContent = '--';
          if (surf) surf.style.left = '50%';
          if (scale) scale.style.top = '50%';
          if (needle) needle.style.transform = 'rotate(0deg)';
          updateTrace(0);
          setInteractionState('');
        }, { passive: true });

        const syncAtlasState = () => setInteractionState('');
        new MutationObserver(syncAtlasState).observe(atlas, {
          attributes: true,
          attributeFilter: ['data-atlas-active', 'data-atlas-mode']
        });

        setInteractionState('');
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAtlasNavHud, { once: true });
    } else {
      window.requestAnimationFrame(initAtlasNavHud);
    }
  })();
</script>

