<style>
  .section--msc-atlas-right-hud-tune {
    display: contents;
  }

  /* Approved Atlas region-control lock from PR #294. Keep this correction in
   * an Atlas-owned section that is guaranteed to load after the base Atlas CSS
   * so lower Explore-page section changes cannot silently disable it again. */
  .msc-explore-atlas-shell .msc-atlas-window__coord,
  .msc-explore-atlas-shell .msc-atlas-region__state {
    display: none !important;
  }

  .msc-explore-atlas-shell button.msc-atlas-region {
    align-items: center !important;
    justify-content: center !important;
    gap: 0 !important;
    text-align: center !important;
  }

  .msc-explore-atlas-shell button.msc-atlas-region strong {
    width: 100%;
    text-align: center !important;
  }

  /* Right-side Atlas HUD alignment pass: compact the text stack beside the ruler. */
  .msc-atlas-navhud__right-status {
    left: auto !important;
    right: 4.85rem !important;
    width: 6.4rem !important;
  }

  .msc-atlas-navhud__right-status > div:first-child .msc-atlas-navhud__label {
    font-size: 0 !important;
  }

  .msc-atlas-navhud__right-status > div:first-child .msc-atlas-navhud__label::before {
    content: 'CHART\A CURRENT';
    display: block;
    white-space: pre-line;
    color: rgba(212, 190, 153, .78);
    font-size: clamp(.58rem, .58vw, .72rem);
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: .14em;
  }

  .msc-atlas-navhud__current-line {
    width: 4.8rem !important;
    margin-top: .56rem !important;
  }

  .msc-atlas-navhud__scale > .msc-atlas-navhud__micro {
    display: none !important;
  }

  .msc-atlas-navhud__right-status::after {
    content: 'GRID SCALE';
    display: block;
    margin-top: 1.1rem;
    color: rgba(212, 190, 153, .58);
    font-size: clamp(.58rem, .58vw, .72rem);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: .14em;
  }

  .msc-atlas-navhud__grid-ref {
    left: auto !important;
    right: 4.85rem !important;
    width: 6.4rem !important;
  }
</style>

{% schema %}
{
  "name": "MSC Atlas right HUD tune",
  "tag": "section",
  "class": "section section--msc-atlas-right-hud-tune",
  "settings": []
}
{% endschema %}
