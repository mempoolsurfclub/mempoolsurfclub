{% comment %}
  Renders a reusable MSC section header.
  Accepts: kicker, heading, copy, align, heading_id
{% endcomment %}
{%- liquid
  assign header_align = align | default: 'left'
  assign header_id = heading_id | default: nil
  assign header_copy = copy
  if header_id contains 'MscLearnIndex-'
    assign header_copy = blank
  endif
-%}
{%- if header_id contains 'MscLearnIndex-' -%}
  {{ 'msc-learn-accessibility.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'msc-learn-home-refinements.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'msc-learn-index-polish.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<header class="msc-section-header msc-section-header--{{ header_align }}">
  {%- if kicker != blank -%}
    <p class="msc-section-kicker">{{ kicker | escape }}</p>
  {%- endif -%}
  {%- if heading != blank -%}
    <h2 class="msc-section-title"{% if header_id %} id="{{ header_id }}"{% endif %}>{{ heading | escape }}</h2>
  {%- endif -%}
  {%- if header_copy != blank -%}
    <div class="msc-section-header__copy rte">{{ header_copy }}</div>
  {%- endif -%}
</header>
