<script>
  (() => {
    const script = document.currentScript;
    const scope = script.closest('.shopify-section') || document;
    const svgNamespace = 'http://www.w3.org/2000/svg';

    const renderRouteMap = () => {
      const companion = scope.querySelector(
        '.msc-learn-guide-card[data-msc-guide-id="MSC-GUIDE-033"] .msc-building-lightning-companion'
      );
      const current = companion?.querySelector('.msc-building-lightning-system');

      if (!current || current.dataset.mscRouteMap === 'simple') return false;

      const routeMap = document.createElementNS(svgNamespace, 'svg');
      routeMap.setAttribute('class', 'msc-building-lightning-system');
      routeMap.setAttribute('viewBox', '0 0 560 280');
      routeMap.setAttribute('role', 'img');
      routeMap.setAttribute('aria-labelledby', 'msc-building-lightning-route-title msc-building-lightning-route-desc');
      routeMap.dataset.mscRouteMap = 'simple';
      routeMap.innerHTML = `
        <title id="msc-building-lightning-route-title">Lightning payment route map</title>
        <desc id="msc-building-lightning-route-desc">A payment travels from a sender through one Lightning routing node to a receiver over off-chain payment channels, with Bitcoin shown beneath as the settlement layer.</desc>

        <path class="msc-guide033-route-map__secondary" aria-hidden="true" d="M116 145C208 181 352 181 444 145" />
        <path class="msc-guide033-route-map__primary" aria-hidden="true" d="M116 133C172 113 224 96 259 96C320 96 382 113 444 133" />

        <g class="msc-guide033-route-map__anchor" aria-hidden="true">
          <path d="M112 222H448" />
          <circle cx="280" cy="222" r="12" />
          <text class="msc-guide033-route-map__bitcoin-mark" x="280" y="227" text-anchor="middle">₿</text>
          <text x="280" y="252" text-anchor="middle">BITCOIN SETTLEMENT</text>
        </g>

        <g aria-hidden="true">
          <circle class="msc-guide033-route-map__node-ring" cx="90" cy="137" r="26" />
          <circle class="msc-guide033-route-map__node-core" cx="90" cy="137" r="3" />
          <path d="M79 137H101M90 126V148" />
          <text x="90" y="180" text-anchor="middle">SENDER</text>
        </g>

        <g aria-hidden="true">
          <circle class="msc-guide033-route-map__node-ring msc-guide033-route-map__router" cx="280" cy="96" r="21" />
          <circle class="msc-guide033-route-map__node-core" cx="280" cy="96" r="2.7" />
          <path d="M271 96H289M280 87V105" />
          <text x="280" y="132" text-anchor="middle">ROUTING NODE</text>
        </g>

        <g aria-hidden="true">
          <circle class="msc-guide033-route-map__node-ring msc-guide033-route-map__destination" cx="470" cy="137" r="26" />
          <circle class="msc-guide033-route-map__node-core" cx="470" cy="137" r="3" />
          <path d="M459 137H481M470 126V148" />
          <text x="470" y="180" text-anchor="middle">RECEIVER</text>
        </g>

        <circle class="msc-guide033-route-map__packet" r="4" opacity="0" aria-hidden="true">
          <animateMotion
            dur="7.2s"
            repeatCount="indefinite"
            calcMode="linear"
            keyPoints="0;0;1;1"
            keyTimes="0;.1;.8;1"
            path="M116 133C172 113 224 96 259 96C320 96 382 113 444 133"
          />
          <animate
            attributeName="opacity"
            values="0;1;1;0;0"
            keyTimes="0;.1;.77;.86;1"
            dur="7.2s"
            repeatCount="indefinite"
          />
        </circle>
      `;

      current.replaceWith(routeMap);
      return true;
    };

    if (renderRouteMap()) return;

    const observer = new MutationObserver(() => {
      if (renderRouteMap()) observer.disconnect();
    });

    observer.observe(scope, { childList: true, subtree: true });
    window.setTimeout(() => observer.disconnect(), 5000);
  })();
</script>
