    "glossaryIndexRoleData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "populated_letter_sequence",
        "populated_letter_counts",
        "letter_groups",
        "total_terms"
      ],
      "properties": {
        "orientation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "populated_letter_sequence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]$"
          }
        },
        "populated_letter_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "propertyNames": {
            "pattern": "^[a-z]$",
            "type": "string"
          },
          "minProperties": 1
        },
        "letter_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "letter",
              "term_count",
              "terms"
            ],
            "properties": {
              "letter": {
                "type": "string",
                "pattern": "^[a-z]$"
              },
              "term_count": {
                "type": "integer",
                "minimum": 1
              },
              "terms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preferred_term",
                    "definition",
                    "canonical_destination_registry_id",
                    "canonical_planning_handle",
                    "active",
                    "url"
                  ],
                  "properties": {
                    "preferred_term": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/safeText"
                        },
                        {
                          "minLength": 1,
                          "type": "string"
                        }
                      ]
                    },
                    "definition": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/safeText"
                        },
                        {
                          "minLength": 1,
                          "type": "string"
                        }
                      ]
                    },
                    "canonical_destination_registry_id": {
                      "$ref": "#/$defs/registryId"
                    },
                    "canonical_planning_handle": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "ownership": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "page_role",
                        "primary_category",
                        "subcategory"
                      ],
                      "properties": {
                        "page_role": {
                          "allOf": [
                            {
                              "$ref": "#/$defs/safeText"
                            },
                            {
                              "minLength": 1,
                              "type": "string"
                            }
                          ]
                        },
                        "primary_category": {
                          "allOf": [
                            {
                              "$ref": "#/$defs/safeText"
                            },
                            {
                              "minLength": 1,
                              "type": "string"
                            }
                          ]
                        },
                        "subcategory": {
                          "allOf": [
                            {
                              "$ref": "#/$defs/safeText"
                            },
                            {
                              "minLength": 1,
                              "type": "string"
                            }
                          ]
                        }
                      }
                    },
                    "active": {
                      "const": false
                    },
                    "url": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        },
        "total_terms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "safeText": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*(?:<!--[\\s\\S]*?-->|<![^>]*>|<(?!pubkey>|signature>|txid>|block_hash>)\\s*\\/?\\s*[A-Za-z][A-Za-z0-9:_-]*(?:\\s[^<>]*?)?\\s*\\/?>|\\[[^\\[\\]\\n]+\\]\\([^()\\n]+\\)|!\\[[^\\]\\n]*\\]\\([^()\\n]+\\)|\\]\\s*\\(|\\bon[a-z]+\\s*=|\\b(?:javascript|data|vbscript)\\s*:))[\\s\\S]*$",
      "$comment": "Plain text only. The exact case-sensitive escaped technical placeholders <pubkey>, <signature>, <txid>, and <block_hash> are allowed. Every other tag-shaped token, comments, declarations, Markdown links or images, malformed link syntax, inline event handlers, and unsafe URI schemes are forbidden. Every renderer must escape this value."
    },
    "richTextContentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "heading",
        "text",
        "format",
        "escape_before_render",
        "source_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "section",
            "paragraph",
            "ordered-list",
            "unordered-list",
            "definition-list",
            "callout"
          ]
        },
        "heading": {
          "anyOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "$ref": "#/$defs/safeText"
        },
        "format": {
          "const": "plain-text"
        },
        "escape_before_render": {
          "const": true
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "semanticTableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "header",
        "alignment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^column-[1-9][0-9]*$"
        },
        "header": {
          "allOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "alignment": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "left",
            "center",
            "right",
            null
          ]
        }
      }
    },
    "semanticTableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "minItems": 2,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/safeText"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "$comment": "JSON Schema cannot compare this array length with the sibling columns array. scripts/learn-runtime/lib/runtime-validation.mjs must enforce exact row-width equality after schema validation and before any Stage 2 output is accepted."
        }
      }
    },
    "semanticTableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "label_source",
        "columns",
        "rows",
        "source_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "semantic-table"
        },
        "label": {
          "allOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "label_source": {
          "enum": [
            "explicit-caption",
            "nearest-source-heading"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/semanticTableColumn"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/semanticTableRow"
          }
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "$comment": "Column IDs must be unique and sequential and every row width must equal the columns length. These cross-item invariants are enforced by the shared runtime validator after schema validation."
    },
    "inertCodeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "language",
        "code",
        "executable",
        "controls_enabled",
        "escape_before_render",
        "source_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "inert-code"
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]*$"
        },
        "code": {
          "type": "string"
        },
        "executable": {
          "const": false
        },
        "controls_enabled": {
          "const": false
        },
        "escape_before_render": {
          "const": true
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
