              "guide_cards"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "allOf": [
                  {
                    "$ref": "#/$defs/safeText"
                  },
                  {
                    "minLength": 1,
                    "type": "string"
                  }
                ]
              },
              "guide_cards": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/inactiveDestination"
                }
              }
            }
          }
        },
        "canonical_destination_ids": {
          "type": "array",
          "items": {
