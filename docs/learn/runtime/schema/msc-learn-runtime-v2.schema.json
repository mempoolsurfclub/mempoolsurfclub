          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_number",
              "title",
              "summary_text",
              "steps"
            ],
            "properties": {
              "stage_number": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "allOf": [
                  {
                    "$ref": "#/$defs/safeText"
                  },
                  {
                    "minLength": 1,
                    "type": "string"
                  }
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/inactiveDestination"
                }
              },
              "summary_text": {
                "$ref": "#/$defs/safeText"
              }
            }
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inactiveDestination"
          }
        }
      }
    },
    "featuredRouteRoleData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "lifecycle_steps",
        "companions"
      ],
      "properties": {
        "orientation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "lifecycle_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_number",
              "heading",
              "explanatory_text",
              "route_state",
              "active",
              "url"
            ],
            "properties": {
              "step_number": {
                "type": "integer",
                "minimum": 1
              },
              "heading": {
                "allOf": [
                  {
                    "$ref": "#/$defs/safeText"
                  },
                  {
                    "minLength": 1,
                    "type": "string"
                  }
                ]
              },
              "route_state": {
                "allOf": [
                  {
                    "$ref": "#/$defs/safeText"
                  },
                  {
                    "minLength": 1,
                    "type": "string"
                  }
                ]
              },
              "active": {
                "const": false
              },
              "url": {
                "type": "null"
              },
              "explanatory_text": {
                "allOf": [
                  {
                    "$ref": "#/$defs/safeText"
                  },
                  {
                    "minLength": 1,
                    "type": "string"
                  }
                ]
              }
            }
          }
